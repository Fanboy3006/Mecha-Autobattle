# 小工具
# ==========================================================================================
func tar_armorCut(u: Dictionary) -> float:
	return J.num0(u.get("armorCut"))

## 这台单位身上还有没有 `src` 这条 buff。
func _有源(u: Dictionary, 源: String) -> bool:
	for b in J.or_(u.get("buffs"), []):
		if b is Dictionary and str((b as Dictionary).get("src", "")) == 源:
			return true
	return false

func tar_掩护补充(u: Dictionary) -> int:
	return int(J.num0(u.get("掩护补充", 0)))

func _维修机(键: String, 位: float) -> Dictionary:
	var u := _单位(键, 位, "维修")
	return u

