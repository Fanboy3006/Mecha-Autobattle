## 把一张维修分类牌放进公有手牌再打出去（走生产路径 `Btl.打出精神或公有牌`）。
func _打(c: Dictionary, 键: String, 名: String, 目标: Variant = null) -> Dictionary:
	var 卡: Dictionary = Btl.克隆战术牌(RepairCards.按名(名), c)
	if 卡.is_empty():
		return {"成功": false, "原因": "找不到这张维修牌：%s" % 名}
	(c["公有手牌"] as Array).append(卡)
	return Btl.打出精神或公有牌(c, 键, 卡.get("id"), 目标)
