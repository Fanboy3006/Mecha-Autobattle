## 第 7 职业【维修】6 张分类牌 + 【过量整备】的单元断言（含公有冷却区 / 每场 1 次移出本场）。
## 见 协作/设计/维修职业分类牌 v0.1.md（v0.1.1）
extends RefCounted

func run(t) -> void:
	var errors := []
	t.ok(DataLoader.install(errors), "数据装入 Db%s" % ("" if errors.is_empty() else "：" + str(errors)))
	_一_牌面与注册形状(t)
	_二_入池按在场职业过滤(t)
	_三_入库条件(t)
	_四_常规整备(t)
	_五_装甲焊补(t)
	_六_强制排热(t)
	_七_野战补给(t)
	_八_全舱整备(t)
	_九_紧急损管(t)
	_十_冷却区与移出本场(t)
	_十一_阶段初清状态(t)

# ==========================================================================================
# ① 牌面：6 张，注册形状与设计稿 §1 的表逐条对齐
# ==========================================================================================
func _一_牌面与注册形状(t) -> void:
	var 表 := RepairCards.卡表()
	t.ok(表.size() == 6, "① 【维修】分类牌 6 张（实际 %d）" % 表.size())
	var 形对 := true
	for c in 表:
		形对 = 形对 and str(c.get("归属", "")) == "维修" and str(c.get("层级", "")) == "职业" \
			and str(c.get("卡类", "")) == "公有牌" and str(c.get("种类", "")) == "职业" \
			and J.truthy(c.get("分类牌")) and RepairCards.是维修牌(c)
	t.ok(形对, "① 6 张全部 `层级 = 职业` / `卡类 = 公有牌` / `种类 = 职业` / `归属 = 维修` / `分类牌 = true`")
	t.ok(RepairCards.按名("常规整备").get("id") == "RC_1" and RepairCards.按名("紧急损管").get("id") == "RC_6",
		"① id 与显示名对得上（RC_1 常规整备 … RC_6 紧急损管）")

	# 费用 / 冷却 / 入库条件（§1 表格逐字）
	var 期望 := {
		"常规整备": [0.0, 1.0, "开战即入库"],
		"装甲焊补": [10.0, 2.0, "开战即入库"],
		"强制排热": [5.0, 2.0, "第N回合"],
		"野战补给": [15.0, 3.0, "第N回合"],
		"全舱整备": [15.0, 3.0, "第N回合"],
		"紧急损管": [15.0, 0.0, "我方存活有人低于"],
	}
	for 名 in 期望.keys():
		var c := RepairCards.按名(名)
		var 条 = c.get("入库条件")
		var 型: String = "开战即入库" if 条 == null else str((条 as Dictionary).get("类型", ""))
		t.ok(float(c.get("耗气")) == 期望[名][0] and float(c.get("冷却")) == 期望[名][1] and 型 == 期望[名][2],
			"① 【%s】费用 %s / 冷却 %s / 入库条件 %s" % [名, J.s(c.get("耗气")), J.s(c.get("冷却")), 型])
	t.ok(J.truthy(RepairCards.按名("紧急损管").get("移出本场")), "① 【紧急损管】标了 `移出本场`（每场 1 次）")
	t.ok(J.truthy(RepairCards.按名("常规整备").get("进冷却区")) and not J.truthy(RepairCards.按名("紧急损管").get("进冷却区")),
		"① 只有带冷却的 5 张写了 `进冷却区`；【紧急损管】走移出本场")

# ==========================================================================================
# ② 入池：队里有维修机体才装（`DeckBuilder.公有扩展牌们` 的同一份过滤口径）
# ==========================================================================================
func _二_入池按在场职业过滤(t) -> void:
	var 有 := _场([_维修机("M9", 4)])
	var 扩展 := DeckBuilder.公有扩展牌们(有)
	var rc := 扩展.filter(func(c): return str((c as Dictionary).get("id", "")).begins_with("RC_"))
	t.ok(rc.size() == 6, "② 队里有维修机体 → 6 张维修分类牌全部进公有牌池（%d 张）" % rc.size())

	var 无 := _场([_单位("A1", 0, "近卫")])
	var 扩展2 := DeckBuilder.公有扩展牌们(无)
	var rc2 := 扩展2.filter(func(c): return str((c as Dictionary).get("id", "")).begins_with("RC_"))
	t.ok(rc2.is_empty(), "② 队里没有维修机体 → 一张都不装（%d 张）" % rc2.size())

# ==========================================================================================
# ③ 入库条件：第 2 回合起 / 我方存活有人低于 50%
# ==========================================================================================
func _三_入库条件(t) -> void:
	var u := _维修机("M9", 4)
	var c := _场([u])
	t.ok(not DeckFlow.条件满足(c, u, RepairCards.按名("强制排热").get("入库条件")), "③ 第 1 回合：【强制排热】还没入库条件")
	c["turn"] = 2.0
	t.ok(DeckFlow.条件满足(c, u, RepairCards.按名("强制排热").get("入库条件")), "③ 第 2 回合：【强制排热】入库条件满足")

	var 条: Variant = RepairCards.按名("紧急损管").get("入库条件")
	t.ok(not DeckFlow.条件满足(c, u, 条), "③ 全员满血 → 【紧急损管】不入库（留在待入库面板）")
	u["hp"] = float(u.maxHp) * 0.5
	t.ok(DeckFlow.条件满足(c, u, 条), "③ 我方有单位 HP = 50%（边界）→ 入库")

	# 阵亡单位不算「我方有人低于 50%」（血比 0 会误判，所以维修用的是 `我方存活有人低于`）
	var c2 := _场([_维修机("M9", 4), _单位("D", 5, "近卫")])
	(c2["allies"] as Array)[1]["hp"] = 0.0
	t.ok(not DeckFlow.条件满足(c2, (c2["allies"] as Array)[0], 条), "③ 只有阵亡单位低于 50% → **不入库**（存活判据）")

# ==========================================================================================
# ④ 常规整备（0 费）：残血只回血；满血 → 【过量整备】战意 +10 + 下一张武器牌每段命中 +10
# ==========================================================================================
func _四_常规整备(t) -> void:
	var u := _维修机("M9", 4)
	var t2 := _单位("A1", 0, "近卫")
	t2["hp"] = float(t2.maxHp) * 0.5
	var c := _场([u, t2])
	var 回前 := float(t2.hp)
	var 果 := _打(c, "M9", "常规整备", t2.get("key"))
	t.ok(J.truthy(果.get("成功")), "④ 常规整备打得出来（%s）" % str(果.get("原因", "")))
	t.ok(is_equal_approx(float(t2.hp), 回前 + J.round(float(t2.maxHp) * 0.15)),
		"④ 残血目标：回复 15%% 最大 HP（%s → %s）" % [J.s(回前), J.s(t2.hp)])
	t.ok(int(RepairCards.统计(c).get("过量整备", 0)) == 0, "④ 残血 → 不触发【过量整备】")

	var c2 := _场([_维修机("M9", 4), _单位("A1", 0, "近卫")])
	var 近: Dictionary = (c2["allies"] as Array)[1]
	近["战意"] = 60.0
	var 战意前 := Btl.战意(近)
	var 果2 := _打(c2, "M9", "常规整备", 近.get("key"))
	t.ok(J.truthy(果2.get("成功")), "④ 满血也能打（手牌 100%% 可打的铁律）")
	t.ok(int(Btl.战意(近)) == int(战意前) + 10, "④ 满血 → 【过量整备】目标战意 +10（%s → %s）" % [J.s(战意前), J.s(Btl.战意(近))])
	t.ok(J.same(近.get("过量整备命中"), c2.get("turn")), "④ 【过量整备】挂上「下一张武器牌每段命中 +10」标记")
	t.ok(int(RepairCards.统计(c2).get("过量整备", 0)) == 1, "④ 统计：本场【过量整备】触发 1 次")
	t.ok(float(RepairCards.命中修正(近, null, null, c2)) == 10.0, "④ 命中修正 +10")
	RepairCards.武器攻击后(c2, 近, null, 1.0, null)
	t.ok(not 近.has("过量整备命中") and float(RepairCards.命中修正(近, null, null, c2)) == 0.0,
		"④ 打完一次武器 → 命中标记吃掉（只给一张牌）")

# ==========================================================================================
# ⑤ 装甲焊补（10 费）：回 25% + 清减益；过量整备 → 有效装甲 +25%、掩护 +1
# ==========================================================================================
func _五_装甲焊补(t) -> void:
	var 塔 := _维修机("A6", 0)
	塔["掩护剩余"] = 2
	var c := _场([塔, _维修机("M9", 4)])
	塔["debuffs"] = [{"pct": 30.0, "剩余": 1.0}]
	塔["armorCut"] = 200.0
	塔["buffs"] = [{"src": "烟幕", "hit": -30.0, "剩余": 1.0}, {"src": "自家", "hit": 10.0, "剩余": 1.0}]
	var 果 := _打(c, "M9", "装甲焊补", "A6")
	t.ok(J.truthy(果.get("成功")), "⑤ 装甲焊补打得出来（%s）" % str(果.get("原因", "")))
	t.ok((塔["debuffs"] as Array).is_empty() and float(tar_armorCut(塔)) == 0.0, "⑤ 清掉破甲 / `armorCut`")
	t.ok((塔["buffs"] as Array).size() == 2 and not _有源(塔, "烟幕") and _有源(塔, "自家"),
		"⑤ 清掉命中 / 防御减益（烟幕），正面增益与被挂上的装甲 buff 留着（剩 %d 条）" % (塔["buffs"] as Array).size())
	var 甲 := Calc.buffSum(塔, "armorPct")
	t.ok(is_equal_approx(甲, 25.0), "⑤ 【过量整备】有效装甲 +25%%（armorPct = %s，进装甲共享池）" % J.s(甲))
	t.ok(int(tar_掩护补充(塔)) == 1 and BattleGuard.掩护额度(塔) == 3,
		"⑤ 有掩护 → 本回合掩护次数 +1（额度 %d）" % BattleGuard.掩护额度(塔))

# ==========================================================================================
# ⑥ 强制排热（5 费）：回 15% + 副武器冷却 −2；过量整备 → 本回合伤害 +15%
# ==========================================================================================
func _六_强制排热(t) -> void:
	var 主 := _维修机("M9", 4)
	var 攻 := _单位("A1", 0, "近卫")
	攻["副武器栏"] = [{"卡": {"名": "测试副武器"}, "cd": 3.0, "cd_max": 3.0, "本回合可用": 1, "本回合已用": 0, "禁用": false}]
	var c := _场([主, 攻])
	c["turn"] = 2.0
	var 果 := _打(c, "M9", "强制排热", "A1")
	t.ok(J.truthy(果.get("成功")), "⑥ 强制排热打得出来（%s）" % str(果.get("原因", "")))
	t.ok(is_equal_approx(float((攻["副武器栏"] as Array)[0].get("cd")), 1.0),
		"⑥ 副武器冷却 −2（3 → %s）" % J.s((攻["副武器栏"] as Array)[0].get("cd")))
	t.ok(is_equal_approx(Calc.buffSum(攻, "dmgMul"), 0.15), "⑥ 【过量整备】（满血）→ 本回合伤害 +15%")

# ==========================================================================================
# ⑦ 野战补给（15 费）：目标战意 −10 + 武器型大招冷却 −2；不能指定自己；HP ≥ 80% 抽 1 张
# ==========================================================================================
func _七_野战补给(t) -> void:
	var 主 := _维修机("M9", 4)
	var 攻 := _单位("A1", 0, "近卫")
	攻["战意"] = 100.0
	攻["大招槽"] = [
		{"卡": {"名": "测试武器大招", "武器牌": true}, "cd": 4.0, "cd_max": 4.0, "本回合已打": false, "已解锁": true},
		{"卡": {"名": "状态入场大招", "武器牌": false}, "cd": 4.0, "cd_max": 4.0, "本回合已打": false, "已解锁": true},
	]
	var c := _场([主, 攻])
	c["turn"] = 2.0
	c["公有牌库"] = [Btl.克隆战术牌({"id": "测试公有牌", "名": "测试公有牌", "卡类": "公有牌"})]
	var 果 := _打(c, "M9", "野战补给", "A1")
	t.ok(J.truthy(果.get("成功")), "⑦ 野战补给打得出来（%s）" % str(果.get("原因", "")))
	t.ok(int(攻["战意"]) == 90, "⑦ 被补给的友军战意 −10（100 → %d）" % int(攻["战意"]))
	t.ok(is_equal_approx(float((攻["大招槽"] as Array)[0].get("cd")), 2.0),
		"⑦ 武器型大招冷却 −2（4 → %s）" % J.s((攻["大招槽"] as Array)[0].get("cd")))
	t.ok(is_equal_approx(float((攻["大招槽"] as Array)[1].get("cd")), 4.0),
		"⑦ **状态入场大招不动**（仍是 %s）" % J.s((攻["大招槽"] as Array)[1].get("cd")))
	t.ok((c["公有手牌"] as Array).size() == 1, "⑦ 【过量整备】（HP ≥ 80%）→ 额外抽 1 张公有牌")

	var c2 := _场([_维修机("M9", 4), _单位("A1", 0, "近卫")])
	c2["turn"] = 2.0
	var 果2 := _打(c2, "M9", "野战补给", "M9")	# 故意指定自己
	var 我2: Dictionary = (c2["allies"] as Array)[0]
	var 友2: Dictionary = (c2["allies"] as Array)[1]
	t.ok(J.truthy(果2.get("成功")) and int(友2["战意"]) == 90 and int(我2["战意"]) == 85,
		"⑦ 指定自己 → 自动改给别的友军（友军战意 %d、打出者只付了牌费 %d）" % [int(友2["战意"]), int(我2["战意"])])

# ==========================================================================================
# ⑧ 全舱整备（15 费）：全体回 15%；满血友军战意 +5 + 受伤 −15%；代价 = 打出者不能打主武器
# ==========================================================================================
func _八_全舱整备(t) -> void:
	var 主 := _维修机("M9", 4)
	var 伤 := _单位("A1", 0, "近卫")
	伤["hp"] = float(伤.maxHp) * 0.5
	var 满 := _单位("A2", 1, "近卫")
	满["战意"] = 80.0
	var c := _场([主, 伤, 满])
	c["turn"] = 2.0
	var 果 := _打(c, "M9", "全舱整备")
	t.ok(J.truthy(果.get("成功")), "⑧ 全舱整备打得出来（%s）" % str(果.get("原因", "")))
	t.ok(float(伤.hp) > float(伤.maxHp) * 0.5, "⑧ 全体回 15%%（残血那台 %s → %s）" % [J.s(float(伤.maxHp) * 0.5), J.s(伤.hp)])
	t.ok(int(满["战意"]) == 85 and is_equal_approx(Calc.buffSum(满, "受伤Mul"), -0.15),
		"⑧ 满血友军：战意 +5（80 → %d）、受伤 −15%%" % int(满["战意"]))
	t.ok(J.truthy(主.get("主武器已销毁")), "⑧ 代价：打出者本回合不能打主武器")
	t.ok(RepairCards.卡不可打原因(c, 主, RepairCards.按名("全舱整备"), "公有牌").get("终局") == true,
		"⑧ 已经打过主武器 → 【全舱整备】本回合不可打（门槛给结论）")
	t.ok(RepairCards.卡不可打原因(c, (c["allies"] as Array)[1], RepairCards.按名("常规整备"), "公有牌").get("终局") == false,
		"⑧ 别的维修牌不受这条门槛影响")

# ==========================================================================================
# ⑨ 紧急损管（15 费，每场 1 次）：回 20% + 致命伤害锁 1 血 → 再回 20% → 打出者战意 +15
# ==========================================================================================
func _九_紧急损管(t) -> void:
	var 主 := _维修机("M9", 4)
	var 前 := _单位("A1", 0, "近卫")
	前["hp"] = float(前.maxHp) * 0.4
	var c := _场([主, 前])
	var 果 := _打(c, "M9", "紧急损管", "A1")
	t.ok(J.truthy(果.get("成功")), "⑨ 紧急损管打得出来（%s）" % str(果.get("原因", "")))
	t.ok(J.same(前.get("紧急损管中"), c.get("turn")) and str(前.get("紧急损管施放者", "")) == "M9",
		"⑨ 挂上〔紧急损管〕并记住打出者")

	# 非致命不触发
	前["hp"] = 1.0
	RepairCards.致命保留_后(c, null, 前)
	t.ok(is_equal_approx(float(前.hp), 1.0), "⑨ 还剩 1 HP（没死）→ 不触发")
	# 致命 → 锁 1 血再弹回 20%
	主["战意"] = 40.0
	前["hp"] = 0.0
	RepairCards.致命保留_后(c, null, 前)
	t.ok(is_equal_approx(float(前.hp), 1.0 + J.round(float(前.maxHp) * 0.20)),
		"⑨ 致命伤害 → 锁 1 血后弹回 20%%（现 %s）" % J.s(前.hp))
	t.ok(int(主["战意"]) == 55, "⑨ 打出者战意 +15（40 → %d）" % int(主["战意"]))
	t.ok(not 前.has("紧急损管中"), "⑨ 触发一次就消耗掉（不会连续保命）")

	# 阶段初清掉没触发的
	var c2 := _场([_维修机("M9", 4), _单位("A1", 0, "近卫")])
	var 前2: Dictionary = (c2["allies"] as Array)[1]
	前2["hp"] = float(前2.maxHp) * 0.4	# 【紧急损管】的入库条件：有我方单位 HP ≤ 50%
	var 果2 := _打(c2, "M9", "紧急损管", "A1")
	t.ok(J.truthy(果2.get("成功")) and 前2.has("紧急损管中"), "⑨ 另一场：损管挂着")
	RepairCards.我方阶段初_后(c2)
	t.ok(not 前2.has("紧急损管中"), "⑨ 下个我方阶段初清掉（只活一个敌方阶段）")

# ==========================================================================================
# ⑩ 公有冷却区 / 移出本场
# ==========================================================================================
func _十_冷却区与移出本场(t) -> void:
	var c := _场([_维修机("M9", 4), _单位("A1", 0, "近卫")])
	DeckFlow.初始化(c)
	var 果 := _打(c, "M9", "常规整备", "A1")
	t.ok(J.truthy(果.get("成功")), "⑩ 常规整备打得出来（%s）" % str(果.get("原因", "")))
	t.ok((c["公有冷却"] as Array).size() == 1 and (c["公有弃牌堆"] as Array).is_empty(),
		"⑩ 带冷却的公有牌 → 进【公有冷却区】（弃牌堆 %d 张）" % (c["公有弃牌堆"] as Array).size())
	t.ok(is_equal_approx(float((c["公有冷却"] as Array)[0].get("剩余")), 1.0), "⑩ 倒计时 = 卡上的冷却（1 回合）")
	PublicCooldown.阶段初(c)
	t.ok((c["公有冷却"] as Array).is_empty() and (c["公有牌库"] as Array).size() == 1,
		"⑩ 倒计时归 0 → 洗回公有牌库（库 %d 张）" % (c["公有牌库"] as Array).size())

	var c2 := _场([_维修机("M9", 4), _单位("A1", 0, "近卫")])
	DeckFlow.初始化(c2)
	var 前: Dictionary = (c2["allies"] as Array)[1]
	前["hp"] = float(前.maxHp) * 0.4
	_打(c2, "M9", "紧急损管", "A1")
	t.ok((c2["移出牌"] as Array).size() == 1 and (c2["公有弃牌堆"] as Array).is_empty()
		and (c2["公有冷却"] as Array).is_empty(),
		"⑩ 【紧急损管】每场 1 次 → 打出后直接移出本场（不进冷却、不进弃牌堆）")

# ==========================================================================================
# ⑪ 阶段初：「本回合」的维修状态统一清
# ==========================================================================================
func _十一_阶段初清状态(t) -> void:
	var u := _单位("A1", 0, "近卫")
	u["过量整备命中"] = 1.0
	u["紧急损管中"] = 1.0
	u["紧急损管施放者"] = "M9"
	var c := _场([_维修机("M9", 4), u])
	RepairCards.我方阶段初_后(c)
	for k in RepairCards.阶段初清键:
		t.ok(not u.has(k), "⑪ 阶段初清掉 `%s`" % k)

