## MITH-1 底层扩展验收：衍生牌通道 + 本回合连携计数器 + 4 道断路器。
## 规格 = 《评审-秘银连携作战-v0.2与派生任务单-ARGON.md》§1 / §2 / §3 MITH-1。
## 四段：① 连携计数与时序（第 1 张不自触发 / 第 2 张触发 / 穿插非秘银牌不清零 / 下回合清零）
##       ② 衍生牌通道（唯一实例号 / 只删一张 / 不回库 / 计数 +1 / 断路器 1 / 满手作废）
##       ③ 声明式触发条件（触发连携 >= N / 打出TDD1 >= N 自动发牌）
##       ④ 4 道断路器极限压测（泰莎的双倍连携 + 呼叫达纳号 + 火力支援请求 + TDD-1，出牌数有界、不死循环）
##
## 这一段全部在**开了 `选项.秘银v02` 的沙盒 ctx** 里做，用的是注入的测试牌，不碰数据库里的 32 张正式牌 ——
## 所以默认路径（关着开关）与 168 场黄金样例一个字节都不受影响（硬性红线 2）。
extends RefCounted

const 我方 := [
	{"键": "U7", "位": 0, "等级": 10}, {"键": "U6", "位": 1, "等级": 10},
	{"键": "U2", "位": 2, "等级": 10}, {"键": "U1", "位": 3, "等级": 10},
	{"键": "U8", "位": 4, "等级": 10},
]
const 敌方 := [{"键": "flagship", "位": 0, "等级": 1}, {"键": "bluefish", "位": 1, "等级": 1}]

## 沙盒 ctx：秘银五人队 + 开关开着 + 特意抬高气势（免得测试因为气势不足打不出牌）
func _ctx(气: float = 999.0) -> Dictionary:
	var c := Setup.开局(我方, 敌方, 20261016, null, {"战术卡牌": true, "秘银v02": true})
	c.气势 = 气
	return c

## 把手牌换成指定的几张（每张都按正式口径克隆，带唯一 `_实例号`）
func _装手牌(c: Dictionary, 牌们: Array) -> void:
	c.战术手牌 = []
	for x in 牌们:
		c.战术手牌.append(Btl.克隆战术牌(x, c))

## 一张测试牌（全字段显式写清，免得依赖数据表）
func _牌(id: String, 归属: String, 阈值: int = 0, 效果: Array = [], 连携: Array = [], 额外: Dictionary = {}) -> Dictionary:
	var d := {"id": id, "名": id, "归属": 归属, "层级": "势力", "耗气": 0.0, "回气": 0.0, "限次": 1.0, "冷却": 1.0,
		"效果说明": "测试牌", "效果": 效果}
	if 阈值 > 0:
		d["连携阈值"] = 阈值
		d["连携效果"] = 连携
	for k in 额外.keys():
		d[k] = 额外[k]
	return d

func _日志有(c: Dictionary, 片段: String) -> bool:
	return J.some(c.log, func(e): return e != null and str(e.get("文本", "")).contains(片段))

func _发牌条数(c: Dictionary, 牌名: String) -> int:
	return c.log.filter(func(e): return e != null and e.get("类型") == "发牌" and str(e.get("牌名", "")) == 牌名).size()

func run(t) -> void:
	var errors := []
	t.ok(DataLoader.install(errors), "数据装入 Db")

	# ==================== ① 连携计数与时序 ====================
	var c1 := _ctx()
	t.ok(int(c1.get("本回合秘银牌数", -1)) == 0 and int(c1.get("本回合连携触发倍率", -1)) == 1
			and c1.get("本回合衍生牌生成计数") is Dictionary and int(c1.get("_下个卡牌实例号", -1)) > 0,
		"① 开局初始化：本回合秘银牌数 0 / 连携触发倍率 1 / 衍生牌生成计数 {} / _下个卡牌实例号 已起号（%d）" % int(c1.get("_下个卡牌实例号", -1)))
	var 号们: Array = c1.战术手牌.map(func(x): return int(x.get("_实例号", -1)))
	var 号集 := {}
	for n in 号们:
		号集[n] = true
	t.ok(号们.size() > 0 and J.every(号们, func(n): return n > 0) and 号集.size() == 号们.size(),
		"① 发号器：开局每一张手牌都有唯一 `_实例号`（%s）" % [号们])
	t.ok(int(c1.战况计数.get("触发连携", -1)) == 0 and int(c1.战况计数.get("打出TDD1", -1)) == 0
			and c1.战况计数.has("未命中段") and c1.战况计数.has("满手牌推迟数"),
		"① 开局初始化：战况计数 新增 触发连携 0 / 打出TDD1 0，原有 6 个键一个不少")
	# 手牌：8 张占位 + 「统帅牌」（非秘银，不增不清）+ 一张带连携的秘银牌（准备打的）
	var 占位 := 8
	var 牌们 := []
	for i in range(占位):
		var 假 := _牌("JUNK_%d" % i, "其他势力")
		假["耗气"] = 999.0
		牌们.append(假)
	牌们.append(_牌("CMD_TEST", "统帅"))                                   # 非秘银：打出它不增不清
	牌们.append(_牌("F_MITH_TEST", "秘银", 1, [], [{"全局": [{"算子": "回气势", "值": 5.0}]}]))
	_装手牌(c1, 牌们)
	c1.log = []
	c1.rng.steps = 0
	c1.战况计数["触发连携"] = 0
	c1.战况计数["打出TDD1"] = 0
	c1["本回合秘银牌数"] = 0
	c1["本回合连携触发倍率"] = 1

	var 牌_统帅 = c1.战术手牌[占位]
	var 牌_秘银 = c1.战术手牌[占位 + 1]
	t.ok(not Btl.是秘银计入牌(牌_统帅) and Btl.是秘银计入牌(牌_秘银),
		"① 计入口径：统帅牌不算秘银计入牌、归属「秘银」的势力牌算")

	# 先打非秘银牌：既不增加计数、也不清零
	var r0 := Btl.打战术牌(c1, str(牌_统帅["_实例号"]))
	t.ok(r0.成功 and int(c1.本回合秘银牌数) == 0 and int(c1.战况计数["触发连携"]) == 0,
		"① 穿插打出一张非秘银（统帅）牌：本回合秘银牌数仍是 0，触发连携仍是 0（不增加也不清零）")

	# 第 1 张秘银牌：n_before == 0 → 绝不自触发
	var r1 := Btl.打战术牌(c1, str(牌_秘银["_实例号"]))
	t.ok(r1.成功 and int(c1.本回合秘银牌数) == 1, "① 第 1 张秘银牌打出后：本回合秘银牌数 = 1")
	t.ok(int(c1.战况计数["触发连携"]) == 0 and not _日志有(c1, "〔连携·"),
		"① 第 1 张秘银牌 n_before == 0：绝不触发自己的【连携·1】（触发连携 仍为 0、日志里没有〔连携·）")

	# 再放一张同样的秘银连携牌 → 第 2 张时 n_before == 1，触发【连携·1】
	var 牌_秘银2: Dictionary = Btl.克隆战术牌(_牌("F_MITH_TEST2", "秘银", 1, [], [{"全局": [{"算子": "回气势", "值": 5.0}]}]), c1)
	t.ok(Btl.是秘银计入牌(牌_秘银2), "① 计入口径：秘银势力牌按秘银口径计入")
	c1.战术手牌.append(牌_秘银2)
	c1.战况计数["触发连携"] = 0
	var r2 := Btl.打战术牌(c1, str(牌_秘银2["_实例号"]))
	t.ok(r2.成功 and int(c1.本回合秘银牌数) == 2, "① 第 2 张秘银牌打出后：本回合秘银牌数 = 2")
	t.ok(int(c1.战况计数["触发连携"]) == 1, "① 第 2 张秘银牌 n_before == 1 ≥ 阈值 1：触发连携 计数 = 1")
	t.ok(_日志有(c1, "〔连携·1〕"), "① 触发连携时日志里真的有〔连携·1〕那一条")
	var 连携条 = J.find(c1.log, func(e): return e != null and e.get("类型") == "连携")
	t.ok(连携条 != null and 连携条.get("触发连携") == true and int(连携条.get("连携前计数", -1)) == 1
			and int(连携条.get("连携倍率", -1)) == 1,
		"① 连携事件带 触发连携: true / 连携前计数: 1 / 连携倍率: 1")

	# 下回合初自动清零
	Flow.回合开始(c1)
	t.ok(int(c1.本回合秘银牌数) == 0 and int(c1.本回合连携触发倍率) == 1 and c1.本回合衍生牌生成计数.is_empty(),
		"① 下回合初 `Flow.回合开始` 自动清零：本回合秘银牌数 0 / 连携触发倍率 1 / 衍生牌生成计数 {}")
	t.ok(int(c1.战况计数["触发连携"]) == 1, "① 回合初清零只清「本回合」的，跨回合的 战况计数.触发连携 保留（1）")

	# ==================== ② 衍生牌通道 ====================
	var c2 := _ctx()
	c2.log = []
	c2.rng.steps = 0
	c2["本回合秘银牌数"] = 0
	c2.战况计数["触发连携"] = 0
	c2.战况计数["打出TDD1"] = 0
	c2.战术手牌 = []
	c2.待触发战术牌 = []
	var 置 := CardEffects.grant_derived_card(c2, "TDD-1", 2)
	t.ok(c2.战术手牌.size() == 2 and 置.size() == 2, "② 置入 2 张 TDD-1：手牌 2 张（摘要 2 条）")
	var t1 = c2.战术手牌[0]
	var t2 = c2.战术手牌[1]
	t.ok(str(t1.get("id")) == "TDD-1" and str(t2.get("id")) == "TDD-1", "② 两张衍生牌的 id 都是 TDD-1（同名）")
	t.ok(t1.get("_实例号") != null and t2.get("_实例号") != null and int(t1["_实例号"]) != int(t2["_实例号"]),
		"② 两张同名衍生牌各有**唯一** _实例号（%s vs %s）" % [t1.get("_实例号"), t2.get("_实例号")])
	t.ok(bool(t1.get("衍生", false)) and bool(t1.get("是TDD1", false)) and float(t1.get("剩余次数", 0.0)) == 1.0,
		"② 置入时强制 衍生 = true / 是TDD1 = true / 剩余次数 = 1")
	t.ok(_日志有(c2, "〔衍生牌〕置入手牌：【TDD-1 导弹】"), "② 置入写了一条「衍生牌置入」即时日志")

	var 打前: int = c2.战术手牌.size()
	var rt := Btl.打战术牌(c2, str(t1["_实例号"]))
	t.ok(rt.成功, "② 按 _实例号 打出其中 1 张 TDD-1 成功")
	t.ok(c2.战术手牌.size() == 打前 - 1, "② 手牌 %d → %d（只少了打出的那一张）" % [打前, c2.战术手牌.size()])
	t.ok(J.some(c2.战术手牌, func(x): return is_same(x, t2)), "② 另一张同名 TDD-1 还在手上（没有按 id 一次全删）")
	t.ok(not J.some(c2.待触发战术牌, func(x): return is_same(x, t1)), "② 衍生牌打出后**绝不回库**（待触发池里没有它）")
	t.ok(int(c2.本回合秘银牌数) == 1, "② 打出 TDD-1：本回合秘银牌数 +1")
	t.ok(int(c2.战况计数["打出TDD1"]) == 1, "② 打出 TDD-1：战况计数.打出TDD1 +1")
	t.ok(int(c2.战况计数["触发连携"]) == 0 and not _日志有(c2, "〔连携·"),
		"② 断路器 1：TDD-1 衍生牌绝不触发连携、绝不增加 触发连携 计数（仍为 0）")

	# 满手 10 张 → 再置入直接作废
	var c3 := _ctx()
	c3.战术手牌 = []
	for i in range(8):
		c3.战术手牌.append(Btl.克隆战术牌(_牌("JUNK_%d" % i, "其他势力"), c3))
	CardEffects.grant_derived_card(c3, "TDD-1", 2)   # 8 → 10
	t.ok(c3.战术手牌.size() == 10, "② 先垫到正好 10 张手牌")
	c3.log = []
	var 置3 := CardEffects.grant_derived_card(c3, "TDD-1", 1)
	t.ok(c3.战术手牌.size() == 10, "② 手牌已满（10/10）时再置入 TDD-1：直接作废，手牌仍是 10 张")
	t.ok(not J.some(c3.待触发战术牌, func(x): return str(x.get("id", "")) == "TDD-1"),
		"② 作废的衍生牌不进待触发池（也不是「记满手牌推迟」）")
	t.ok(int(c3.战况计数.get("满手牌推迟数", 0)) == 0,
		"② 作废没有走「满手牌推迟」那条老路（满手牌推迟数 仍是 0）、也没有记满手牌推迟记录")
	t.ok(_日志有(c3, "〔衍生牌〕手牌已满（10/10），【TDD-1 导弹】作废"), "② 日志里真有〔衍生牌〕手牌已满（10/10），【TDD-1 导弹】作废")
	t.ok(J.some(置3, func(s): return str(s).contains("衍生牌作废")), "② 作废也进了效果摘要（三层反馈的「即时」）")

	# ==================== ③ 声明式触发条件 ====================
	var c4 := _ctx()
	c4.战术手牌 = []
	c4.待触发战术牌 = []
	var 条件牌: Dictionary = Btl.克隆战术牌({
		"id": "F_MITH_LINK2", "名": "测试·连携二段", "归属": "秘银", "层级": "势力", "入牌": "条件",
		"耗气": 0.0, "回气": 0.0, "限次": 1.0, "冷却": 1.0, "效果说明": "测试牌",
		"触发条件": {"类型": "触发连携", "阈值": 2}, "触发说明": "触发连携 ≥ 2",
		"效果": [{"全局": [{"算子": "回气势", "值": 5.0}]}],
	}, c4)
	c4.待触发战术牌.append(条件牌)
	var 阈值牌: Dictionary = Btl.克隆战术牌({
		"id": "F_MITH_TDD2", "名": "测试·导弹二段", "归属": "秘银", "层级": "势力", "入牌": "条件",
		"耗气": 0.0, "回气": 0.0, "限次": 1.0, "冷却": 1.0, "效果说明": "测试牌",
		"触发条件": {"类型": "打出TDD1", "阈值": 2}, "触发说明": "打出 TDD1 ≥ 2",
		"效果": [{"全局": [{"算子": "回气势", "值": 5.0}]}],
	}, c4)
	c4.待触发战术牌.append(阈值牌)
	c4.战况计数["触发连携"] = 1
	c4.战况计数["打出TDD1"] = 1
	var 发0 := Btl.检查条件发牌(c4, "打战术牌", {"cardId": "X"})
	t.ok(发0.is_empty() and c4.待触发战术牌.size() == 2,
		"③ 计数没达标（1 < 2）：两张声明式条件牌都不发（还在待触发池里）")
	c4.战况计数["触发连携"] = 2
	c4.战况计数["打出TDD1"] = 2
	var 发1 := Btl.检查条件发牌(c4, "打战术牌", {"cardId": "X"})
	t.ok(发1.size() == 2 and c4.待触发战术牌.is_empty(),
		"③ 计数达标（2 >= 2）：触发连携 ≥ 2 与 打出TDD1 ≥ 2 两张牌都自动发入手牌")
	t.ok(_发牌条数(c4, "测试·连携二段") == 1 and _发牌条数(c4, "测试·导弹二段") == 1, "③ 两次发牌各记了一条「发牌」事件")
	# 旧触发码 MITH_LINK / MITH_TDD1 也认（读 触发阈值）
	t.ok(Btl.是否满足卡牌触发条件({"触发条件码": "MITH_LINK", "触发阈值": 2}, c4, "打战术牌", {})
			and Btl.是否满足卡牌触发条件({"触发条件码": "触发连携", "触发阈值": 2}, c4, "打战术牌", {}),
		"③ 既有触发码 MITH_LINK 与中文码 触发连携 都读 触发阈值（2）")
	t.ok(Btl.是否满足卡牌触发条件({"触发条件码": "MITH_TDD1", "触发阈值": 2}, c4, "打战术牌", {})
			and Btl.是否满足卡牌触发条件({"触发条件码": "打出TDD1", "触发阈值": 2}, c4, "打战术牌", {}),
		"③ 既有触发码 MITH_TDD1 与中文码 打出TDD1 都读 触发阈值（2）")

	# ==================== ④ 4 道断路器极限压测 ====================
	# 气势 60：够打 0 费的测试牌，但**低于统帅牌 MORALE_75 的门槛** —— 免得 CMD_ALL_OUT / CMD_COVER
	# 在打牌途中被 `检查条件发牌` 发到手牌里，把「单回合出牌数有界」这条断言搅浑。
	var c5 := _ctx(60.0)
	c5.log = []
	c5.rng.steps = 0
	c5.战况计数["触发连携"] = 0
	c5.战况计数["打出TDD1"] = 0
	c5["本回合秘银牌数"] = 0
	c5["本回合连携触发倍率"] = 1
	var 泰莎 := _牌("CARD_TAISA", "秘银", 1, [{"全局": [{"算子": "双倍连携", "倍率": 2},
			{"算子": "置入衍生牌", "模板": "TDD-1", "数量": 1, "每回合上限": 2}]}],
		[{"全局": [{"算子": "回气势", "值": 10.0}, {"算子": "减秘银牌冷却", "值": 1}]}],
		{"回库": true, "冷却": 1.0})
	泰莎["名"] = "泰莎的指令"
	var 呼叫 := _牌("CARD_DANA", "秘银", 1, [{"全局": [{"算子": "置入衍生牌", "模板": "TDD-1", "数量": 1, "每回合上限": 2}]}],
		[{"全局": [{"算子": "置入衍生牌", "模板": "TDD-1", "数量": 1, "每回合上限": 99}]}],
		{"回库": true, "冷却": 1.0})
	呼叫["名"] = "呼叫达纳号"
	var 火力 := _牌("CARD_FIRE", "秘银", 1, [{"全局": [{"算子": "置入衍生牌", "模板": "TDD-1", "数量": 2, "每回合上限": 2}]}],
		[{"全局": [{"算子": "减秘银牌冷却", "值": 99}]}],
		{"回库": true, "冷却": 1.0})
	火力["名"] = "火力支援请求"
	# 手牌 = 3 张 0 费的测试牌 + 1 张额外的「泰莎的指令」（用来连打两次 —— 每张实例号各不相同）
	var 牌序 := [泰莎, 呼叫, 火力, 泰莎]
	_装手牌(c5, 牌序)
	var 实例号们: Array = c5.战术手牌.map(func(x): return int(x["_实例号"]))
	t.ok(J.every(c5.战术手牌, func(x): return float(x.get("耗气", 1.0)) == 0.0),
		"④ 构造场景：手里 4 张全是 0 费牌（实例号 %s），气势 999 全都打得出" % [实例号们])
	t.ok(实例号们.size() == 4 and int(c5.本回合衍生牌生成计数.size()) == 0, "④ 构造场景：4 张牌各有唯一实例号，本回合衍生牌生成计数 从 {} 起")

	# 连续打出 2 次「泰莎的指令」
	var 打泰莎a := Btl.打战术牌(c5, 实例号们[0])
	var 打泰莎b := Btl.打战术牌(c5, 实例号们[3])
	t.ok(打泰莎a.成功 and 打泰莎b.成功, "④ 连续打出 2 次「泰莎的指令」都成功")
	t.ok(int(c5.本回合连携触发倍率) == 2, "④ 断路器 4：连打 2 张双倍连携牌，本回合连携触发倍率仍是 2（绝不叠成 4）")
	t.ok(int(c5.本回合连携触发倍率) <= 2 and clampi(int(c5.本回合连携触发倍率), 1, 2) == 2, "④ 断路器 4：倍率被封顶在 2")

	# 依次打出剩余可用牌：最多 20 次，且每一次失败都必须有明确的理由（绝不死循环）
	var 打了 := 0
	var 失败理由 := []
	var 试过 := {}
	while 打了 < 20:
		var 目标号 = null
		for x in c5.战术手牌:
			if x != null and not 试过.has(str(x.get("_实例号", ""))):
				目标号 = str(x["_实例号"])
				break
		if 目标号 == null:
			break
		试过[目标号] = true
		var r := Btl.打战术牌(c5, 目标号)   # 每张实例号只试一次（`_实例号` 是唯一键，绝不受手牌下标漂移影响）
		if not r.成功:
			失败理由.append(str(r.get("原因", "")))
			continue
		打了 += 1
	t.ok(打了 <= 20, "④ 单回合循环尝试打出所有可用手牌：总出牌数 %d 张（严格有界，≤ 20）" % 打了)
	t.ok(打了 >= 5, "④ 真的打出去了 %d 张（泰莎 ×2 + 呼叫达纳号 + 火力支援请求 + 至少 1 张 TDD-1）" % 打了)
	t.ok(J.every(失败理由, func(s): return ["气势不足", "冷却中", "手牌中不存在该战术牌", "使用次数已用尽"].has(str(s))),
		"④ 每一次失败都给了明确理由（%s），没有含糊的静默失败" % [失败理由])
	t.ok(int(c5.战况计数["打出TDD1"]) >= 1, "④ 真的打出了 TDD-1（战况计数.打出TDD1 = %d）" % int(c5.战况计数["打出TDD1"]))
	t.ok(int(c5.战况计数["触发连携"]) >= 2, "④ 真的触发了连携（战况计数.触发连携 = %d）" % int(c5.战况计数["触发连携"]))

	# 断路器 3：回库后即使冷却被减到 0，本回合内也绝不发回手牌
	var 呼叫牌 = J.find(c5.待触发战术牌, func(x): return x != null and str(x.get("id", "")) == "CARD_DANA")
	var 火力牌 = J.find(c5.待触发战术牌, func(x): return x != null and str(x.get("id", "")) == "CARD_FIRE")
	t.ok(呼叫牌 != null and 火力牌 != null, "④ 「呼叫达纳号」「火力支援请求」打出后都回了库（在待触发池里）")
	t.ok(呼叫牌 != null and int(呼叫牌.get("上次打出回合", -1)) == int(c5.turn), "④ 回库牌记了 上次打出回合 == ctx.turn（%d）" % int(c5.turn))
	呼叫牌["当前冷却"] = 0
	火力牌["当前冷却"] = 0
	火力牌["触发条件"] = {"类型": "触发连携", "阈值": 1}   # 条件必然成立：只考断路器 3
	var 手牌前: int = c5.战术手牌.size()
	var 发 := Btl.检查条件发牌(c5, "打战术牌", {"cardId": "X"})
	t.ok(发.is_empty() and c5.战术手牌.size() == 手牌前,
		"④ 断路器 3：冷却被减到 0（条件也成立）也不发 —— 本回合已打出的非衍生牌本回合内绝不回手")
	t.ok(J.some(c5.待触发战术牌, func(x): return is_same(x, 火力牌)), "④ 被挡下的牌还在待触发池里等着（不是丢了）")
	# 对照（证伪用）：去掉「上次打出回合」这条阻断 → 同一张牌立刻发得回来
	火力牌.erase("上次打出回合")
	var 发2 := Btl.检查条件发牌(c5, "打战术牌", {"cardId": "X"})
	t.ok(发2.size() == 1 and J.some(发2, func(x): return is_same(x, 火力牌)),
		"④ 对照：把 上次打出回合 抹掉，同一张牌马上就发得回来（证明挡住它的真是断路器 3）")

	# 下一回合：清掉「本回合」标记 + 冷却归零 → 才能重新发牌
	c5["本回合秘银牌数"] = 0
	c5["本回合连携触发倍率"] = 1
	for x in c5.战术手牌:
		x.erase("上次打出回合")
	火力牌.erase("上次打出回合")   # 它已经被发回手牌了（见上一条），这里只留一张干净的第 2 回合复验牌
	c5.turn = float(c5.turn) + 1.0
	# 最终验收：第 2 回合里放一张「上次打出回合 = 1（不是本回合）」的回库牌 —— 它必须真的发得回来
	var 复验牌: Dictionary = Btl.克隆战术牌({
		"id": "CARD_FIRE2", "名": "火力支援请求·复验", "归属": "秘银", "层级": "势力", "入牌": "条件",
		"耗气": 0.0, "回气": 0.0, "限次": 1.0, "冷却": 1.0, "效果说明": "测试牌",
		"触发条件": {"类型": "触发连携", "阈值": 1}, "触发说明": "触发连携 ≥ 1",
		"效果": [{"全局": [{"算子": "回气势", "值": 5.0}]}],
	}, c5)
	复验牌["上次打出回合"] = int(c5.turn) - 1
	复验牌["当前冷却"] = 0
	c5.待触发战术牌.append(复验牌)
	var 发3 := Btl.检查条件发牌(c5, "打战术牌", {"cardId": "X"})
	t.ok(J.some(发3, func(x): return is_same(x, 复验牌)) and J.some(c5.战术手牌, func(x): return is_same(x, 复验牌)),
		"④ 第 2 回合初（turn = %d）：`上次打出回合 = %d` 不再是本回合、冷却 0、条件达标 → 真的重新发回了手牌" % [int(c5.turn), int(c5.turn) - 1])

	# 顺带：`endTurn` 会给待触发池里的回库牌走一格冷却（Loop-3 断路器的一半）
	var c6 := _ctx()
	c6.战术手牌 = []
	var 回库牌: Dictionary = Btl.克隆战术牌(火力, c6)
	回库牌["上次打出回合"] = int(c6.turn)
	回库牌["当前冷却"] = 2
	c6.待触发战术牌 = [回库牌]
	Setup.endTurn(c6)
	t.ok(int(回库牌.get("当前冷却", -1)) == 1, "④ endTurn：待触发池里冷却中的回库牌冷却 2 → 1（下一回合才可能回到 0）")
