## ★ A1（作者 2026-10-17 拍板）：**装甲在「一次攻击」内是一个共享抵消池** —— 内核验收。
##
## 受控单位（不走 `Setup.开局`，直接造裸字典）：令 `atk == D`（⇒ `coef == 1`）、`defMul == 1`、
## `armor = 600`、`power = 500`，所以每段伤害都是干净整数，可以逐段断言精确数字。
##   池：`absorb = min(池, W)` → `池 -= absorb` → `base = W - absorb` → `dmg = maxf(10, round(base * coef))`。
##
## 开关 = `Params.装甲共享池()`（实现是 `return 单机牌组_开()`，默认 false）。
## 关着那条路必须**逐字等于改前**：每段各减一次整个 `A`（12 段 × max(10, 500-600) = 120）。
## 本文件跑完会把 `Db.T.战斗结构.单机牌组.开` 还原成进来时的值（后面的测试仍走改前口径）。
extends RefCounted

const 甲 := 600.0
const 攻 := 500.0

func run(t) -> void:
	var errors := []
	t.ok(DataLoader.install(errors), "数据装入 Db%s" % ("" if errors.is_empty() else "：" + str(errors)))
	_段1(t)
	_段2(t)
	_段4(t)
	_段5(t)
	_段6(t)
	_段7(t)

# ==========================================================================================
# ① 12 段 × 威力 500 vs 装甲 600，全段命中 → 10 + 400 + 500×10 = 5410
# ==========================================================================================
func _段1(t) -> void:
	var att := _单位("ally", 4.0, 攻, 0.0, 0.0)
	var def := _单位("enemy", 0.0, 0.0, 甲, 攻)
	var r := Calc.resolveAttack(att, def, _武(500.0, 12), _场(att, def), {})
	var 详情 := _段串(r)
	t.ok(int(_字段(r).get("命中段数")) == 12, "① 12 段全中：命中段数 = %d" % int(_字段(r).get("命中段数")))
	t.ok(详情.size() == 12 and str(详情[0]).contains("第 1 段（必中）10") and str(详情[1]).contains("第 2 段（必中）400"),
		"① 逐段：第 1 段被全额吸收 → 保底 %s；第 2 段只吸收剩余 100 → %s" % [str(详情[0]), str(详情[1])])
	t.ok(详情.size() == 12 and str(详情[2]).contains("第 3 段（必中）500") and str(详情[11]).contains("第 12 段（必中）500"),
		"① 逐段：第 3–12 段池已空 → 全额 %s …（第 12 段 = %s）" % [str(详情[2]), str(详情[11])])
	t.ok(_数(r) == 5410, "① 12 段 × 500 vs 装甲 600（全中）→ 总伤害 = %d（期望 10 + 400 + 500×10 = 5410）" % _数(r))

# ==========================================================================================
# ② 1 段 × 威力 2200 vs 装甲 600 → 1600（单段武器零回归）
# ==========================================================================================
func _段2(t) -> void:
	var att := _单位("ally", 4.0, 攻, 0.0, 0.0)
	var def := _单位("enemy", 0.0, 0.0, 甲, 攻)
	var r := Calc.resolveAttack(att, def, _武(2200.0, 1), _场(att, def), {})
	t.ok(_数(r) == 1600, "② 1 段 × 2200 vs 装甲 600 → 总伤害 = %d（期望 2200 - 600 = 1600）" % _数(r))

# ==========================================================================================
# ④ 打空段不扣池：12 段中前 3 段打空、其余命中 → 10 + 400 + 500×7 = 3910
# ==========================================================================================
func _段4(t) -> void:
	var 种子 := _找种子()
	t.ok(种子 > 0, "④ 找到一个「前 3 段打空、第 4–12 段全中」的种子：%d" % 种子)
	if 种子 <= 0:
		return
	var att := _单位("ally", 4.0, 攻, 0.0, 0.0)
	var def := _单位("enemy", 0.0, 0.0, 甲, 攻)
	# 非必中、命中率 50%；靶在前排（不被挡）；critBase = -10 ⇒ critRate = 0（不暴击）
	var r := Calc.resolveAttack(att, def, _武(500.0, 12, "direct", {"hit": 50.0}), _场(att, def, 种子), {})
	var 详情 := _段串(r)
	var 打空: Array = []
	for i in 详情.size():
		if str(详情[i]).contains("未中"):
			打空.append(i + 1)
	t.ok(打空 == [1, 2, 3], "④ 前 3 段打空、其余 9 段命中（实际打空段号 = %s、命中段数 = %d）" % [str(打空), int(_字段(r).get("命中段数"))])
	t.ok(_数(r) == 3910,
		"④ 打空段不扣池（池仍是 600）：第 4 段 10 + 第 5 段 400 + 第 6–12 段 500×7 → 总伤害 = %d（期望 3910）" % _数(r))

# ==========================================================================================
# ⑤ 池不跨攻击：连续两次同一武器攻击 → 第二次的伤害分布与第一次逐段相同
# ==========================================================================================
func _段5(t) -> void:
	var att := _单位("ally", 4.0, 攻, 0.0, 0.0)
	var def := _单位("enemy", 0.0, 0.0, 甲, 攻)
	var c := _场(att, def)
	var w := _武(500.0, 12)
	var 一 := Calc.resolveAttack(att, def, w, c, {})
	var 伤害一 := _数(一)
	var 详一 := str(_字段(一).get("详情"))
	def.hp = 999999.0
	var 二 := Calc.resolveAttack(att, def, w, c, {})
	t.ok(伤害一 == 5410 and _数(二) == 5410,
		"⑤ 池不跨攻击：第一次 = %d、第二次 = %d（每次攻击重新按 A = 600 初始化，都该是 5410）" % [伤害一, _数(二)])
	t.ok(str(_字段(二).get("详情")) == 详一, "⑤ 第二次的逐段伤害分布与第一次逐字相同")

# ==========================================================================================
# ⑥ `无视防御` / `特殊`：整条跳过池 —— 开着与关着的总伤害逐字相同
# ==========================================================================================
func _段6(t) -> void:
	for 组 in [["无视防御", {"ignoreDef": true}, "物理"], ["特殊", {}, "特殊"]]:
		var 名: String = str(组[0])
		var 额外: Dictionary = 组[1]
		var 型: String = str(组[2])
		var 伤 := _打一次(额外, 型)
		t.ok(伤 == 6000,
			"⑥ `%s`：总伤害 = %d（12 × 500 = 6000，整条跳过池）" % [名, 伤])

## 一击 12 段、atk = 0 / D = 0（⇒ coef = 1）、装甲 600：物理 / 无视防御 / 特殊 三种口径共用
func _打一次(额外: Dictionary, 型: String) -> int:
	var att := _单位("ally", 4.0, 0.0, 0.0, 0.0)
	var def := _单位("enemy", 0.0, 0.0, 甲, 0.0)
	var 额 := 额外.duplicate()
	额["dmgType"] = 型
	var r := Calc.resolveAttack(att, def, _武(500.0, 12, "map", 额), _场(att, def), {})
	return _数(r)

# ==========================================================================================
# ⑦ ★ 第 1 项断路器修复的硬断言：**不动全局开关**，只传 `ctx.选项 = {"单机牌组": true}`
#    —— 证明实战 `ctx` 那条路真的打通了（DS41F 断的就是这条路）。
# ==========================================================================================
func _段7(t) -> void:
	var 纯ctx := {"选项": {"单机牌组": true}}
	var att := _单位("ally", 4.0, 攻, 0.0, 0.0)
	var def := _单位("enemy", 0.0, 0.0, 甲, 攻)
	var r := Calc.resolveAttack(att, def, _武(500.0, 12), _场(att, def, 20261017, 纯ctx), {})
	var 详情 := _段串(r)
	t.ok(_数(r) == 5410,
		"⑦ ★★ 只传 `ctx.选项 = {单机牌组:true}`：12×500 打甲 600 = **%d**（期望 5410）" % _数(r))
	t.ok(详情.size() == 12 and str(详情[1]).contains("400") and str(详情[11]).contains("500"),
		"⑦ 逐段也真的走了共享池：第 2 段 = %s … 第 12 段 = %s" % [str(详情[1]), str(详情[11])])

# ==========================================================================================
# 小工具
# ==========================================================================================
func _单位(side: String, 位: float, 射: float, 甲值: float, 防值: float) -> Dictionary:
	var 键 := "测试攻方" if side == "ally" else "测试靶"
	return {
		"key": 键, "name": 键, "side": side, "slot": 位, "lv": 10.0,
		"maxHp": 999999.0, "hp": 999999.0,
		"melee": 射, "shoot": 射, "awaken": 0.0, "defense": 防值,
		"armor": 甲值, "armorCut": 0.0, "eva": 0.0, "aim": 160.0,
		"critBase": -10.0, "critMod": 0.0, "mov": 5.0,
		"buffs": [], "debuffs": [], "abilities": [],
		"shield": 0.0, "shieldHp": 0.0, "barrierLeft": 0.0,
		"tags": {}, "weapons": [],
	}

func _武(威力: float, 段数: int, fire: String = "map", 额外: Dictionary = {}) -> Dictionary:
	var w := {
		"name": "测试武器", "fire": fire, "dmgType": "物理", "power": 威力, "hit": 100.0,
		"stat": "射击", "hits": float(段数), "cd": 0.0, "upgrades": [],
	}
	for k in 额外.keys():
		w[k] = 额外[k]
	return w

func _场(att: Dictionary, def: Dictionary, 种子: int = 20261017, 额外: Dictionary = {}) -> Dictionary:
	var c := {
		"turn": 1.0, "种子": float(种子), "rng": Mulberry32.new(种子),
		"allies": [att], "enemies": [def], "log": [], "_rng_at": [],
		"当前战术": null, "气势": 0.0,
	}
	for k in 额外.keys():
		c[k] = 额外[k]
	return c

func _字段(r: Dictionary) -> Dictionary:
	var 字 = r.get("字段")
	return 字 if 字 is Dictionary else {}

func _数(r: Dictionary) -> int:
	return int(float(_字段(r).get("伤害")))

func _段串(r: Dictionary) -> Array:
	return str(_字段(r).get("详情")).split("；")

## 找一个「第 1–3 段打空、第 4–12 段全中」的种子。抽数顺序与 `resolveAttack` 逐字一致：
##   每段先抽命中（`next_float() * 100 < 50`）；中了才再抽一次暴击（critRate = 0 → 恒不暴击，但照抽）。
func _找种子() -> int:
	for s in range(1, 200001):
		var r := Mulberry32.new(s)
		var 好 := true
		for i in 12:
			var 中 := r.next_float() * 100.0 < 50.0
			if i < 3:
				if 中:
					好 = false
					break
			else:
				if not 中:
					好 = false
					break
				r.next_float()
		if 好:
			return s
	return 0
