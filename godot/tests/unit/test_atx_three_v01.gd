# ⑤ 响介【正面突破】：近战打**同列**目标 每段命中 +10、暴击 +10（贴前后命中率）
# ==========================================================================================
func _段5_响介正面突破(t) -> void:
	var 响 := _友(0.0, "A1")
	响["name"] = "响介"
	var 同列 := _靶(0.0)          # 敌方前排 0 号 = 与响介同列
	var 异列 := _靶(1.0)          # 敌方前排 1 号 = 不同列
	var c := _场([响], [同列, 异列])
	var 近 := {"name": "左轮打桩机", "fire": "melee", "dmgType": "物理", "power": 700.0,
		"hit": 70.0, "stat": "格斗", "hits": 6.0, "critMod": 20.0}
	var 直 := {"name": "三连机炮", "fire": "direct", "dmgType": "物理", "power": 300.0,
		"hit": 80.0, "stat": "射击", "hits": 5.0, "critMod": 0.0}
	var 同命中 := int(Calc.hitRate(响, 近, 同列, {"baseHit": 70.0, "ctx": c}).hit)
	var 异命中 := int(Calc.hitRate(响, 近, 异列, {"baseHit": 70.0, "ctx": c}).hit)
	var 直命中 := int(Calc.hitRate(响, 直, 同列, {"baseHit": 80.0, "ctx": c}).hit)
	t.info("⑤ 近战命中率：同列 %d%%（70 + 10） / 不同列 %d%%（70 + 0） / 同列但**直射** %d%%（80 + 0）" % [
		同命中, 异命中, 直命中])
	t.ok(同命中 - 异命中 == 10 and 异命中 == 70,
		"⑤ 近战打**同列**目标：每段命中 **+10**（%d%% → %d%%）；不同列不吃（%d%%）" % [异命中, 同命中, 异命中])
	t.ok(直命中 == 80, "⑤ 只有**近战**吃【正面突破】：直射打同列 = %d%%（80 + 0）" % 直命中)
	var 同暴 := int(Calc.critRate(近, 响, 同列, c))
	var 异暴 := int(Calc.critRate(近, 响, 异列, c))
	t.info("⑤ 暴击率：同列 %d%% / 不同列 %d%%" % [同暴, 异暴])
	t.ok(同暴 - 异暴 == 10, "⑤ 近战打**同列**目标：暴击 **+10**（%d%% → %d%%）" % [异暴, 同暴])
	# 不是响介就没有这条（对照）
	var 拉 := _拉(2.0)
	var c2 := _场([拉], [_靶(2.0)])
	var 拉命 := int(Calc.hitRate(拉, 近, _靶(2.0), {"baseHit": 70.0, "ctx": c2}).hit)
	t.ok(拉命 == 70, "⑤ 对照：拉米亚近战打同列 = %d%%（不是响介，没有【正面突破】）" % 拉命)
	# 「连续攻击（近卫通用）」：近卫职业 + 击破 → 【连续攻击】额度按同一口径记一次
	t.ok(Units.unit_class(响, c) == "近卫" or str(响.get("tags", {}).get("战斗分类", "")) == "近卫",
		"⑤ 「连续攻击（近卫通用）」口径：`Btl.连续攻击可用` / `连续攻击记` 是近卫的通用能力（不走本批新码）")

