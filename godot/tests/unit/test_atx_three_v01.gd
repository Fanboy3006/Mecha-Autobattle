		e["weak"] = {"光束": -60.0}          # 光束抗性 −60%
		e["eva"] = -100.0                    # 每段必中，只留下抗性这一个变量
		a2["战意"] = 100.0
		if 开:
			_给牌(a2, "ATX2_S7")
			var r := Btl.打出精神或公有牌(c, a2.key, "ATX2_S7")
			t.ok(r.get("成功") == true and J.round(_buff(a2, "无视抗性")) == 1,
				"⑰ 打出【抗光束？那换实弹】成功且挂上「无视抗性」（buff = %s）" % J.s(_buff(a2, "无视抗性")))
		a2["主武器已销毁"] = false
		_给牌(a2, "ATX2_W1")                 # 嚎叫发射器·光束 800 × 3
		var r2 := Btl.打出精神或公有牌(c, a2.key, "ATX2_W1")
		t.ok(r2.get("成功") == true, "⑰ 主武器打出成功（%s）" % str(r2.get("原因", "")))
		var 攻 := _末攻(c)
		伤们.append(J.round(J.num0(攻.get("伤害"))))
		t.ok(J.num0(攻.get("段数")) == 3 and J.num0(攻.get("命中段数")) == 3,
			"⑰ 3 段全中（段数 %s / 命中 %s）—— 只让抗性变、别的都不变" % [
				J.s(J.num0(攻.get("段数"))), J.s(J.num0(攻.get("命中段数")))])
	t.ok(伤们.size() == 2 and int(伤们[0]) == 960 and int(伤们[1]) == 2400,
		"⑰ ★ 实测：无【抗光束】**%d**（800 × 3 × 40%% = 960）→ 有【抗光束】**%d**（800 × 3 = 2400，抗性归零）" % [
			int(伤们[0]) if 伤们.size() > 0 else -1, int(伤们[1]) if 伤们.size() > 1 else -1])

# ==========================================================================================
# ⑱ ★「再来一把」（ATX1_S6）：把上一张武器牌打空的段向原目标重打一次，每段 50%、仍按命中判定
# ==========================================================================================
func _段18_再来一把(t) -> void:
	var c := _场([_友(0.0, "A1")], [_敌(0.0, _武(500.0, 1, 80.0))], 20261022)
	var a1 = c.allies[0]
	var e = c.enemies[0]
	e["eva"] = 40.0                              # 三连机炮 命中 80 − 40 = 40% → 一定有打空段
	a1["战意"] = 100.0
	c["turn"] = 2.0
	_给牌(a1, "ATX1_W1")                          # 三连机炮 300 × 5
	var r := Btl.打出精神或公有牌(c, a1.key, "ATX1_W1")
	t.ok(r.get("成功") == true, "⑱ 先打一张武器牌（%s）" % str(r.get("原因", "")))
	var 打空 := AtxThree.上次打空段(a1)
	t.ok(打空 > 0 and 打空 < 5, "⑱ 上一张武器牌打空 **%d 段**（5 段里）" % 打空)
	var 原 := _末攻(c)
	var 原中 := int(J.num0(原.get("命中段数")))
	var 原伤 := J.num0(原.get("伤害"))
	var 每段: float = float(J.round(原伤 / float(原中))) if 原中 > 0 else 0.0
	t.ok(原中 > 0 and 原伤 > 0, "⑱ 原攻击：命中 %d 段 / 总伤害 %s（每段 %s）" % [原中, J.s(原伤), J.s(每段)])
	a1["主武器已销毁"] = false
	_给牌(a1, "ATX1_S6")
	var r2 := Btl.打出精神或公有牌(c, a1.key, "ATX1_S6")
	t.ok(r2.get("成功") == true, "⑱ 打出【再来一把】成功（%s）" % str(r2.get("原因", "")))
	var 末 := _末攻(c)
	var 名 := str(末.get("武器", ""))
	t.ok(J.num0(末.get("段数")) == 打空 and int(J.num0(末.get("重打段"))) == 打空,
		"⑱ ★ 重打独立成一条攻击记录、段数 = 打空段 **%d**（记录「%s」%d 段）" % [
			打空, 名, int(J.num0(末.get("段数")))])
	t.ok(J.round(J.num0(末.get("单段威力"))) == 150,
		"⑱ ★ 每段 50%%：300 × 50%% = **%s**" % J.s(J.round(J.num0(末.get("单段威力")))))
	t.ok(J.round(J.num0(末.get("伤害"))) == int(J.num0(末.get("命中段数"))) * J.round(每段 * 0.5)
		and J.num0(末.get("命中段数")) <= 打空,
		"⑱ 重打仍按命中判定：命中 %d 段 × %s（= 原每段 %s 的 50%%）= **%s**（不是无条件全中）" % [
			int(J.num0(末.get("命中段数"))), J.s(J.round(每段 * 0.5)), J.s(每段),
			J.s(J.round(J.num0(末.get("伤害"))))])
	t.ok(J.truthy(a1.get("连续攻击已用")), "⑱ 代价：本回合响介不能用连续攻击（`连续攻击已用` = true）")
	# 账已清 → 第二次打不出去
	a1["主武器已销毁"] = false
	_给牌(a1, "ATX1_S6")
	t.ok(str(AtxThree.不可打原因(c, a1, AtxThree.卡("ATX1_S6"))).contains("武器牌"),
		"⑱ 打完一次后账已清 → 再打【再来一把】：%s" % AtxThree.不可打原因(c, a1, AtxThree.卡("ATX1_S6")))
	# 原目标已死 → 明确原因
	var d := _场([_友(0.0, "A1")], [_敌(0.0, _武(500.0, 1, 80.0))], 20261022)
	var b = d.allies[0]
	d.enemies[0]["eva"] = 40.0
	b["战意"] = 100.0
	d["turn"] = 2.0
	_给牌(b, "ATX1_W1")
	Btl.打出精神或公有牌(d, b.key, "ATX1_W1")
	d.enemies[0]["hp"] = 0.0
	b["主武器已销毁"] = false
	_给牌(b, "ATX1_S6")
	t.ok(str(AtxThree.不可打原因(d, b, AtxThree.卡("ATX1_S6"))).contains("原目标已被击破"),
		"⑱ 原目标已被击破 → 明确原因：%s" % AtxThree.不可打原因(d, b, AtxThree.卡("ATX1_S6")))

# ==========================================================================================
# ⑲ ★「艾克赛琳，跟上」（ATX1_S8）：她对响介打的那台目标的援护射击 暴击 +30、不算消耗次数
# ==========================================================================================
func _段19_跟上(t) -> void:
	var 已用们: Array = []
	for 打跟上 in [false, true]:
		var c := _场([_友(0.0, "A1"), _艾(1.0)], [_敌(0.0, _武(500.0, 1, 80.0))])
		var a1 = c.allies[0]
		var a2 = c.allies[1]
		var e = c.enemies[0]
		e["eva"] = -100.0
		c["turn"] = 2.0
		a1["战意"] = 100.0
		c["选项"] = {"卡牌流转": true}
		if 打跟上:
			_给牌(a1, "ATX1_S8")
			var r := Btl.打出精神或公有牌(c, a1.key, "ATX1_S8")
			t.ok(r.get("成功") == true and c.get(AtxThree.援护键) is Dictionary,
				"⑲ 打出【艾克赛琳，跟上】成功、账已开（%s）" % str(c.get(AtxThree.援护键)))
		# 响介先打一发（把「同一目标」接上）
		a1["主武器已销毁"] = false
		_给牌(a1, "ATX1_W1")
		Btl.打出精神或公有牌(c, a1.key, "ATX1_W1")
		if 打跟上:
			var 账 = c.get(AtxThree.援护键)
			t.ok(账 is Dictionary and str((账 as Dictionary).get("目标", "")) == str(e.get("key")),
				"⑲ 响介出手后账里的目标 = **%s**" % str((账 as Dictionary).get("目标", "")) if 账 is Dictionary else "（没开账）")
		# 她打援护射击
		var 卡 := AtxThree.卡("ATX2_D1").duplicate(true)
		a2["副武器栏"] = [{"卡": 卡, "本回合可用": 1, "本回合已用": 0, "禁用": false,
			"cd": 0.0, "cd_max": 0.0}]
		var r2 := DeckFlow.打出副武器(c, a2.key, "ATX2_D1", e.key)
		t.ok(r2.get("成功") == true, "⑲ 援护射击打出来了（%s）" % str(r2.get("原因", "")))
		已用们.append(int((a2["副武器栏"][0] as Dictionary).get("本回合已用", -1)))
		if 打跟上:
			var 行 := _找行(c, "的援护射击：暴击")
			t.ok(行 != "（没有这一行）" and int(J.num0(_行字段(c, "援护跟上").get("暴击加"))) == 30,
				"⑲ ★ 即时那一行：%s" % 行)
			t.ok(J.truthy(_行字段(c, "援护跟上").get("不算次数")),
				"⑲ 这一发**不算消耗次数**（记录字段 `不算次数` = true）")
			var 账2 = c.get(AtxThree.援护键)
			t.ok(账2 is Dictionary and J.truthy((账2 as Dictionary).get("已用")),
				"⑲ 账一次用完即清（`已用` = true），同一张牌只吃一次")
	t.ok(已用们.size() == 2 and int(已用们[0]) == 1 and int(已用们[1]) == 0,
		"⑲ ★ 对照：没打【跟上】→ 本回合已用 **%s** / 1；打了 → **%s** / 1（真的不消耗次数）" % [
			str(已用们[0]) if 已用们.size() > 0 else "?", str(已用们[1]) if 已用们.size() > 1 else "?"])
	# 机制对账：`critMod +30` 进 `critRate` 正好 +30 个百分点
	var c3 := _场([_艾(1.0)], [_敌(0.0, _武(500.0, 1, 80.0))])
	var a3 = c3.allies[0]
	var e3 = c3.enemies[0]
	var w基: Dictionary = (AtxThree.卡("ATX2_D1").get("武器") as Dictionary).duplicate(true)
	var w加: Dictionary = w基.duplicate(true)
	w加["critMod"] = float(J.num0(w加.get("critMod"))) + 30.0
	var 基: int = int(J.round(Calc.critRate(w基, a3, e3, c3)))
	var 加: int = int(J.round(Calc.critRate(w加, a3, e3, c3)))
	t.ok(加 - 基 == 30, "⑲ ★ 暴击 **+30 个百分点** 真的进 `critRate`（%d%% → %d%%）" % [基, 加])

