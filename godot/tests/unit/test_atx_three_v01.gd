# ⑧ 穿云箭：`无视遮挡` 与距离下限 3 真的生效（站前排只能打敌方后排）
# ==========================================================================================
func _段8_穿云箭无视遮挡与距离下限(t) -> void:
	var 拉 := _拉(0.0)                                  # 我方前排 0 号（col 0）
	var 敌前 := _靶(0.0)                                # 敌方前排 0 号（col 0，真实距离 1）
	var 敌后0 := _靶(4.0)                               # 敌方后排 col 0（真实距离 2）
	var 敌后1 := _靶(5.0)                               # 敌方后排 col 1（真实距离 3）
	var c := _场([拉], [敌前, 敌后0, 敌后1])
	var w: Dictionary = AtxThree.卡("ATX3_W4").get("武器")
	t.ok(J.truthy(Reach.无视遮挡(w)), "⑧ 穿云箭的数据里带 `无视遮挡`")
	for e in [敌前, 敌后0, 敌后1]:
		var 判 := Reach.武器可达吗(c, 拉, w, e)
		t.info("⑧ 穿云箭 → %s（真实距离 %d）：可达 = %s（%s）" % [
			Fm.位名((e as Dictionary).get("slot")), Fm.真实距离(0.0, (e as Dictionary).get("slot")),
			str(判.get("ok")), str(判.get("why"))])
	t.ok(not J.truthy(Reach.武器可达吗(c, 拉, w, 敌前).get("ok")),
		"⑧ 距离 1（正对面那把前排）→ **打不到**（距离下限 3）")
	t.ok(not J.truthy(Reach.武器可达吗(c, 拉, w, 敌后0).get("ok")),
		"⑧ 距离 2（同列敌方后排）→ **打不到**（距离下限 3）")
	t.ok(J.truthy(Reach.武器可达吗(c, 拉, w, 敌后1).get("ok")),
		"⑧ 距离 3（敌方后排另一列）→ **打得到**（站前排只能打敌方后排）")
	# 无视遮挡：直射打后排，同列前排有活敌 → 普通直射 −20，穿云箭 0
	var 无遮 := Reach.遮挡命中惩罚(c, 拉, w, 敌后0)
	var 通武: Dictionary = w.duplicate(true)
	通武.erase("无视遮挡")
	通武.erase("ignore_block")
	var 有遮 := Reach.遮挡命中惩罚(c, 拉, 通武, 敌后0)
	t.info("⑧ 遮挡命中惩罚（目标 = 后1，同列前排有活敌）：穿云箭（无视遮挡）= %s；同一发去掉 `无视遮挡` = %s" % [
		J.s(无遮), J.s(有遮)])
	t.ok(无遮 == 0.0 and 有遮 == -20.0,
		"⑧ `无视遮挡` 真的生效：穿云箭 %s、普通直射 %s（−20 被消掉）" % [J.s(无遮), J.s(有遮)])
	var 界 := Reach.武器距离(w)
	t.ok(界.x == 3 and 界.y == 6, "⑧ 穿云箭的距离下限 = %d、上限 = %d（稿子：距离 3–6）" % [界.x, 界.y])

# ==========================================================================================
# ⑨ 幻影凤凰：「贯穿整列」落点对（贴打到的格位与各格伤害）
# ==========================================================================================
func _段9_幻影凤凰贯穿整列(t) -> void:
	# ---- 对照：同一列**只有前排**一台 → 只打到 1 格（拿到主目标的基准伤害）----
	var 单 := _凤凰场(false)
	var 对面 := _凤凰场(true)
	var 单伤 := int(单.get("伤0"))
	var 前伤 := int(对面.get("伤0"))
	var 后伤 := int(对面.get("伤1"))
	t.info("⑨ 对照（同列只有前排）：打到 %s，伤害 %s；有后排时：打到 %s，各格伤害 %s / %s" % [
		str(单.get("位们")), J.s(单伤), str(对面.get("位们")), J.s(前伤), J.s(后伤)])
	t.ok((单.get("位们") as Array).size() == 1,
		"⑨ 对照：同列后排没有敌机 → 只有 1 格挨打（%s）" % str(单.get("位们")))
	t.ok((对面.get("位们") as Array) == ["前1", "后1"],
		"⑨ 「贯穿整列」落点 = 目标所在一整列（前1 + 后1）→ 实际打到 %s" % str(对面.get("位们")))
	t.ok(前伤 == 单伤 and 前伤 > 0,
		"⑨ 主目标伤害与对照**一致**（%s = %s）：贯穿没有改主目标那一下" % [J.s(前伤), J.s(单伤)])
	t.ok(后伤 > 0 and 后伤 < 千,
		"⑨ 贯穿副目标（同列后排）**真的挨了这一发**：%s" % J.s(后伤))
	t.ok(bool(对面.get("别的没挨打")),
		"⑨ **另一列**那台没挨打（贯穿只穿目标所在的那一整列）")
	# 亮起条件：**场上有烟雾**才亮
	var 无雾 := _场([_拉(0.0)], [_靶(0.0)])
	var 有雾 := _场([_拉(0.0)], [_靶(0.0)])
	AtxSmoke.初始化(有雾)
	AtxSmoke.放烟(有雾, 有雾.allies[0], 0, "enemy")
	var 卡 := AtxThree.卡("ATX3_U2")
	t.ok(AtxThree.亮起原因(有雾, 有雾.allies[0], 卡) == "" and AtxThree.亮起原因(无雾, 无雾.allies[0], 卡) != "",
		"⑨ 亮起条件「场上有烟雾」：有雾 = 亮着 / 没雾 = 「%s」" % AtxThree.亮起原因(无雾, 无雾.allies[0], 卡))
	t.ok(J.truthy(对面.get("r", {}).get("成功")),
		"⑨ 打出【幻影凤凰】成功（%s）" % str(对面.get("r", {}).get("原因", "")))

func _凤凰场(带后排: bool) -> Dictionary:
	var 拉 := _拉(0.0)
	拉["战意"] = 100.0
	拉["aim"] = 210.0        # 命中拉满（85 → 100）
	拉["critBase"] = -60.0    # 暴击率归零 → 同一发两遍伤害可比
	var 敌前 := _靶(0.0)
	var 别的 := _靶(1.0)
	var 敌后 := _靶(4.0)
	var 敌们: Array = [敌前, 别的]
	if 带后排:
		敌们 = [敌前, 敌后, 别的]
	var c := _场([拉], 敌们)
	c["turn"] = 2.0
	AtxSmoke.初始化(c)
	AtxSmoke.放烟(c, 拉, 1, "enemy")   # 「场上有烟雾」= 大招的亮起条件（雾放在第 2 列，不压目标）
	var 卡 := AtxThree.卡("ATX3_U2")
	(拉["专属手牌"] as Array).append(卡)
	var 别血 := float(别的.hp)
	var r := Btl.打出精神或公有牌(c, 拉.key, "ATX3_U2", "靶_0")
	var 攻: Array = c.log.filter(func(e): return e is Dictionary and e.get("类型") == "攻击")
	var 位们: Array = []
	var 伤们: Array = []
	for e in 攻:
		var d: Dictionary = e
		var 键 := str(d.get("目标", ""))
		var 单 = J.find(敌们, func(x): return str((x as Dictionary).get("key", "")) == 键)
		if 单 != null:
			位们.append(Fm.位名((单 as Dictionary).get("slot")))
			伤们.append(J.round(float(d.get("伤害", 0.0))))
	return {"位们": 位们, "伤0": 伤们[0] if 伤们.size() > 0 else -1,
		"伤1": 伤们[1] if 伤们.size() > 1 else -1,
		"别的没挨打": float(别的.hp) == 别血, "r": r}

