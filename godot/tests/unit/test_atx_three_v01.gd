func _武(威力: float, 段数: int, 命中率: float = 100.0) -> Dictionary:
	return {"name": "测试武器", "fire": "direct", "dmgType": "物理", "power": 威力, "hit": 命中率,
		"stat": "射击", "hits": float(段数), "cd": 0.0, "upgrades": []}

func _给牌(u: Dictionary, id: String) -> Dictionary:
	var 卡 := AtxThree.卡(id)
	if 卡.is_empty():
		push_error("测试里取不到牌：%s" % id)
		return {}
	卡["入手等级"] = int(卡.get("入手等级", 10))
	(u["专属手牌"] as Array).append(卡)
	return 卡

## 一次攻击记录里第一段的命中率（「详情」的第一段括号里的数）
func _首段命中率(rec: Dictionary) -> int:
	var 字段: Dictionary = rec.get("字段") if rec.get("字段") is Dictionary else {}
	var 详 := str(字段.get("详情", ""))
	var 首 := 详.split("；")[0] if 详 != "" else ""
	var 起 := 首.find("（")
	var 止 := 首.find("%", 起 + 1)
	if 起 < 0 or 止 < 0:
		return -1
	return int(首.substr(起 + 1, 止 - 起 - 1))

func _buff(u: Dictionary, 键: String) -> float:
	var 和 := 0.0
	for b in J.or_(u.get("buffs"), []):
		if b is Dictionary and (b as Dictionary).has(键):
			和 += float(J.num0((b as Dictionary)[键]))
	return 和

func _段威摘要(表: Array) -> String:
	var 数 := {}
	for v in 表:
		var k := str(int(float(v)))
		数[k] = int(数.get(k, 0)) + 1
	var 片: Array = []
	for k in 数.keys():
		片.append("%d × %s" % [int(数[k]), k])
	return "、".join(片)

func _行们(c: Dictionary) -> Array:
	var out: Array = []
	for e in J.or_(c.get("log"), []):
		if e is Dictionary:
			out.append(str((e as Dictionary).get("文本", "")))
	return out

func _有行(c: Dictionary, 子串: String) -> bool:
	for 行 in _行们(c):
		if str(行).contains(子串):
			return true
	return false

func _找行(c: Dictionary, 子串: String) -> String:
	for 行 in _行们(c):
		if str(行).contains(子串):
			return str(行)
	return "（没有这一行）"

## 日志里第一条 `类型 == 类` 的记录（找不到 = 空字典）。§A6c 补齐的几条断言用它读字段。
func _行字段(c: Dictionary, 类: String) -> Dictionary:
	for e in J.or_(c.get("log"), []):
		if e is Dictionary and str((e as Dictionary).get("类型", "")) == 类:
			return e
	return {}

## 日志里**最后一条**攻击记录。
func _末攻(c: Dictionary) -> Dictionary:
	var 末 := {}
	for e in J.or_(c.get("log"), []):
		if e is Dictionary and str((e as Dictionary).get("类型", "")) == "攻击":
			末 = e
	return 末


