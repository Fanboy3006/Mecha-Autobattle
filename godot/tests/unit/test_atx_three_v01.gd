func _段2_逐张数值(t) -> void:
	var 坏: Array = []
	for 期 in 数值表:
		var e: Dictionary = 期
		var 卡 := AtxThree.卡(e["id"])
		if 卡.is_empty():
			坏.append("%s 取不到" % e["id"])
			continue
		var w: Dictionary = 卡.get("武器") if 卡.get("武器") is Dictionary else {}
		var 段 := int(J.num0(w.get("hits"))) if J.truthy(w.get("hits")) else 1
		if str(卡.get("id", "")) == "ATX1_U3":
			段 = 25   # 切札：三连机炮 5 + 方形钢弹 8 + 左轮打桩机·全弹 12
		var 威 := float(J.num0(w.get("power")))
		var 界 := Reach.武器距离(w) if not w.is_empty() else Vector2i(0, 0)
		var 命 := float(J.num0(w.get("hit")))
		var 暴 := float(J.num0(w.get("critMod")))
		var 费 := float(J.num0(卡.get("耗气")))
		var 冷 := float(J.num0(卡.get("冷却")))
		var ok := str(卡.get("卡类", "")) == str(e["类"]) \
			and (int(e["段数"]) == 0 or 段 == int(e["段数"])) \
			and (float(e["威力"]) == 0.0 or absf(威 - float(e["威力"])) < 0.01) \
			and (int(e["距离"][0]) == 0 or (界.x == int(e["距离"][0]) and 界.y == int(e["距离"][1]))) \
			and (float(e["命中"]) == 0.0 or absf(命 - float(e["命中"])) < 0.01) \
			and absf(费 - float(e["费用"])) < 0.01 and absf(冷 - float(e["冷却"])) < 0.01 \
			and (str(e["fire"]) == "" or str(w.get("fire", "")) == str(e["fire"])) \
			and (str(e["dmgType"]) == "" or str(w.get("dmgType", "")) == str(e["dmgType"])) \
			and absf(暴 - float(e["暴击"])) < 0.01
		if not ok:
			坏.append("%s（%s）" % [e["id"], str(e["名"])])
		t.info("② %-9s %-12s %d 段 × %s · 距离 %d–%d · 命中 %s · 费 %s · 冷却 %s%s" % [
			e["id"], str(e["名"]), 段, J.s(威), 界.x, 界.y, J.s(命), J.s(费), J.s(冷),
			(" · 暴击 +" + J.s(暴)) if 暴 != 0.0 else ""])
	t.ok(坏.is_empty(), "② 21 张（每人的 4 把主武器 + 3 张大招）的段数 / 威力 / 距离 / 命中 / 费用 / 冷却**逐张对稿**%s"
		% ("" if 坏.is_empty() else "；不符：" + str(坏)))
	# 几个「稿子单独给了数字」的：每场次数 / 散布 / 无视遮挡 / 命中加成
	t.ok(int(J.num0(AtxThree.卡("ATX2_W3").get("每场次数"))) == 3,
		"② 分裂导弹「每场 3 次」→ `每场次数 = %s`" % str(AtxThree.卡("ATX2_W3").get("每场次数")))
	t.ok(J.truthy(AtxThree.卡("ATX1_W2").get("武器", {}).get("散布"))
		and J.truthy(AtxThree.卡("ATX2_W3").get("武器", {}).get("散布"))
		and J.truthy(AtxThree.卡("ATX3_W2").get("武器", {}).get("散布")),
		"② 三把「散布」武器（方形钢弹 / 分裂导弹 / 幻影弓·箭雨）都带 `散布`")
	t.ok(J.truthy(AtxThree.卡("ATX3_W4").get("武器", {}).get("无视遮挡"))
		and J.truthy(AtxThree.卡("ATX3_U2").get("武器", {}).get("无视遮挡"))
		and J.truthy(AtxThree.卡("ATX3_U3").get("武器", {}).get("无视遮挡")),
		"② 穿云箭 / 幻影凤凰 / Code：ATA 都带 `无视遮挡`")
	# 稿子 §4.1 / §3.1 的说明文字里「段数 = 箭数」也要对得上
	t.ok(str(AtxThree.卡("ATX3_W1").get("效果说明", "")).contains("650 × 3 箭")
		and str(AtxThree.卡("ATX3_U2").get("效果说明", "")).contains("箭 2400 × 1 段 + 凤凰 500 × 4 段"),
		"② 拉米亚的【弓】牌说明与数值一致（650 × 3 箭 / 箭 2400 + 凤凰 500 × 4）")

# ==========================================================================================
# ③ `is_weapon` 口径：赌神·入局 与 好运加护·满开 为 false，其余大招 true（逐张）
# ==========================================================================================
func _段3_大招是武器牌吗(t) -> void:
	var 非武器 := ["U_ATX_2", "ATX2_U3"]
	var 大招id: Array = []
	for k in ["A1", "A2", "A3"]:
		for c in AtxThree.大招卡们(k):
			大招id.append(str((c as Dictionary).get("id", "")))
	t.ok(大招id.size() == 9, "③ 三人的大招槽一共 **9 张**（%s）" % str(大招id))
	for id in 大招id:
		var 卡 := AtxThree.卡(id)
		var 期 := not 非武器.has(str(id))
		t.ok(卡.get("is_weapon") == 期 and J.truthy(卡.get("武器牌")) == 期,
			"③ %-9s %-16s is_weapon = %s（%s）" % [str(id), str(卡.get("名", "")), str(卡.get("is_weapon")),
				"算武器牌、销毁本回合其余武器" if 期 else "**不算武器牌、不销毁武器**"])
	t.ok(str(AtxThree.卡("ATX2_U3").get("武器牌")) == "false" or AtxThree.卡("ATX2_U3").get("武器牌") == false,
		"③ 【好运加护·满开】`武器牌 = false`（`DeckFlow.打出大招` 不会置 `主武器已销毁`）")
	# 实际打一张：满开打完，她的 `主武器已销毁` 仍为 false
	var 艾 := _艾(4.0)
	var 队2 := _友(0.0, "A1")
	var 靶 := _靶(0.0)
	var c := _场([艾, 队2], [靶])
	艾["战意"] = 100.0
	c["turn"] = 3.0
	_给牌(艾, "ATX2_U3")
	var r := Btl.打出精神或公有牌(c, 艾.key, "ATX2_U3")
	t.ok(J.truthy(r.get("成功")) and 艾.get("主武器已销毁") == false,
		"③ 满开真的打出去（%s）：`主武器已销毁` = %s（不算武器牌）" % [str(r.get("原因", "成功")), str(艾.get("主武器已销毁"))])

