	a2["战意"] = 100.0
	c["强运必触发"] = true                        # 让【强运】硬币必为正 → 分支确定性生效
	_给牌(a2, "ATX2_U3")
	var r := Btl.打出精神或公有牌(c, a2.key, "ATX2_U3")
	t.ok(r.get("成功") == true, "⑯ 打出【好运加护·满开】成功（%s）" % str(r.get("原因", "")))
	# ① 基础效果：ATX 全体（含她自己）暴击**倍率** +1、每段命中 −20
	t.ok(J.round(_buff(a1, "critX")) == 1 and J.round(_buff(a2, "critX")) == 1,
		"⑯ ATX 全体暴击**倍率** +1（critX：A1 %s / A2 %s）" % [
			J.s(_buff(a1, "critX")), J.s(_buff(a2, "critX"))])
	t.ok(J.round(_buff(a1, "hit")) == -20 and J.round(_buff(a2, "hit")) == -20,
		"⑯ ATX 全体每段命中 −20（hit：A1 %s / A2 %s）" % [
			J.s(_buff(a1, "hit")), J.s(_buff(a2, "hit"))])
	# ② 强运分支「再加暴击 +20」—— 必须**与基础效果并存**（同源名不能互相冲掉）
	t.ok(J.round(_buff(a1, "crit")) == 20 and J.round(_buff(a2, "crit")) == 20
		and J.round(_buff(a2, "critX")) == 1,
		"⑯ 强运：ATX 全体再 +20 暴击率（crit：A1 %s / A2 %s），且**没有把 critX +1 冲掉**（A2 critX 仍 %s）" % [
			J.s(_buff(a1, "crit")), J.s(_buff(a2, "crit")), J.s(_buff(a2, "critX"))])
	t.ok(a2.get("主武器已销毁") == false, "⑯ `is_weapon = false` → 打完 `主武器已销毁` 仍是 false（不抢武器语义）")
	# ③ 代价：本回合她打主武器 → 明确原因
	a2["主武器已销毁"] = false
	_给牌(a2, "ATX2_W1")
	var r2 := Btl.打出精神或公有牌(c, a2.key, "ATX2_W1")
	t.ok(r2.get("成功") == false and str(r2.get("原因", "")).contains("满开"),
		"⑯ ★ 代价真的拦住主武器：打【嚎叫发射器·光束】→ 失败，原因 =「%s」" % str(r2.get("原因", "")))
	# ④ 下个我方阶段恢复
	c["turn"] = 4.0
	AtxThree.阶段初(c)
	a2["主武器已销毁"] = false
	_给牌(a2, "ATX2_W1")
	var r3 := Btl.打出精神或公有牌(c, a2.key, "ATX2_W1")
	t.ok(r3.get("成功") == true, "⑯ 换到我方下一个回合 → 主武器又能打了（成功 = %s）" % str(r3.get("成功")))

