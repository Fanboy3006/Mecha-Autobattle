# ⑪ 切札：25 段合成一次攻击，每段 60%；某段打不到则跳过（贴实际段数与总伤）
# ==========================================================================================
func _段11_切札25段(t) -> void:
	# ---- A：目标在距离 1 → 三段全打得到 = 25 段 ----
	var 全 := _切札场(0.0)
	var 全攻: Dictionary = 全.get("攻")
	t.info("⑪ 目标在距离 %d：段数 %d，总伤 %s（每段 = 各自武器每段威力 × 60%%）" % [
		int(全.get("距")), int(全攻.get("段数", 0)), J.s(全攻.get("伤害"))])
	t.ok(int(全攻.get("段数", 0)) == 25,
		"⑪ 切札 = 三连机炮 5 + 方形钢弹 8 + 左轮打桩机·全弹 12 = **25 段合成一次攻击**（实际 %d 段）" % int(全攻.get("段数", 0)))
	var 段威: Array = 全.get("段威力")
	var 望: Array = []
	for _i in 5:
		望.append(180.0)     # 300 × 60%
	for _i in 8:
		望.append(150.0)     # 250 × 60%
	for _i in 12:
		望.append(300.0)     # 500 × 60%
	t.ok(段威 == 望, "⑪ 每段 60%%：%s（5 × 180 / 8 × 150 / 12 × 300）" % _段威摘要(段威))
	# 总伤 = 三档每段伤害各乘段数（每档的「单段伤害」由同一发裸武器现场量出，避开无关的排位 / 职业加成）
	var 单180 := _单段伤(180.0)
	var 单150 := _单段伤(150.0)
	var 单300 := _单段伤(300.0)
	var 望总 := 5 * 单180 + 8 * 单150 + 12 * 单300
	t.info("⑪ 单段伤害（同一发裸近战量出）：180 → %s / 150 → %s / 300 → %s；期望总伤 %s" % [
		J.s(单180), J.s(单150), J.s(单300), J.s(望总)])
	t.ok(int(全攻.get("伤害", 0)) == 望总,
		"⑪ 25 段总伤 = **%s** = 180×5 + 150×8 + 300×12（逐段结算）" % J.s(全攻.get("伤害")))
	var 攻条: Array = (全.get("c") as Dictionary).log.filter(func(e): return e is Dictionary and e.get("类型") == "攻击")
	t.ok(攻条.size() == 1, "⑪ **R5：25 段合成一次攻击 = 一条记录**（攻击记录 %d 条）" % 攻条.size())
	# ---- B：目标在距离 3 → 三连机炮打得到、方形钢弹与左轮打桩机·全弹打不到 → 只剩 5 段 ----
	var 半 := _切札场(2.0)
	var 半攻: Dictionary = 半.get("攻")
	t.info("⑪ 目标在距离 %d：段数 %d，总伤 %s；跳过 %s" % [
		int(半.get("距")), int(半攻.get("段数", 0)), J.s(半攻.get("伤害")), str(半攻.get("跳过的武器"))])
	t.ok(int(半攻.get("段数", 0)) == 5,
		"⑪ **打不到的那一下跳过**：距离 3 只有三连机炮打得到 → 实际 %d 段（跳过了 %s）" % [
			int(半攻.get("段数", 0)), str(半攻.get("跳过的武器"))])
	t.ok(int(半攻.get("伤害", 0)) == 5 * 单180,
		"⑪ 5 段 × %s = **%s**" % [J.s(单180), J.s(半攻.get("伤害"))])

## 同一把裸近战武器打一发，量出「每段威力 = 威力」时的单段真实伤害
## （用它做分解基准，测试不依赖兰斯战线 / 职业排位这些无关参数）。
func _单段伤(威力: float) -> int:
	var 响 := _友(0.0, "A1")
	响["aim"] = 210.0
	响["critBase"] = -60.0
	var 敌 := _靶(0.0)
	var c := _场([响], [敌])
	c["turn"] = 3.0
	var w := {"name": "参照", "fire": "melee", "dmgType": "物理", "power": 威力, "hit": 75.0, "stat": "格斗"}
	var rec := Calc.resolveAttack(响, 敌, w, c, {})
	var 字段: Dictionary = rec.get("字段") if rec.get("字段") is Dictionary else {}
	return int(J.round(float(字段.get("伤害", 0.0))))

func _切札场(目标位: float) -> Dictionary:
	var 响 := _友(0.0, "A1")
	响["name"] = "响介"
	响["战意"] = 100.0
	响["aim"] = 210.0        # 命中拉满（75 → 100），伤害可精确对账
	响["critBase"] = -60.0    # 暴击率归零，伤害可精确对账
	var 敌 := _靶(目标位)
	var c := _场([响], [敌])
	c["turn"] = 3.0
	_给牌(响, "ATX1_U3")
	var r := Btl.打出精神或公有牌(c, 响.key, "ATX1_U3", str(敌.get("key")))
	var 攻: Dictionary = {}
	for e in c.log:
		if e is Dictionary and e.get("类型") == "攻击":
			攻 = e
	var 段威: Array = []
	if 攻.get("切札") != null:
		var 牌 := AtxThree.卡("ATX1_U3")
		段威 = _切札段威力(目标位)
	return {"c": c, "攻": 攻, "距": Fm.真实距离(0.0, 目标位), "段威力": 段威, "r": r}

## 单测里复算一遍「这一次切札实际会打几段、每段多少」的期望表（与 `AtxThree._切札` 同一份数值来源）。
func _切札段威力(目标位: float) -> Array:
	var 出: Array = []
	var 距 := Fm.真实距离(0.0, 目标位)
	if 距 >= 1 and 距 <= 3:
		for _i in 5:
			出.append(180.0)
	if 距 >= 1 and 距 <= 2:
		for _i in 8:
			出.append(150.0)
		for _i in 12:
			出.append(300.0)
	return 出

