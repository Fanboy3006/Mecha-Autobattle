func _整场脚本(种子: int) -> Dictionary:
	var 响 := _友(0.0, "A1")
	响["name"] = "响介"
	响["战意"] = 100.0
	var 艾 := _艾(4.0)
	艾["战意"] = 100.0
	var 拉 := _拉(2.0)
	拉["战意"] = 100.0
	var 敌 := [_靶(0.0), _靶(4.0)]
	var c := _场([响, 艾, 拉], 敌, 种子)
	c["turn"] = 3.0
	AtxSmoke.初始化(c)
	AtxSmoke.放烟(c, 拉, 0, "enemy")
	var 文: Array = []
	_给牌(拉, "ATX3_S8")
	文.append(str(Btl.打出精神或公有牌(c, 拉.key, "ATX3_S8", 响.key)))
	_给牌(拉, "ATX3_U2")
	文.append(str(Btl.打出精神或公有牌(c, 拉.key, "ATX3_U2", "靶_0")))
	_给牌(艾, "ATX2_U2")
	文.append(str(Btl.打出精神或公有牌(c, 艾.key, "ATX2_U2", "靶_0")))
	var 近 := _武(700.0, 6, 70.0)
	近["fire"] = "melee"
	近["stat"] = "格斗"
	var r1 := Calc.resolveAttack(响, 敌[0], 近, c, {})
	文.append(str(r1.get("文本")))
	文.append(str(r1.get("字段")))
	文.append(str(AtxThree.本场计数(c)))
	return {"文": "|".join(文), "日志": "\n".join(_行们(c)),
		"rng": int((c.get("rng") as Mulberry32).steps), "行数": _行们(c).size()}

