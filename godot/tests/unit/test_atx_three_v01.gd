## ★ A6c（响介 / 艾克赛琳 / 拉米亚 v0.1 三人卡表）—— 内核验收。
##
## 权威依据（数值一个都不许改）：
##   · `协作/设计/响介卡牌设计 v0.1.md`    §3 / §4 / §5 / §6 / §7
##   · `协作/设计/艾克赛琳卡牌设计 v0.1.md` §1 / §2 / §3 / §4 / §5
##   · `协作/设计/拉米亚卡牌设计 v0.1.md`   §2 / §3 / §4 / §5 / §6
##
## 受控单位（不走 `Setup.开局` 的那些段直接造裸字典）：攻击方 `aim = 160`、目标 `eva = 0`
##   → 命中率 = `w.hit`，所以「+10 / +30 / −20」这类修正可以贴两个精确百分比。
## 本文件跑完会把 `Db.T.战斗结构.单机牌组.开` 还原成进来时的值（后面的测试仍走改前口径）。
extends RefCounted

const 千 := 999999.0

func run(t) -> void:
	var errors := []
	t.ok(DataLoader.install(errors), "数据装入 Db%s" % ("" if errors.is_empty() else "：" + str(errors)))
	_段1_张数对账(t)
	_段2_逐张数值(t)
	_段3_大招是武器牌吗(t)
	_段4_获取档与开局牌池(t)
	_段5_响介正面突破(t)
	_段6_艾克赛琳天然(t)
	_段7_拉米亚弓与满弦(t)
	_段8_穿云箭无视遮挡与距离下限(t)
	_段9_幻影凤凰贯穿整列(t)
	_段10_CodeATA(t)
	_段11_切札25段(t)
	_段12_全开嚎叫发射器(t)
	_段13_W17中继与断路器3(t)
	_段15_同种子两遍(t)
	_段16_满开代价(t)
	_段17_抗光束(t)
	_段18_再来一把(t)
	_段19_跟上(t)
	_段20_强运必触发(t)

