# ① 张数对账：响介 4+0+3+10=17 / 艾克赛琳 4+1+3+9=17 / 拉米亚 4+1+3+10=18；`+` 版另计
# ==========================================================================================
func _段1_张数对账(t) -> void:
	var 数 := AtxThree.按角色张数()
	var 期 := {
		"A1": {"主武器": 4, "副武器": 0, "大招": 3, "精神": 10, "合计": 17},
		"A2": {"主武器": 4, "副武器": 1, "大招": 3, "精神": 9, "合计": 17},
		"A3": {"主武器": 4, "副武器": 1, "大招": 3, "精神": 10, "合计": 18},
	}
	for k in ["A1", "A2", "A3"]:
		var 实: Dictionary = 数.get(k, {})
		var 望: Dictionary = 期[k]
		t.ok(int(实.get("主武器", -1)) == int(望["主武器"]) and int(实.get("副武器", -1)) == int(望["副武器"])
			and int(实.get("大招", -1)) == int(望["大招"]) and int(实.get("精神", -1)) == int(望["精神"])
			and int(实.get("合计", -1)) == int(望["合计"]),
			"① %s：主武器 %d + 副武器 %d + 大招 %d + 精神 %d = **%d 张**（实际 %d / %d / %d / %d = %d）" % [
				k, int(望["主武器"]), int(望["副武器"]), int(望["大招"]), int(望["精神"]), int(望["合计"]),
				int(实.get("主武器", -1)), int(实.get("副武器", -1)), int(实.get("大招", -1)),
				int(实.get("精神", -1)), int(实.get("合计", -1))])
	# 52 张全部能按 id 取到，且 id 不重复
	var 全 := AtxThree.卡表()
	var 见 := {}
	var 重 := []
	var 取不到 := []
	for c in 全:
		var id := str((c as Dictionary).get("id", ""))
		if 见.has(id):
			重.append(id)
		见[id] = true
		if AtxThree.卡(id).is_empty():
			取不到.append(id)
	t.ok(全.size() == 52 and 重.is_empty() and 取不到.is_empty(),
		"① 卡表 **52 张**（17 + 17 + 18），id 不重复、逐张都能按 id 取到（%d 张；重 %s；取不到 %s）" % [
			全.size(), str(重), str(取不到)])
	t.ok(AtxThree.升版卡表().size() == 24 and AtxThree.角色牌们加版("A1").size() == 7
		and AtxThree.角色牌们加版("A2").size() == 8 and AtxThree.角色牌们加版("A3").size() == 9,
		"① `+` 版 **24 张**（响介 7 / 艾克赛琳 8 / 拉米亚 9，另计）；卡表张数 = %s" % str(AtxThree.卡表张数()))
	# 三张改写牌真的装进了对应角色的精神牌池（满弦 / 连珠箭 → 拉米亚；再加一注 → 响介）
	t.ok(AtxThree.有("ATX_RW_MANXIAN") and str(AtxThree.卡("ATX_RW_MANXIAN").get("角色")) == "A3"
		and AtxThree.有("ATX_RW_LIANZHU") and str(AtxThree.卡("ATX_RW_LIANZHU").get("角色")) == "A3"
		and AtxThree.有("ATX_RW_JIAYIZHU") and str(AtxThree.卡("ATX_RW_JIAYIZHU").get("角色")) == "A1",
		"① 三张改写牌都在对应角色的精神牌池里（满弦/连珠箭 → A3；再加一注 → A1）")
	# 旧的 A1–A6b 卡表一个字没动
	t.ok(FacAtx.卡表().size() == 33 and AtxDuo.卡表().size() == 14,
		"① A1–A6b 的旧卡表没动：FacAtx %d 张 / AtxDuo %d 张" % [FacAtx.卡表().size(), AtxDuo.卡表().size()])

