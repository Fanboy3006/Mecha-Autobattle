# ⑦ 拉米亚【弓】：满弦只作用于带弓的牌（幻影弓·连射 生效、幻影剑 不生效且不消耗槽）
# ==========================================================================================
func _段7_拉米亚弓与满弦(t) -> void:
	var 拉 := _拉(0.0)
	var c := _场([拉], [_靶(0.0)])
	t.ok(J.truthy(AtxThree.卡("ATX3_W1").get("弓")) and J.truthy(AtxThree.卡("ATX3_W2").get("弓"))
		and J.truthy(AtxThree.卡("ATX3_W4").get("弓")) and not J.truthy(AtxThree.卡("ATX3_W3").get("弓")),
		"⑦ 4 把主武器里 **3 把带【弓】**（连射 / 箭雨 / 穿云箭），**幻影剑不带**")
	var 弓武: Dictionary = AtxThree.卡("ATX3_W1").get("武器")
	var 剑武: Dictionary = AtxThree.卡("ATX3_W3").get("武器")
	t.ok(AtxRewrite.是弓牌(弓武) and not AtxRewrite.是弓牌(剑武),
		"⑦ `AtxRewrite.是弓牌`：幻影弓·连射 = %s / 幻影剑 = %s" % [
			str(AtxRewrite.是弓牌(弓武)), str(AtxRewrite.是弓牌(剑武))])
	# 满弦 → 下一张【弓】武器牌：3 段 × 650 → 1 段 × (3 × 650 × 1.2 = 2340)、命中 +15
	AtxRewrite.设(拉, AtxRewrite.满弦, c, "ATX_RW_MANXIAN")
	t.ok(not AtxRewrite.槽(拉).is_empty(), "⑦ 打出「满弦」→ 槽里挂上了：%s" % AtxRewrite.槽文字(拉))
	var r弓 := AtxRewrite.应用(c, 拉, 弓武)
	t.ok(J.truthy(r弓.get("生效")) and int(r弓.get("前段数")) == 3 and int(r弓.get("后段数")) == 1
		and absf(float(r弓.get("后威力")) - 2340.0) < 0.01 and absf(float(r弓.get("武器", {}).get("hit")) - 100.0) < 0.01,
		"⑦ 幻影弓·连射 **生效**：%d 段 × %s → %d 段 × %s（命中 85 → %s）" % [
			int(r弓.get("前段数")), J.s(r弓.get("前威力")), int(r弓.get("后段数")), J.s(r弓.get("后威力")),
			J.s(r弓.get("武器", {}).get("hit"))])
	t.ok(AtxRewrite.槽(拉).is_empty(), "⑦ 满弦**用完即清**（槽已空）")
	# 幻影剑：不匹配 → 不生效、槽**不被消耗**
	AtxRewrite.设(拉, AtxRewrite.满弦, c, "ATX_RW_MANXIAN")
	var r剑 := AtxRewrite.应用(c, 拉, 剑武)
	t.ok(not J.truthy(r剑.get("生效")) and int(AtxRewrite.段数Of(r剑.get("武器"))) == 5,
		"⑦ 幻影剑（不带【弓】）**不生效**：仍是 %d 段 × %s" % [
			int(AtxRewrite.段数Of(r剑.get("武器"))), J.s(r剑.get("武器", {}).get("power"))])
	t.ok(not AtxRewrite.槽(拉).is_empty(), "⑦ **不消耗槽**：槽里还挂着「%s」" % AtxRewrite.槽文字(拉))

