	var 期 := {
		"A1": ["三连机炮", "方形钢弹", "左轮打桩机", "左轮打桩机·全弹",
			"「胜算低的赌局，我可不讨厌」", "孤注一掷", "硬接", "全速突击"],
		"A2": ["嚎叫发射器·光束", "嚎叫发射器·实弹", "分裂导弹", "援护射击", "分裂导弹·齐射",
			"好运加护", "眨眼", "「啊啦，打不中哦~」", "白骑士·高空回避"],
		"A3": ["幻影弓·连射", "幻影弓·箭雨", "幻影剑", "幻影剑·星痕",
			"「目标，确认了的说」", "解析完毕", "满弦", "烟幕扩散"],
	}
	for k in ["A1", "A2", "A3"]:
		var 池 := AtxThree.开局牌库(k, 10, c, true)
		var 名们: Array = []
		var 全初始 := true
		for x in 池:
			var d: Dictionary = x
			名们.append(str(d.get("名", "")))
			if str(d.get("获取", "")) != "初始":
				全初始 = false
		var 望: Array = 期[k]
		t.ok(全初始 and 名们.size() == 望.size() and 名们 == 望,
			"④ %s 肉鸽开局（Lv10）发 **%d 张**「初始」：%s" % [k, 名们.size(), "、".join(名们)])
	# 「剧情」「肉鸽」不进开局牌池
	var 全名: Array = []
	for x in AtxThree.开局牌库("A1", 30, c, true):
		全名.append(str((x as Dictionary).get("名", "")))
	t.ok(not 全名.has("热能角") and not 全名.has("切札") and not 全名.has("俄罗斯轮盘")
		and not 全名.has("押上全部") and not 全名.has("再加一注"),
		"④ 响介 Lv30 的**肉鸽开局**里仍然没有「剧情 / 肉鸽」档的牌（热能角 / 切札 / 俄罗斯轮盘 / 押上全部 / 再加一注）")
	# 剧情模式（肉鸽 == false）按等级放开：剧情 Lv20 / 肉鸽 Lv30
	t.ok(AtxThree.开局牌库("A1", 10, c, false).size() == 8
		and AtxThree.开局牌库("A1", 20, c, false).size() > 8
		and AtxThree.开局牌库("A1", 30, c, false).size() > AtxThree.开局牌库("A1", 20, c, false).size(),
		"④ 剧情模式按等级放开：Lv10 = %d / Lv20 = %d / Lv30 = %d 张" % [
			AtxThree.开局牌库("A1", 10, c, false).size(),
			AtxThree.开局牌库("A1", 20, c, false).size(),
			AtxThree.开局牌库("A1", 30, c, false).size()])
	# 装填：主开关开着就装（闸门 G2：二级子开关 `ATXv01` 已退役，不再有「跟随 / 强制关」两态）
	var 装 := _场([_友(0.0, "A1"), _友(1.0, "A2"), _拉(2.0)], [_靶(0.0)])
	var 加 := AtxThree.装填单位(装.allies[0], 10, 装)
	t.ok(加.size() == 8 and J.every(加, func(x): return str(x.get("获取", "")) == "初始"),
		"④ `装填单位(A1, Lv10)` 装进牌库 **%d 张**（全部「初始」）" % 加.size())
	var 拉 = 装.allies[2]
	var 拉加 := AtxThree.装填单位(拉, 10, 装)
	t.ok(拉加.size() == 8, "④ `装填单位(A3, Lv10)` 装进牌库 %d 张（副武器烟雾弹复用 A5a 的 U_ATX_8，不重复装）" % 拉加.size())

