## 设槽并返回这个单位（链式写法用）
func _设槽(u: Dictionary, 类型: String, ctx: Dictionary) -> Dictionary:
	AtxRewrite.设(u, 类型, ctx)
	return u

## 打一发「散布」武器（`攻` 不传 = 我方弓手；`主` 不传 = ctx.enemies[0]）
func _打散布(c: Dictionary, 段数: int, 攻: Variant = null, 主: Variant = null) -> Dictionary:
	var a: Dictionary = 攻 if (攻 is Dictionary) else c.allies[0]
	var t: Dictionary = 主 if (主 is Dictionary) else c.enemies[0]
	return Calc.resolveAttack(a, t, _散布武(250.0, 段数, 100.0), c, {})

func _弓手(位: float, side: String = "ally") -> Dictionary:
	var d := _单位("弓手", side, 位, 0.0)
	d["name"] = "弓手"
	return d

func _响介(位: float) -> Dictionary:
	var d := _单位("A1", "ally", 位, 0.0)
	d["name"] = "响介"
	d["trait"] = "gambler"
	return d

func _靶(位: float, side: String = "enemy") -> Dictionary:
	var d := _单位("靶_%d_%s" % [int(位), side], side, 位, 0.0)
	d["name"] = "靶机%s" % str(int(位) + 1)
	return d

func _甲单位(位: float = 0.0, 甲: float = 0.0) -> Dictionary:
	var d := _单位("甲_%s" % J.s(甲), "enemy", 位, 甲)
	d["name"] = "靶机"
	return d

func _单位(键: String, side: String, 位: float, 甲值: float) -> Dictionary:
	return {
		"key": 键, "name": 键, "tplKey": 键, "side": side, "slot": 位, "lv": 10.0,
		"maxHp": 千, "hp": 千,
		"melee": 0.0, "shoot": 0.0, "awaken": 0.0, "defense": 0.0,
		"armor": 甲值, "armorCut": 0.0, "eva": 0.0, "aim": 160.0,
		"critBase": -10.0, "critMod": 0.0, "mov": 5.0,
		"buffs": [], "debuffs": [], "abilities": [],
		"shield": 0.0, "shieldHp": 0.0, "barrierLeft": 0.0,
		"tags": {}, "weapons": [],
	}

## 普通武器（`fire = map` 时**必中**；`direct` 才吃命中率）
func _武(威力: float, 段数: int, 命中率: float = 100.0, fire: String = "direct") -> Dictionary:
	return {"name": "测试武器", "fire": fire, "dmgType": "物理", "power": 威力, "hit": 命中率,
		"stat": "射击", "hits": float(段数), "cd": 0.0, "upgrades": []}

## 【弓】武器（`650 × 3 箭` 那种）。标签 = `w.标签 = ["弓"]`。
func _弓(威力: float, 段数: int, 命中率: float) -> Dictionary:
	var w := _武(威力, 段数, 命中率, "direct")
	w["name"] = "幻影弓·连射"
	w["标签"] = ["弓"]
	w["dmgType"] = "光束"
	return w

## 带 `散布` 的武器（`250 × 8 段` 那种）
func _散布武(威力: float, 段数: int, 命中率: float = 100.0) -> Dictionary:
	var w := _武(威力, 段数, 命中率, "direct")
	w["name"] = "方形钢弹"
	w["散布"] = true
	return w

func _场(我方: Array, 敌方: Array, 种子: int = 20261017) -> Dictionary:
	return {
		"turn": 1.0, "种子": float(种子), "rng": Mulberry32.new(种子),
		"allies": 我方, "enemies": 敌方, "log": [], "_rng_at": [],
		"当前战术": null, "气势": 0.0,
	}

func _数字段(r: Dictionary, 键: String) -> Variant:
	var f = r.get("字段")
	return (f as Dictionary).get(键) if f is Dictionary else null

func _行们(c: Dictionary) -> Array:
	var out: Array = []
	for e in J.or_(c.get("log"), []):
		if e is Dictionary:
			out.append(str((e as Dictionary).get("文本", "")))
	return out

func _行数(c: Dictionary, 子串: String) -> int:
	if 子串 == "":
		return _行们(c).size()
	var n := 0
	for 行 in _行们(c):
		if str(行).contains(子串):
			n += 1
	return n

func _有行(c: Dictionary, 子串: String) -> bool:
	return _行数(c, 子串) > 0

func _找行(c: Dictionary, 子串: String) -> String:
	for 行 in _行们(c):
		if str(行).contains(子串):
			return str(行)
	return "（没有这一行）"

## ⑪ ④ 找一个「第 1–3 段打空、第 4–12 段全中」的种子（抽数顺序与 `_单体结算` 逐字一致）
func _找种子() -> int:
	for s in range(1, 200001):
		var r := Mulberry32.new(s)
		var 好 := true
		for i in 12:
			var 中 := r.next_float() * 100.0 < 50.0
			if i < 3:
				if 中:
					好 = false
					break
			else:
				if not 中:
					好 = false
					break
				r.next_float()
		if 好:
			return s
	return 0

## ⑪ ⑥ 一击 12 段、atk = D = 0、甲 600：物理 / 无视防御 / 特殊 三种口径共用
func _打一次池(组: Array) -> int:
	var a := _单位("攻", "ally", 4.0, 0.0)
	var d := _单位("守", "enemy", 0.0, 600.0)
	var 额: Dictionary = (组[1] as Dictionary).duplicate()
	额["dmgType"] = str(组[2])
	var w := _武(500.0, 12, 100.0, "map")
	for k in 额.keys():
		w[k] = 额[k]
	return int(_数字段(Calc.resolveAttack(a, d, w, _场([a], [d]), {}), "伤害"))
