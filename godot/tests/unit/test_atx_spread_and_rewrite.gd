## 一整段脚本（⑭ 用）：满弦 → 打一发 → 再加一注 → 打一发散布
func _整场脚本() -> Dictionary:
	var 甲 := _弓手(0.0)
	var 主 := _靶(0.0)
	主["armor"] = 600.0
	var 副 := _靶(1.0)
	副["armor"] = 300.0
	var c := _场([甲], [主, 副], 散布种子)
	AtxRewrite.设(甲, AtxRewrite.满弦, c)
	var r1 := Calc.resolveAttack(甲, 主, AtxRewrite.应用(c, 甲, _弓(650.0, 3, 100.0))["武器"], c, {})
	AtxRewrite.设(甲, AtxRewrite.再加一注, c)
	var r2 := Calc.resolveAttack(甲, 主, AtxRewrite.应用(c, 甲, _散布武(250.0, 5, 100.0))["武器"], c, {})
	return {
		"文": str(r1.get("文本")) + "|" + str(r1.get("字段")) + "|" + str(r2.get("文本")) + "|" + str(r2.get("字段")),
		"日志": "\n".join(_行们(c)),
		"rng": int((c.get("rng") as Mulberry32).steps),
	}

