# ⑫ 闪开不被污染：散布攻击里主目标闪开、副目标不闪开 → 各判各的
# ==========================================================================================
func _段12_闪开不被污染(t) -> void:
	var 主 := _靶(0.0, "ally")
	主["name"] = "主坦"
	主["tags"] = {"势力": "ATX"}
	主["abilities"] = ["gamblerSense"]
	主["weapons"] = [{"t": {"name": "减冷却武", "evadeCd": true, "unlock": 1.0}, "cd": 0.0, "uses": null}]
	主["eva"] = 100.0          # 命中率 100 − 100 = 0 → 打向它的段全空
	var 副 := _靶(1.0, "ally")
	副["name"] = "副手"
	副["tags"] = {"势力": "ATX"}
	副["eva"] = 0.0            # 命中率 100 → 打向它的段全中
	var 敌 := _弓手(0.0, "enemy")
	var c := _场([主, 副], [敌], 散布种子)
	var r := _打散布(c, 8, 敌, 主)
	var 池 = _数字段(r, "散布池")
	var 偏移 := int(_数字段(r, "散布偏移段数"))
	t.ok(池 is Array and (池 as Array).size() == 2,
		"⑫ 两个被打目标各自一个池（%s 个）" % str((池 as Array).size() if 池 is Array else -1))
	t.ok(偏移 == 5 and int(_数字段(r, "命中段数")) == 5 and int(_数字段(r, "打空段数")) == 3,
		"⑫ 8 段散布：偏移 %d 段 → 命中 %d / 打空 %d（按**实际落点**记）" % [
			偏移, int(_数字段(r, "命中段数")), int(_数字段(r, "打空段数"))])
	t.ok(主.get("闪") == true, "⑫ 主目标（打向它的 3 段全空 → 打空 3 ≥ 命中 0）→ `闪` = %s" % str(主.get("闪")))
	t.ok(副.get("闪") != true, "⑫ 副目标（打向它的 5 段全中 → 命中 5 > 打空 0）→ **不闪**（`闪` = %s）" % str(副.get("闪")))
	t.ok(_有行(c, "〔九死一生〕主坦 闪开（打空 3 ≥ 命中 0）")
		and not _有行(c, "〔九死一生〕副手"),
		"⑫ 闪开判定按被打的那个目标各自算：主目标一行 →「%s」；副目标**没有**那一行" % _找行(c, "〔九死一生〕"))
	t.ok(FacCb.ATX打空(主) == 3.0,
		"⑫ ATX 的 `状.打空` 也按实际打空段记 = **%s**（3 段打空，不是 8）" % J.s(FacCb.ATX打空(主)))
	t.ok(str(_数字段(r, "详情")).contains("〈主坦〉第 1 段（0%）未中")
		and str(_数字段(r, "详情")).contains("〈副手〉第 1 段（100%）250"),
		"⑫ 逐段详情按落点分开：`〈主坦〉…未中` / `〈副手〉…250`")

