## ★ A5b（拉米亚 v0.1 / 响介 v0.1）：武器「**段数改写**」层 +「**散布**」（每段随机换目标）—— 内核验收。
##
## 权威依据：`协作/设计/拉米亚卡牌设计 v0.1.md` §3.1（幻影弓·连射 650×3 / 幻影弓·箭雨 散布）/ §5（满弦 / 连珠箭）
##          · `协作/设计/响介卡牌设计 v0.1.md` §6（加码 → **再加一注**）/ §4.1（方形钢弹 散布）
##          · `协作/架构/任务单-ATX-v0.3与卡牌新机制-ARGON.md` §4 的 A5b 行
##
## 受控单位（不走 `Setup.开局`，直接造裸字典）：`atk == D == 0` ⇒ `coef == 1`、`armor` 手填、
##   `eva = 0` ⇒ 命中率 = `w.hit`、`critBase = -10` ⇒ 暴击率 0（伤害全是干净整数，可逐段断言）。
##   **【弓】标签的口径 = `w.标签` / `w.tags` 里有 `"弓"`**（数据里还没有拉米亚的弓，测试里手搭，**不改 `data/js`**）。
## 本文件跑完会把 `Db.T.战斗结构.单机牌组.开` 还原成进来时的值（后面的测试仍走改前口径）。
extends RefCounted

const 千 := 999999.0
## ⑧ / ⑩ 用的固定种子：8 段散布的**前 8 次抽数**决定落点（主 3 段 / 副 5 段 → 偏移 5）
const 散布种子 := 5

func run(t) -> void:
	var errors := []
	t.ok(DataLoader.install(errors), "数据装入 Db%s" % ("" if errors.is_empty() else "：" + str(errors)))
	_段0_卡表(t)
	_段1_满弦(t)
	_段2_连珠箭(t)
	_段3_再加一注(t)
	_段4_段数下限(t)
	_段5_覆盖(t)
	_段6_一次性(t)
	_段7_作用范围(t)
	_段8_散布每段独立(t)
	_段9_无相邻回退(t)
	_段10_装甲池按目标(t)
	_段11_回归装甲池(t)
	_段12_闪开不被污染(t)
	_段14_同种子两遍(t)

# ==========================================================================================
# ○ 三张改写牌（改名后的 id 与显示名）—— 数值逐字照设计稿
# ==========================================================================================
func _段0_卡表(t) -> void:
	var 卡们 := AtxRewrite.卡表()
	t.ok(卡们.size() == 3, "○ 三张改写牌：满弦 / 连珠箭 / 再加一注（实际 %d 张）" % 卡们.size())
	var 满 := AtxRewrite.卡(AtxRewrite.ID_满弦)
	var 连 := AtxRewrite.卡(AtxRewrite.ID_连珠箭)
	var 注 := AtxRewrite.卡(AtxRewrite.ID_再加一注)
	t.ok(str(满.get("名")) == "满弦" and str(满.get("武器改写")) == "满弦" and str(满.get("角色")) == "A3"
		and float(满.get("耗气")) == 5.0,
		"○ 满弦：id = %s / 角色 A3（拉米亚）/ 费 5" % AtxRewrite.ID_满弦)
	t.ok(str(连.get("名")) == "连珠箭" and str(连.get("角色")) == "A3",
		"○ 连珠箭：id = %s / 角色 A3（拉米亚）/ 费 5" % AtxRewrite.ID_连珠箭)
	t.ok(str(注.get("名")) == "再加一注" and str(注.get("角色")) == "A1",
		"○ ★改名：原稿「加码」→ 显示名「再加一注」，内部 id = %s（响介 A1）/ 费 5" % AtxRewrite.ID_再加一注)
	t.ok(AtxRewrite.满弦_伤害倍率 == 1.2 and AtxRewrite.满弦_命中加 == 15.0
		and AtxRewrite.连珠箭_段数倍率 == 2.0 and AtxRewrite.连珠箭_威力倍率 == 0.60
		and AtxRewrite.加注_段数倍率 == 1.5 and AtxRewrite.加注_威力倍率 == 0.8,
		"○ 六个数值：满弦 ×1.2 / 命中 +15 · 连珠箭 段×2 / 威力×**0.60**（设计稿原值 −40%，第 4 项已恢复）· 再加一注 段×1.5 / 威力×0.8")

# ==========================================================================================
# ① 满弦：`650 × 3 箭` → `1 段`，威力 = `1950 × 1.2 = 2340`，命中 +15
# ==========================================================================================
func _段1_满弦(t) -> void:
	var 甲 := _弓手(0.0)
	var 靶 := _靶(0.0)
	var c := _场([甲], [靶])
	var w := _弓(650.0, 3, 85.0)
	t.ok(AtxRewrite.是弓牌(w), "① 这张牌带【弓】标签（`w.标签 = [\"弓\"]`）→ 吃满弦")
	t.ok(J.truthy(AtxRewrite.设(甲, AtxRewrite.满弦, c)), "① 满弦写进**单一槽** `u.武器改写`（%s）" % str(AtxRewrite.槽(甲).keys()))
	t.ok(AtxRewrite.槽文字(甲) == "满弦（下一张【弓】武器牌）",
		"① 预告层纯读口 `槽文字(u)` = 「%s」" % AtxRewrite.槽文字(甲))
	var 前命中 := int(Calc.hitRate(甲, w, 靶, {}).hit)
	var 改 := AtxRewrite.应用(c, 甲, w)
	var 改后: Dictionary = 改["武器"]
	t.ok(J.truthy(改.get("生效")) and int(改.get("前段数")) == 3 and int(改.get("后段数")) == 1,
		"① `650 × 3 箭` → **1 段**（前 %d 段 → 后 %d 段）" % [int(改.get("前段数")), int(改.get("后段数"))])
	t.ok(float(改后.get("power")) == 2340.0 and float(改后.get("hits")) == 1.0,
		"① 威力 = 原总伤害 1950 × 1.2 = **2340**、段数 1（段数×每段威力 = 1950）")
	t.ok(float(w.get("power")) == 650.0 and float(w.get("hits")) == 3.0,
		"① **模板没被改**：原武器仍是 650 × 3 段（`应用` 返回的是 duplicate）")
	var 后命中 := int(Calc.hitRate(甲, 改后, 靶, {}).hit)
	t.ok(前命中 == 85 and 后命中 == 100 and 后命中 - 前命中 == 15,
		"① 命中 +15：改前 %d%% → 改后 %d%%（85 + 15 = 100，顶到上限）" % [前命中, 后命中])
	# 不顶上限的一发：60% → 75%（差正好 15）
	var w2 := _弓(650.0, 3, 60.0)
	var 前2 := int(Calc.hitRate(甲, w2, 靶, {}).hit)
	var 改2 := AtxRewrite.应用(c, _设槽(甲, AtxRewrite.满弦, c), w2)
	var 后2 := int(Calc.hitRate(甲, 改2["武器"], 靶, {}).hit)
	t.ok(前2 == 60 and 后2 == 75 and 后2 - 前2 == 15,
		"① 命中 +15（不顶上限）：改前 %d%% → 改后 %d%%（差正好 15）" % [前2, 后2])
	AtxRewrite.设(甲, AtxRewrite.满弦, c)
	var 改3 := AtxRewrite.应用(c, 甲, _弓(650.0, 3, 85.0))
	var r := Calc.resolveAttack(甲, 靶, 改3["武器"], c, {})
	t.ok(int(_数字段(r, "段数")) == 1 and int(_数字段(r, "伤害")) == 2340,
		"① 真打一发（装甲 0）：段数 = 1、总伤害 = **2340**（1 段 × 2340）")
	t.ok(int(AtxRewrite.改写本场次数(c).get("满弦")) == 3,
		"① 结算层纯读口 `改写本场次数` = %s（本场满弦生效 3 次）" % str(AtxRewrite.改写本场次数(c)))

# ==========================================================================================
# ② 连珠箭：`650 × 3 箭` → `6 段 × 390`（650 × 0.60 = 390），名义总伤 `2340`
#    ★ 第 4 项断路器修复：DS41F 擅自改成 ×0.45（−55%），已恢复设计稿原值 ×0.60（−40%）。
# ==========================================================================================
func _段2_连珠箭(t) -> void:
	var 甲 := _弓手(0.0)
	var 靶 := _靶(0.0)
	var c := _场([甲], [靶])
	AtxRewrite.设(甲, AtxRewrite.连珠箭, c)
	var 改 := AtxRewrite.应用(c, 甲, _弓(650.0, 3, 85.0))
	var 改后: Dictionary = 改["武器"]
	t.ok(float(改后.get("hits")) == 6.0 and float(改后.get("power")) == 390.0,
		"② `650 × 3 箭` → **6 段 × 390**（箭数 ×2、每箭 −40%，650 × 0.60 = 390）")
	t.ok(float(改后.get("hits")) * float(改后.get("power")) == 2340.0,
		"② 名义总伤 = 6 × 390 = **2340**（设计稿原值；装甲 600 受控实测 1750）")
	AtxRewrite.设(甲, AtxRewrite.连珠箭, c)
	var 改2 := AtxRewrite.应用(c, 甲, _弓(650.0, 3, 85.0))
	var r := Calc.resolveAttack(甲, 靶, 改2["武器"], c, {})
	t.ok(int(_数字段(r, "段数")) == 6 and int(_数字段(r, "伤害")) == 2340,
		"② 真打一发（装甲 0）：6 段全中、总伤害 = 2340（6 × 390）")

# ==========================================================================================
# ③ 再加一注：`5 段` → `7 段`（floor(7.5)），每段 ×0.8；`12 段` → `18 段`
# ==========================================================================================
func _段3_再加一注(t) -> void:
	var 甲 := _响介(0.0)
	var 靶 := _靶(0.0)
	var c := _场([甲], [靶])
	AtxRewrite.设(甲, AtxRewrite.再加一注, c)
	var 改 := AtxRewrite.应用(c, 甲, _武(250.0, 5, 80.0))
	var 改后: Dictionary = 改["武器"]
	t.ok(float(改后.get("hits")) == 7.0 and float(改后.get("power")) == 200.0,
		"③ 5 段 → **7 段**（floor(5 × 1.5) = 7）、每段 250 → **200**（×0.8）")
	AtxRewrite.设(甲, AtxRewrite.再加一注, c)
	var 改12 := AtxRewrite.应用(c, 甲, _武(500.0, 12, 75.0))
	t.ok(float((改12["武器"] as Dictionary).get("hits")) == 18.0
		and float((改12["武器"] as Dictionary).get("power")) == 400.0,
		"③ 12 段 → **18 段**（floor(18)）、每段 500 → 400（×0.8）")
	# 「响介任意武器牌」：非【弓】的物理武器照样生效
	t.ok(not AtxRewrite.是弓牌(_武(250.0, 5, 80.0)) and AtxRewrite.匹配(AtxRewrite.规则表()[AtxRewrite.再加一注], _武(250.0, 5, 80.0)),
		"③ 「再加一注」吃**任意**武器牌（这张牌没有【弓】标签，照样匹配）")

# ==========================================================================================
# ④ 段数下限：`1 段` 的武器被「再加一注」→ 仍 `1 段`（下限 1，不出现 0）
# ==========================================================================================
func _段4_段数下限(t) -> void:
	var 甲 := _响介(0.0)
	var c := _场([甲], [_靶(0.0)])
	AtxRewrite.设(甲, AtxRewrite.再加一注, c)
	var 改 := AtxRewrite.应用(c, 甲, _武(2200.0, 1, 90.0))
	var 改后: Dictionary = 改["武器"]
	t.ok(float(改后.get("hits")) == 1.0,
		"④ 1 段 + 再加一注 → 仍 **1 段**（floor(1 × 1.5) = 1，下限 1，绝不出现 0）")
	t.ok(float(改后.get("power")) == 1760.0,
		"④ 每段威力 2200 → **1760**（×0.8；段数没变，所以这一发的总伤反而降了）")

# ==========================================================================================
# ⑤ 覆盖：先打满弦再打连珠箭 → 生效的是连珠箭（6 段），满弦被覆盖
# ==========================================================================================
func _段5_覆盖(t) -> void:
	var 甲 := _弓手(0.0)
	var c := _场([甲], [_靶(0.0)])
	AtxRewrite.设(甲, AtxRewrite.满弦, c)
	var 覆 := AtxRewrite.设(甲, AtxRewrite.连珠箭, c)
	t.ok(str(覆.get("覆盖了")) == "满弦" and str(AtxRewrite.槽(甲).get("类型")) == "连珠箭",
		"⑤ 后打的覆盖先打的：槽里只剩「连珠箭」（覆盖掉了「满弦」）")
	var 改 := AtxRewrite.应用(c, 甲, _弓(650.0, 3, 85.0))
	t.ok(float((改["武器"] as Dictionary).get("hits")) == 6.0
		and float((改["武器"] as Dictionary).get("power")) == 390.0,
		"⑤ 生效的是**连珠箭**（6 段 × 390），不是满弦的 1 段 × 2340")

# ==========================================================================================
# ⑥ 一次性：只作用于下一张匹配武器牌；再下一张恢复原样
# ==========================================================================================
func _段6_一次性(t) -> void:
	var 甲 := _弓手(0.0)
	var 靶 := _靶(0.0)
	var c := _场([甲], [靶])
	AtxRewrite.设(甲, AtxRewrite.满弦, c)
	var 一 := Calc.resolveAttack(甲, 靶, AtxRewrite.应用(c, 甲, _弓(650.0, 3, 85.0))["武器"], c, {})
	t.ok(int(_数字段(一, "段数")) == 1, "⑥ 第一发：1 段（满弦生效）")
	t.ok(AtxRewrite.槽(甲).is_empty(), "⑥ 用完即清：打完之后 `u.武器改写` 那个键**没有了**（%s）" % str(AtxRewrite.槽(甲)))
	t.ok(AtxRewrite.槽文字(甲) == "",
		"⑥ 预告层跟着一起空：`槽文字(u)` = 「%s」（空槽 → 界面一句话都不多）" % AtxRewrite.槽文字(甲))
	var 二 := Calc.resolveAttack(甲, 靶, _弓(650.0, 3, 85.0), c, {})
	t.ok(int(_数字段(二, "段数")) == 3 and int(_数字段(二, "伤害")) == 1950,
		"⑥ 第二发：恢复原样 **3 段**（总伤害 1950）")
	# ---- 端到端接线：走 `Btl._执行武器攻击`（主武器卡 / 大招 / 副武器都走这一个口子）----
	var 甲2 := _弓手(0.0)
	var 靶2 := _靶(0.0)
	var c2 := _场([甲2], [靶2])
	var 武 := _弓(650.0, 3, 100.0)
	甲2["weapons"] = [{"t": 武, "cd": 0.0, "uses": null, "readyTurn": 0.0}]
	AtxRewrite.设(甲2, AtxRewrite.满弦, c2)
	Btl._执行武器攻击(c2, 甲2, 甲2.weapons[0], 靶2.get("key"))
	var 行 := _找行(c2, "伤害 2340")
	t.ok(行 != "（没有这一行）",
		"⑥ 端到端（`Btl._执行武器攻击` 真的调了改写）：记录 = 「%s」" % 行)
	t.ok(AtxRewrite.槽(甲2).is_empty() and float(武.get("hits")) == 3.0,
		"⑥ 端到端也**用完即清**，且牌面模板仍是 3 段（没有被改写污染）")

# ==========================================================================================
# ⑦ 作用范围：满弦 / 连珠箭 对**非弓**不生效且不被消耗；再加一注 对响介任意武器生效
# ==========================================================================================
func _段7_作用范围(t) -> void:
	var 甲 := _弓手(0.0)
	var c := _场([甲], [_靶(0.0)])
	AtxRewrite.设(甲, AtxRewrite.满弦, c)
	var 非弓 := _武(400.0, 5, 85.0)
	var 不改 := AtxRewrite.应用(c, 甲, 非弓)
	t.ok(not J.truthy(不改.get("生效")) and float((不改["武器"] as Dictionary).get("hits")) == 5.0,
		"⑦ 满弦 打**非弓**武器牌 → 不生效（仍 5 段）")
	t.ok(str(AtxRewrite.槽(甲).get("类型")) == "满弦",
		"⑦ 非弓**不消耗**改写槽：`u.武器改写` 还在（%s）" % str(AtxRewrite.槽(甲).get("类型")))
	var 弓 := AtxRewrite.应用(c, 甲, _弓(650.0, 3, 85.0))
	t.ok(J.truthy(弓.get("生效")) and AtxRewrite.槽(甲).is_empty(),
		"⑦ 接着打一张【弓】→ 立刻生效并被消耗")
	AtxRewrite.设(甲, AtxRewrite.连珠箭, c)
	var 不改2 := AtxRewrite.应用(c, 甲, 非弓)
	t.ok(not J.truthy(不改2.get("生效")) and str(AtxRewrite.槽(甲).get("类型")) == "连珠箭",
		"⑦ 连珠箭 同样只吃【弓】：非弓不生效、槽还在")
	AtxRewrite.设(甲, AtxRewrite.再加一注, c)
	var 注 := AtxRewrite.应用(c, 甲, 非弓)
	t.ok(J.truthy(注.get("生效")) and float((注["武器"] as Dictionary).get("hits")) == 7.0,
		"⑦ 「再加一注」对**非弓**武器牌也生效（5 段 → 7 段）")

# ==========================================================================================
# ⑧ 散布每段独立：主目标 + 1 台十字相邻敌机，8 段 → 偏移段数在 (0, 8) 之间
# ==========================================================================================
func _段8_散布每段独立(t) -> void:
	var r := _打散布(_场([_弓手(0.0)], [_靶(0.0), _靶(1.0)], 散布种子), 8)
	var 偏移 := int(_数字段(r, "散布偏移段数"))
	t.ok(J.truthy(_数字段(r, "散布")) and 偏移 > 0 and 偏移 < 8,
		"⑧ 8 段散布（主目标 + 1 台十字相邻）→ **偏移 %d 段**（0 < 偏移 < 8，不是整次攻击掷一次）" % 偏移)
	t.ok(偏移 == 5 and int(_数字段(r, "段数")) == 8,
		"⑧ 固定种子 %d → 主目标 %d 段 / 副目标 %d 段（总段数仍是 8）" % [散布种子, 8 - 偏移, 偏移])
	var 落点 = _数字段(r, "散布落点")
	t.ok(落点 is Array and (落点 as Array).size() == 2
		and int((落点 as Array)[0].get("段数")) == 3 and int((落点 as Array)[1].get("段数")) == 5,
		"⑧ 落点：主目标 3 段 / 十字相邻的那台 5 段（%s）" % str(落点))
	# 同种子两遍：偏移段数与文本逐字相同
	var a := _打散布(_场([_弓手(0.0)], [_靶(0.0), _靶(1.0)], 散布种子), 8)
	var b := _打散布(_场([_弓手(0.0)], [_靶(0.0), _靶(1.0)], 散布种子), 8)
	t.ok(int(_数字段(a, "散布偏移段数")) == int(_数字段(b, "散布偏移段数"))
		and str(a.get("文本")) == str(b.get("文本")),
		"⑧ 同种子两遍：偏移段数 %d / %d、记录文本逐字相同" % [
			int(_数字段(a, "散布偏移段数")), int(_数字段(b, "散布偏移段数"))])
	t.ok(str(r.get("文本")).find("\n") == -1 and int(_数字段(r, "段数")) == 8,
		"⑧ **一次攻击 = 一条记录**（`文本` 单行、段数 8）：%s" % str(r.get("文本")))

# ==========================================================================================
# ⑨ 无相邻时回退：十字相邻全空 → 8 段全部打主目标，记录里偏移 0
# ==========================================================================================
func _段9_无相邻回退(t) -> void:
	var 主 := _靶(0.0)
	var 远 := _靶(5.0)   # 同一方，但不在十字相邻格上（slot 5 = 后排第 2 列）
	var c := _场([_弓手(0.0)], [主, 远], 散布种子)
	var r := _打散布(c, 8)
	t.ok(Calc.散布候选(主, c).size() == 1,
		"⑨ `Calc.散布候选` 只认出 1 个落点（十字相邻没有存活敌机 → 回退）")
	t.ok(int(_数字段(r, "散布偏移段数")) == 0 and int(_数字段(r, "段数")) == 8,
		"⑨ 8 段全都打主目标：偏移 **0 段**（不许失败、不许跳过）")
	t.ok(int(_数字段(r, "伤害")) == 2000 and float(远.get("hp")) == 千,
		"⑨ 8 × 250 = **2000** 全落在主目标身上，那台不相邻的敌机一点没挨（HP 仍是 %s）" % J.s(远.get("hp")))
	t.ok(str(r.get("文本")).find("散布 0 段偏移") == -1,
		"⑨ 偏移 0 时记录里不写那截尾巴：「%s」" % str(r.get("文本")))

