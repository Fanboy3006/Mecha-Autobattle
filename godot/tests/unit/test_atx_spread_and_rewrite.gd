# ⑩ ★ 装甲池按目标独立：主目标甲 600 / 副目标甲 300，两个池各自消耗
# ==========================================================================================
func _段10_装甲池按目标(t) -> void:
	var 主 := _靶(0.0)
	主["armor"] = 600.0
	var 副 := _靶(1.0)
	副["armor"] = 300.0
	var c := _场([_弓手(0.0)], [主, 副], 散布种子)
	var r := _打散布(c, 8)
	var 池 = _数字段(r, "散布池")
	t.ok(池 is Array and (池 as Array).size() == 2, "⑩ 两个被打目标各自一个池（%d 个）" % ((池 as Array).size() if 池 is Array else -1))
	var 主池: Dictionary = (池 as Array)[0]
	var 副池: Dictionary = (池 as Array)[1]
	t.ok(float(主池.get("甲")) == 600.0 and float(主池.get("吸收")) == 600.0 and float(主池.get("剩余")) == 0.0
		and int(主池.get("命中段")) == 3,
		"⑩ 主目标（甲 600，挨 3 段）：池初值 %s、**吸收 %s**、**剩余 %s**（10 + 10 + 150 = 170）" % [
			J.s(主池.get("甲")), J.s(主池.get("吸收")), J.s(主池.get("剩余"))])
	t.ok(float(副池.get("甲")) == 300.0 and float(副池.get("吸收")) == 300.0 and float(副池.get("剩余")) == 0.0
		and int(副池.get("命中段")) == 5,
		"⑩ 副目标（甲 300，挨 5 段）：池初值 %s、**吸收 %s**、**剩余 %s**（10 + 200 + 250×3 = 960）" % [
			J.s(副池.get("甲")), J.s(副池.get("吸收")), J.s(副池.get("剩余"))])
	t.ok(float(主池.get("吸收")) <= 600.0 and float(副池.get("吸收")) <= 300.0,
		"⑩ **没有出现「主目标的池被副目标的段消耗」**：主池只吃掉 ≤ 600、副池只吃掉 ≤ 300（各按自己的 A 起算）")
	t.ok(int(_数字段(r, "伤害")) == 1130,
		"⑩ 总伤害 = 主 170 + 副 960 = **1130**（若两个池串成一个 600 的池，数字会不同）")
	t.ok(float(主.get("hp")) == 千 - 170.0 and float(副.get("hp")) == 千 - 960.0,
		"⑩ HP 扣在**各自**的目标上：主 -%d / 副 -%d（主 170 / 副 960）" % [170, 960])

