func _段11_回归装甲池(t) -> void:
	# ① 12 段 × 500 vs 甲 600，全中 → 5410
	var a := _甲单位(0.0)
	var d1 := _甲单位(0.0, 600.0)
	t.ok(_数字段(Calc.resolveAttack(a, d1, _武(500.0, 12, 100.0, "map"), _场([a], [d1]), {}), "伤害") == 5410.0,
		"⑪ ① 12 段 × 500 vs 甲 600 全中 → **5410**（10 + 400 + 500×10）")
	# ② 1 段 × 2200 vs 甲 600 → 1600
	var d2 := _甲单位(0.0, 600.0)
	t.ok(_数字段(Calc.resolveAttack(a, d2, _武(2200.0, 1, 100.0, "map"), _场([a], [d2]), {}), "伤害") == 1600.0,
		"⑪ ② 1 段 × 2200 vs 甲 600 → **1600**（2200 − 600，单段武器零回归）")
	# ④ 打空段不扣池：前 3 段打空、其余命中 → 3910
	var 种 := _找种子()
	var d4 := _甲单位(0.0, 600.0)
	var r4 := Calc.resolveAttack(a, d4, _武(500.0, 12, 50.0, "direct"), _场([a], [d4], 种), {})
	t.ok(int(_数字段(r4, "伤害")) == 3910,
		"⑪ ④ 前 3 段打空、其余 9 段命中（种子 %d）→ **3910**（打空段不扣池）" % 种)
	# ⑤ 池不跨攻击：连续两次都是 5410
	var d5 := _甲单位(0.0, 600.0)
	var c5 := _场([a], [d5])
	var 一 := float(_数字段(Calc.resolveAttack(a, d5, _武(500.0, 12, 100.0, "map"), c5, {}), "伤害"))
	var 二 := float(_数字段(Calc.resolveAttack(a, d5, _武(500.0, 12, 100.0, "map"), c5, {}), "伤害"))
	t.ok(一 == 5410.0 and 二 == 5410.0,
		"⑪ ⑤ 池不跨攻击：**5410 / 5410**（每次攻击按 A = 600 重新初始化）")
	# ⑥ 无视防御 / 特殊：整条跳过池 → 6000
	var 组们 := [["无视防御", {"ignoreDef": true}, "物理"], ["特殊", {}, "特殊"]]
	var 好 := true
	var 说明: Array = []
	for 组 in 组们:
		var 一次 := _打一次池(组)
		好 = 好 and 一次 == 6000
		说明.append("%s %d" % [str(组[0]), 一次])
	t.ok(好, "⑪ ⑥ `无视防御` / `特殊` 整条跳过池 → %s（都该是 **6000**）" % "、".join(说明))

