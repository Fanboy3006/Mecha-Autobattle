# ==========================================================================================
# ⑨ ★ 预告同源：`Btl.算意图` 预告的目标 == 敌方阶段实际的目标（挑衅 / 一击脱离 / 都不生效）
# ==========================================================================================
func _段9_预告同源(t) -> void:
	# ---- A. 挑衅生效 ----
	var 重 := _单位("重1", "ally", 0.0, "重装")
	重["hp"] = 8000.0
	var 脆 := _单位("脆1", "ally", 1.0, "尖兵")
	脆["hp"] = 3000.0      # 天然该打它（血最低）
	var 敌A := _敌("敌A", 0.0, _武(1000.0, 1, 100.0, "direct"))
	var cA := _场([重, 脆], [敌A])
	var 自然A := str((Btl.算意图(cA)[0] as Dictionary).get("目标"))
	_发牌(cA, "挑衅")
	t.ok(J.truthy(_打(cA, "重1", "挑衅").get("成功")), "⑨ A 重装打出【挑衅】")
	var 预告A := str((Btl.算意图(cA)[0] as Dictionary).get("目标"))
	var 实际A := _打一轮(敌A, cA)
	t.info("⑨ A 挑衅：不打牌时预告 %s；打牌后预告 **%s**、实际 **%s**" % [自然A, 预告A, 实际A])
	t.info("⑨ A 实际攻击记录：%s" % _最后攻击行(cA))
	t.ok(自然A == "脆1", "⑨ A 前置：不挑衅时预告打血最低的「脆1」（%s）" % 自然A)
	t.ok(预告A == "重1" and 实际A == "重1", "⑨ A 挑衅：预告 **%s** == 实际 **%s**（都打挑衅者）" % [预告A, 实际A])
	# ---- B. 一击脱离生效 ----
	var 尖 := _单位("尖1", "ally", 0.0, "尖兵")
	尖["hp"] = 3000.0      # 天然该打它
	var 指 := _单位("指1", "ally", 1.0, "指挥")
	指["hp"] = 6000.0
	var 敌B := _敌("敌B", 2.0, _武(1000.0, 1, 100.0, "melee"))
	var cB := _场([尖, 指], [敌B])
	cB["turn"] = 2.0
	var 自然B := str((Btl.算意图(cB)[0] as Dictionary).get("目标"))
	_发牌(cB, "一击脱离")
	t.ok(J.truthy(_打(cB, "尖1", "一击脱离").get("成功")), "⑨ B 尖兵打出【一击脱离】（第 2 回合起）")
	尖["weapons"] = [{"t": _武(100.0, 1, 100.0, "melee"), "cd": 0.0, "uses": null, "readyTurn": 0.0}]
	Btl.打出主武器卡(cB, "尖1", "测试武器", "敌B")
	t.ok(J.truthy(尖.get("一击脱离中")), "⑨ B 打完主武器 → `一击脱离中` = %s" % str(尖.get("一击脱离中")))
	var 预告B := str((Btl.算意图(cB)[0] as Dictionary).get("目标"))
	var 实际B := _打一轮(敌B, cB)
	t.info("⑨ B 一击脱离：不打牌时预告 %s；生效后预告 **%s**、实际 **%s**" % [自然B, 预告B, 实际B])
	t.info("⑨ B 实际攻击记录：%s" % _最后攻击行(cB))
	t.ok(自然B == "尖1", "⑨ B 前置：没「一击脱离」时预告打血最低的「尖1」（%s）" % 自然B)
	t.ok(预告B == "指1" and 实际B == "指1", "⑨ B 一击脱离：预告 **%s** == 实际 **%s**（近战不能选尖兵）" % [预告B, 实际B])
	# ---- C. 两者都不生效 ----
	var 甲 := _单位("甲1", "ally", 0.0, "近卫")
	甲["hp"] = 5000.0
	var 乙 := _单位("乙1", "ally", 1.0, "近卫")
	乙["hp"] = 4000.0
	var 敌C := _敌("敌C", 0.0, _武(1000.0, 1, 100.0, "melee"))
	var cC := _场([甲, 乙], [敌C])
	var 预告C := str((Btl.算意图(cC)[0] as Dictionary).get("目标"))
	var 实际C := _打一轮(敌C, cC)
	t.info("⑨ C 都不生效：预告 **%s**、实际 **%s**" % [预告C, 实际C])
	t.ok(预告C == 实际C and 预告C == "乙1", "⑨ C 都不生效：预告 **%s** == 实际 **%s**（打血最低的乙1）" % [预告C, 实际C])
	t.ok(预告A == 实际A and 预告B == 实际B and 预告C == 实际C,
		"⑨ ★ 同局面「算意图 预告」与「敌方阶段实际」**逐次 100%% 相同**（挑衅 / 一击脱离 / 都不生效 = 3/3 局面）")

