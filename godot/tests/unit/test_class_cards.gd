# ⑦ 回旋斩：下一张近战武器牌变成「横扫」（打到整排）+ 伤害 −40%
# ==========================================================================================
func _段7_回旋斩(t) -> void:
	var 扫 := _回旋场(true)
	var 单 := _回旋场(false)
	var 扫伤: Array = (扫.get("伤") as Array)
	var 单伤: Array = (单.get("伤") as Array)
	t.info("回旋斩：无牌时打到 %d 台（主目标受伤 %s）；有牌时打到 %d 台（%s）" % [
		单伤.size(), J.s(单伤[0]) if not 单伤.is_empty() else "—",
		扫伤.size(), str(扫伤)])
	t.ok(单伤.size() == 1, "⑦ 无牌：近战武器只打**主目标 1 台**")
	t.ok(扫伤.size() == 3, "⑦ 有牌：下一张近战武器牌变成「横扫」→ 打到**目标所在一整排**（%d 台）" % 扫伤.size())
	t.ok(not 扫伤.is_empty() and not 单伤.is_empty() and int(扫伤[0]) == int(round(float(单伤[0]) * 0.6)),
		"⑦ 伤害 **−40%%**：同一把武器 主目标 %s → %s（×0.6）" % [J.s(单伤[0]), J.s(扫伤[0])])
	t.ok(float(扫.get("后1血")) == 千, "⑦ 后排那台**没挨打**（横扫只打一整排）：后1 剩 %s" % J.s(扫.get("后1血")))

