## ★ A6a：三套**职业分类牌** 18 张（近卫 6 / 尖兵 6 / 重装 6）+ 拉米亚双势力 + 「散布击杀计击破」回归。
##
## 权威依据：
##   · `协作/设计/响介卡牌设计 v0.1.md` §8.2 / `拉米亚卡牌设计 v0.1.md` §7.2 / `塔斯克与雷欧娜卡牌设计 v0.1.md` §3
##   · `协作/架构/任务单-ATX-v0.3与卡牌新机制-ARGON.md` §2.2（次与段）/ §4 A6a 行 / §5 R1·R4·R5
##
## 受控单位（不走 `Setup.开局`，裸字典）：`atk == D == 0` ⇒ `coef == 1`、`armor` 手填、`eva = 0`
## ⇒ 命中率 = `w.hit`、`critBase = -10` ⇒ 暴击率 0（伤害干净可断言）。
## 兰斯战线 / 职业排位在数据里都开着（`前排近战增伤 0.15` / `重装前排减伤 0.20` …），
## 所以「前后数字」一律在**同一个受控场景**里各跑一遍（有牌 / 无牌），比的是同一把武器、同一个位。
## 本文件跑完会把 `Db.T.战斗结构.单机牌组.开` 还原成进来时的值（后面的测试仍走改前口径）。
extends RefCounted

const 千 := 999999.0

func run(t) -> void:
	var errors := []
	t.ok(DataLoader.install(errors), "数据装入 Db%s" % ("" if errors.is_empty() else "：" + str(errors)))
	_段1_注册(t)
	_段2_职业限制(t)
	_段3_条件发牌(t)
	_段4_铁壁(t)
	_段5_反冲(t)
	_段6_死守与不倒(t)
	_段7_回旋斩(t)
	_段8_绕后奇袭(t)
	_段9_预告同源(t)
	_段10_散布击破(t)
	_段11_双势力(t)
	_段13_同种子(t)
	_段14_顺劈(t)

# ==========================================================================================
# ① 18 张全部注册成功，职业归属正确（近卫 6 / 尖兵 6 / 重装 6）
# ==========================================================================================
func _段1_注册(t) -> void:
	var 表 := ClassCards.卡表()
	t.ok(表.size() == 18, "① 卡表共 **%d** 张（近卫 6 / 尖兵 6 / 重装 6）" % 表.size())
	for 职业 in ClassCards.职业们:
		var 们 := ClassCards.职业牌们(职业)
		t.ok(们.size() == 6, "① 【%s】%d 张" % [职业, 们.size()])
		var 归属对 := J.every(们, func(c): return _注册对口(c, 职业))
		t.ok(归属对, "① 【%s】6 张全部 `层级 = 职业` / `卡类 = 公有牌` / `种类 = 职业` / `归属 = %s` / `回库 = true`" % [职业, 职业])
	# 费用与入库条件逐张对设计稿（一个数都没改）
	var 期望 := {
		"压制杂兵": [5.0, "开战即入库"], "突入": [0.0, "开战即入库"], "乘胜追击": [5.0, "打出者本场击破"],
		"死守前线": [15.0, "打出者在前排"], "回旋斩": [10.0, "第 2 回合起"], "顺劈": [5.0, "开战即入库"],
		"标记目标": [5.0, "开战即入库"], "侧翼渗透": [5.0, "开战即入库"], "闪避机动": [5.0, "开战即入库"],
		"扰乱通讯": [10.0, "第 2 回合起"], "一击脱离": [10.0, "第 2 回合起"], "绕后奇袭": [15.0, "第 3 回合起"],
		"铁壁": [10.0, "开战即入库"], "挑衅": [5.0, "开战即入库"], "横向掩护": [10.0, "打出者在前排"],
		"紧急修理": [10.0, "打出者 HP ≤ 50%"], "反冲": [10.0, "第 2 回合起"], "不倒": [20.0, "第 3 回合起"],
	}
	var 费错: Array = []
	var 条错: Array = []
	for c in 表:
		var 名 := str(c.get("名", ""))
		if not 期望.has(名):
			费错.append("%s（多出来的牌）" % 名)
			continue
		if float(c.get("耗气")) != float(期望[名][0]):
			费错.append("%s %s≠%s" % [名, J.s(c.get("耗气")), J.s(期望[名][0])])
		var 条 = c.get("入库条件")
		var 文 := "开战即入库"
		if 条 is Dictionary:
			文 = str((条 as Dictionary).get("说明", "?"))
		if not 文.begins_with(str(期望[名][1])):
			条错.append("%s「%s」" % [名, 文])
	t.ok(费错.is_empty() and 期望.size() == 表.size(), "① 18 张费用逐字照设计稿（%s）" % ("全对" if 费错.is_empty() else "错：" + str(费错)))
	t.ok(条错.is_empty(), "① 18 张入库条件逐字照设计稿（%s）" % ("全对" if 条错.is_empty() else "错：" + str(条错)))
	t.ok(ClassCards.卡("CC_G3").get("名") == "乘胜追击" and ClassCards.按名("不倒").get("id") == "CC_H6",
		"① `卡(id)` / `按名(名)` 两种取法都对（CC_G3 = 乘胜追击 / 不倒 = CC_H6）")

# ==========================================================================================
# ② 职业限制：非该职业的机体打不出来（返回失败 + 原因），该职业的能打
# ==========================================================================================
func _段2_职业限制(t) -> void:
	var 近 := _单位("近1", "ally", 0.0, "近卫")
	var 尖 := _单位("尖1", "ally", 1.0, "尖兵")
	var 重 := _单位("重1", "ally", 2.0, "重装")
	var 敌 := _靶("靶1", 0.0)
	var c := _场([近, 尖, 重], [敌])
	_发牌(c, "标记目标")
	_发牌(c, "压制杂兵")
	_发牌(c, "铁壁")
	var 错 := _打(c, "近1", "标记目标", "靶1")
	t.ok(not J.truthy(错.get("成功")) and str(错.get("原因", "")).contains("不对口"),
		"② 近卫机打【尖兵】牌「标记目标」→ **失败**（原因：%s）" % str(错.get("原因", "")))
	var 对 := _打(c, "尖1", "标记目标", "靶1")
	t.ok(J.truthy(对.get("成功")), "② 尖兵机打【尖兵】牌「标记目标」→ **成功**")
	var 近牌 := _打(c, "近1", "压制杂兵")
	t.ok(J.truthy(近牌.get("成功")), "② 近卫机打【近卫】牌「压制杂兵」→ **成功**")
	var 重牌 := _打(c, "重1", "铁壁")
	t.ok(J.truthy(重牌.get("成功")), "② 重装机打【重装】牌「铁壁」→ **成功**")
	t.ok(_战意(c, "尖1") == 95.0 and _战意(c, "重1") == 90.0 and _战意(c, "近1") == 95.0,
		"② 扣的是**打出者自己的**战意：尖兵 100→%s（费 5）、重装 100→%s（费 10）、近卫 100→%s（费 5）" % [
			J.s(_战意(c, "尖1")), J.s(_战意(c, "重1")), J.s(_战意(c, "近1"))])

# ==========================================================================================
# ③ 条件发牌：乘胜追击（击破≥1）· 死守前线（在前排）· 紧急修理（HP≤50%）· 第 2/3 回合起
# ==========================================================================================
func _段3_条件发牌(t) -> void:
	# ---- 乘胜追击：打出者本场击破 ≥ 1 ----
	var 近 := _单位("近1", "ally", 0.0, "近卫")
	var c := _场([近], [_靶("靶1", 0.0)])
	var 条 = ClassCards.按名("乘胜追击").get("入库条件")
	t.ok(not DeckFlow.条件满足(c, 近, 条), "③ 乘胜追击：本场击破 0 → 入库条件**不满足**")
	_发牌(c, "乘胜追击")
	var 拒 := _打(c, "近1", "乘胜追击")
	t.ok(not J.truthy(拒.get("成功")) and str(拒.get("原因", "")).contains("入库条件"),
		"③ 击破 0 时打不出去（原因：%s）" % str(拒.get("原因", "")))
	近["v3计数"] = {"本场击破": 1}
	t.ok(DeckFlow.条件满足(c, 近, 条), "③ 打出者本场击破 1 → 入库条件**满足**")
	var 成 := _打(c, "近1", "乘胜追击")
	t.ok(J.truthy(成.get("成功")), "③ 击破 ≥ 1 时打得出去")
	# 公有待入库：按「该职业的在场机体」算（有一台满足就入库）
	var c2 := _场([_单位("近2", "ally", 0.0, "近卫")], [_靶("靶1", 0.0)])
	c2["公有待入库"] = [ClassCards.按名("乘胜追击")]
	DeckFlow.检查公有待入库(c2)
	t.ok((c2["公有待入库"] as Array).size() == 1 and (c2["公有牌库"] as Array).is_empty(),
		"③ 公有待入库：全队击破 0 → 留在 `公有待入库`（牌库 %d 张）" % (c2["公有牌库"] as Array).size())
	(c2.allies[0] as Dictionary)["v3计数"] = {"本场击破": 1}
	DeckFlow.检查公有待入库(c2)
	t.ok((c2["公有待入库"] as Array).is_empty() and (c2["公有牌库"] as Array).size() == 1,
		"③ 有近卫击破 ≥ 1 → 放进 `公有牌库`（待入库清空、牌库 1 张）")
	# ---- 死守前线：打出者在前排 ----
	var 前 := _单位("前1", "ally", 0.0, "近卫")
	var 后 := _单位("后1", "ally", 5.0, "近卫")
	var c3 := _场([前, 后], [_靶("靶1", 0.0)])
	t.ok(DeckFlow.条件满足(c3, 前, ClassCards.按名("死守前线").get("入库条件")), "③ 死守前线：前排的近卫 → 满足")
	t.ok(not DeckFlow.条件满足(c3, 后, ClassCards.按名("死守前线").get("入库条件")), "③ 死守前线：后排的近卫 → **不满足**")
	_发牌(c3, "死守前线")
	var 后拒 := _打(c3, "后1", "死守前线")
	t.ok(not J.truthy(后拒.get("成功")) and str(后拒.get("原因", "")).contains("入库条件"),
		"③ 后排打【死守前线】→ 失败（原因：%s）" % str(后拒.get("原因", "")))
	var 前成 := _打(c3, "前1", "死守前线")
	t.ok(J.truthy(前成.get("成功")), "③ 前排打【死守前线】→ 成功")
	# ---- 紧急修理：打出者 HP ≤ 50% ----
	var 重 := _单位("重1", "ally", 1.0, "重装")
	var c4 := _场([重], [_靶("靶1", 0.0)])
	重["hp"] = 600.0   # 60%
	t.ok(not DeckFlow.条件满足(c4, 重, ClassCards.按名("紧急修理").get("入库条件")), "③ 紧急修理：HP 60% → **不满足**")
	重["hp"] = 500.0   # 50%（含边界）
	t.ok(DeckFlow.条件满足(c4, 重, ClassCards.按名("紧急修理").get("入库条件")), "③ 紧急修理：HP 50%（边界）→ 满足")
	_发牌(c4, "紧急修理")
	_打(c4, "重1", "紧急修理")
	t.ok(float(重.hp) == 750.0, "③ 紧急修理：回复 25%% 最大 HP（1000）→ 500 → **%s**" % J.s(重.get("hp")))
	# ---- 第 2 回合起（回旋斩）----
	var 近2 := _单位("近3", "ally", 0.0, "近卫")
	var c5 := _场([近2], [_靶("靶1", 0.0)])
	c5["turn"] = 1.0
	_发牌(c5, "回旋斩")
	var 回1 := _打(c5, "近3", "回旋斩")
	t.ok(not J.truthy(回1.get("成功")) and str(回1.get("原因", "")).contains("第 2 回合起"),
		"③ 第 1 回合打【回旋斩】（条件：第 2 回合起）→ 失败（原因：%s）" % str(回1.get("原因", "")))
	c5["turn"] = 2.0
	var 回2 := _打(c5, "近3", "回旋斩")
	t.ok(J.truthy(回2.get("成功")), "③ 第 **2** 回合打【回旋斩】→ 成功")
	# ---- ★ CB-0：【顺劈】5 费 / 开战即入库 / 初始（第 1 回合就打得出来）----
	var 近4 := _单位("近4", "ally", 0.0, "近卫")
	var c6 := _场([近4], [_靶("靶1", 0.0)])
	c6["turn"] = 1.0
	t.ok(ClassCards.按名("顺劈").get("id") == "CC_G6" and float(ClassCards.按名("顺劈").get("耗气")) == 5.0,
		"③ 【顺劈】= `CC_G6`、5 费")
	t.ok(ClassCards.按名("顺劈").get("入库条件") == null and str(ClassCards.按名("顺劈").get("获取")) == "初始",
		"③ 【顺劈】**开战即入库**（入库条件 = null）、获取 = 初始 → 第 1 回合就打得出来")
	_发牌(c6, "顺劈")
	var 顺 := _打(c6, "近4", "顺劈")
	t.ok(J.truthy(顺.get("成功")) and J.truthy(近4.get("下张近战附加顺劈")),
		"③ 第 **1** 回合打【顺劈】→ 成功，打出者挂上 `下张近战附加顺劈 = %s`" % str(近4.get("下张近战附加顺劈")))
	t.info("③ 【顺劈】摘要：%s" % str(顺.get("效果摘要")))
	t.ok(str(顺.get("效果摘要")).contains("顺劈") and str(顺.get("效果摘要")).contains("50%"),
		"③ 摘要写着【顺劈】与 50%%：%s" % str(顺.get("效果摘要")))

# ==========================================================================================
# ④ 铁壁：受到的伤害 **−40%**（贴前后数字）；代价：本回合伤害 **−30%**
# ==========================================================================================
func _段4_铁壁(t) -> void:
	var 重 := _单位("重1", "ally", 0.0, "重装")
	重["hp"] = 千
	重["maxHp"] = 千
	var 敌 := _靶("靶1", 0.0)
	var c := _场([重], [敌])
	var 敌武 := _武(1000.0, 1, 100.0, "map")
	var 我武 := _武(1000.0, 1, 100.0, "map")
	# 改前（没打牌）
	var 伤前 := int(_伤(Calc.resolveAttack(敌, 重, 敌武, c, {})))
	var 打前 := int(_伤(Calc.resolveAttack(重, 敌, 我武, c, {})))
	_发牌(c, "铁壁")
	t.ok(J.truthy(_打(c, "重1", "铁壁").get("成功")), "④ 重装打出【铁壁】（费 10）")
	# 改后（同一发、同一个位）
	var 伤后 := int(_伤(Calc.resolveAttack(敌, 重, 敌武, c, {})))
	var 打后 := int(_伤(Calc.resolveAttack(重, 敌, 我武, c, {})))
	t.info("铁壁：同一发 1000（必中 / 甲 0 / 防 0）打这个前排重装 → 改前 %d → 改后 %d" % [伤前, 伤后])
	t.info("铁壁代价：同一发 1000 由这个重装打出去 → 改前 %d → 改后 %d" % [打前, 打后])
	t.ok(伤后 == 480 and 伤前 == 800 and 伤前 - 伤后 == 320,
		"④ 受到的伤害真的 **−40%%**：**%d → %d**（800 × 0.6 = 480，少 320）" % [伤前, 伤后])
	t.ok(打后 == 700 and 打前 == 1000,
		"④ 代价「本回合伤害 −30%%」真的生效：**%d → %d**（1000 × 0.7 = 700）" % [打前, 打后])
	t.ok(_有行(c, "〔铁壁〕") and _找行(c, "〔铁壁〕").contains("−40%"),
		"④ 即时反馈一行：%s" % _找行(c, "〔铁壁〕"))

# ==========================================================================================
# ⑤ 反冲：**8 段近战命中 1 次只反 400**（不是每段 400×8）
# ==========================================================================================
func _段5_反冲(t) -> void:
	var 重 := _单位("重1", "ally", 0.0, "重装")
	var 敌 := _敌("敌1", 4.0, _武(100.0, 8, 100.0, "melee"))
	var c := _场([重], [敌])
	c["turn"] = 2.0
	_发牌(c, "反冲")
	t.ok(J.truthy(_打(c, "重1", "反冲").get("成功")), "⑤ 重装打出【反冲】（第 2 回合起，费 10）")
	var 血前 := float(敌.hp)
	var r := Calc.resolveAttack(敌, 重, 敌.weapons[0].t, c, {})
	var 反冲行: Array = _行们带键(c, "反冲")
	t.info("反冲：8 段近战全中（命中段数 %s）→ 攻击者 HP %s → %s（差 %s）；〔反冲〕记录 %d 行" % [
		J.s(_伤段(r, "命中段数")), J.s(血前), J.s(敌.get("hp")), J.s(血前 - float(敌.get("hp"))), 反冲行.size()])
	t.ok(int(_伤段(r, "命中段数")) == 8, "⑤ 前置：这一发 **8 段全部命中**（命中段数 = %s）" % J.s(_伤段(r, "命中段数")))
	t.ok(血前 - float(敌.get("hp")) == 400.0,
		"⑤ **8 段命中 1 次只反 400**：攻击者 HP %s → %s（扣 400，不是 400×8 = 3200）" % [J.s(血前), J.s(敌.get("hp"))])
	t.ok(反冲行.size() == 1, "⑤ 〔反冲〕**只有 1 行**（§2.2：按攻击事件算，不按段）= %d 行" % 反冲行.size())
	t.ok(not 反冲行.is_empty() and str(反冲行[0]).contains("400"), "⑤ 那一行写着 400：%s" % (反冲行[0] if not 反冲行.is_empty() else "（没有）"))

# ==========================================================================================
# ⑥ 死守前线 / 不倒：致命伤害保留 1 HP，且**下个我方阶段武器牌全部销毁**
# ==========================================================================================
func _段6_死守与不倒(t) -> void:
	# ---- 死守前线（近卫 · 前排）----
	var 近 := _单位("近1", "ally", 0.0, "近卫")
	var 敌 := _敌("敌1", 0.0, _武(千, 1, 100.0, "map"))
	var c := _场([近], [敌])
	_发牌(c, "死守前线")
	t.ok(J.truthy(_打(c, "近1", "死守前线").get("成功")), "⑥ 近卫（前排）打出【死守前线】（费 15）")
	c["turn"] = 1.0
	Calc.resolveAttack(敌, 近, 敌.weapons[0].t, c, {})
	t.info("死守前线：挨一发 %s → HP 剩 %s（改前这里会直接归 0）" % [J.s(千), J.s(近.get("hp"))])
	t.ok(float(近.hp) == 1.0, "⑥ 致命伤害 → **HP 剩 1**（不会被击破）：%s" % J.s(近.get("hp")))
	t.ok(_有行(c, "〔死守前线〕"), "⑥ 即时反馈一行：%s" % _找行(c, "〔死守前线〕"))
	Btl.开始我方阶段(c)
	t.ok(J.truthy(近.get("主武器已销毁")) == true,
		"⑥ 下个我方阶段：打出者**武器牌全部销毁**（主武器已销毁 = %s）" % str(近.get("主武器已销毁")))
	t.ok(_有行(c, "代价兑现"), "⑥ 代价兑现记了一行：%s" % _找行(c, "代价兑现"))
	# ---- 不倒（重装 · 第 3 回合起）----
	var 重 := _单位("重1", "ally", 0.0, "重装")
	var 敌2 := _敌("敌2", 0.0, _武(千, 1, 100.0, "map"))
	var c2 := _场([重], [敌2])
	c2["turn"] = 3.0
	_发牌(c2, "不倒")
	t.ok(J.truthy(_打(c2, "重1", "不倒").get("成功")), "⑥ 重装打出【不倒】（第 3 回合起，费 20）")
	Calc.resolveAttack(敌2, 重, 敌2.weapons[0].t, c2, {})
	t.info("不倒：挨一发 %s → HP 剩 %s" % [J.s(千), J.s(重.get("hp"))])
	t.ok(float(重.hp) == 1.0, "⑥ 致命伤害 → **HP 剩 1**：%s" % J.s(重.get("hp")))
	Btl.开始我方阶段(c2)
	t.ok(J.truthy(重.get("主武器已销毁")) == true,
		"⑥ 不倒：下个我方阶段武器牌全部销毁（主武器已销毁 = %s）" % str(重.get("主武器已销毁")))

