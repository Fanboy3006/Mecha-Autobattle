# ==========================================================================================
# ⑭ ★ CB-0 逆劈：主目标 100%；**同排左右相邻**的敌机各 50% 单段威力（各自判定命中 / 暴击 /
#    各自的装甲共享池）；身后**不同排**的敌机一点也不挨；多段武器**逐段**劈。
# ==========================================================================================
func _段14_顺劈(t) -> void:
	var 无 := _顺劈场(false, 1)
	var 有 := _顺劈场(true, 1)
	var 无伤: Dictionary = 无.get("伤")
	var 伤: Dictionary = 有.get("伤")
	t.info("顺劈（单段）：无牌时 %s；有牌时 %s" % [str(无伤), str(伤)])
	t.ok(_挨打台数(无伤) == 1, "⑭ 无牌：近战武器只打**主目标 1 台**（挨打的有 %d 台）" % _挨打台数(无伤))
	t.ok(_挨打台数(伤) == 3, "⑭ 有牌：**主目标 + 同排左右相邻**共 3 台挨打（%s）" % str(伤))
	var 主伤 := int(伤.get("主1", 0))
	var 左伤 := int(伤.get("左1", 0))
	var 右伤 := int(伤.get("右1", 0))
	t.ok(主伤 == int(无伤.get("主1", 0)) and 主伤 > 0,
		"⑭ 主目标仍按 **100%%** 单段威力（有牌 %s == 无牌 %s）" % [J.s(主伤), J.s(无伤.get("主1"))])
	t.ok(左伤 > 0 and 右伤 > 0 and absi(左伤 - 右伤) <= 1,
		"⑭ **左右相邻**各挨一刀、伤害相同（左 %s / 右 %s）" % [J.s(左伤), J.s(右伤)])
	t.ok(_接近(左伤, 主伤 * 0.5), "⑭ 相邻格按 **50%%** 单段威力：左邻 %s ≈ 主目标 %s × 0.5（%s）" % [
		J.s(左伤), J.s(主伤), J.s(J.round(主伤 * 0.5))])
	t.ok(int(伤.get("后1", 0)) == 0,
		"⑭ 身后**不同排**的那台**一点也没挨**（顺劈只看同排左右）：%s" % J.s(伤.get("后1")))
	t.ok(int(有.get("左段", 0)) == 1 and int(有.get("右段", 0)) == 1,
		"⑭ 每台副目标各是一次**独立的攻击结算**（左邻命中段 %s / 右邻 %s）" % [J.s(有.get("左段")), J.s(有.get("右段"))])
	t.ok(int(有.get("副目标条数", 0)) == 2,
		"⑭ 战报里对两台副目标**各写一条攻击记录**（%d 条）" % int(有.get("副目标条数")))
	# ---- 多段：逐段劈（3 段 → 主目标 3 段全中；副目标也是 3 段，各自掷命中）----
	var 多无 := _顺劈场(false, 3)
	var 多 := _顺劈场(true, 3)
	var 多伤: Dictionary = 多.get("伤")
	t.info("顺劈（3 段 × 300）：无牌 %s；有牌 %s" % [str(多无.get("伤")), str(多伤)])
	t.ok(int(多伤.get("主1", 0)) == int((多无.get("伤") as Dictionary).get("主1", 0)) and int(多伤.get("主1", 0)) > 0,
		"⑭ 多段：主目标仍按 100%% 逐段结算（有牌 %s == 无牌 %s）" % [
			J.s(多伤.get("主1")), J.s((多无.get("伤") as Dictionary).get("主1"))])
	t.ok(int(多.get("左段", 0)) == 3 and int(多.get("右段", 0)) == 3,
		"⑭ 多段**逐段劈**：副目标**每一段都独立掷命中**（左邻命中段 %s / 右邻命中段 %s）" % [
			J.s(多.get("左段")), J.s(多.get("右段"))])
	t.ok(_接近(int(多伤.get("左1", 0)), int(多伤.get("主1", 0)) * 0.5),
		"⑭ 多段副目标总伤害 ≈ 主目标 × 0.5：左 %s / 主 %s" % [J.s(多伤.get("左1")), J.s(多伤.get("主1"))])
	# ---- 装甲共享池：每台副目标**各自一份**（只看它自己的 A，不跟主目标共用）----
	var 池 := _顺劈场(true, 1, 1000.0)
	var 池伤: Dictionary = 池.get("伤")
	t.info("顺劈（左邻装甲 1000 / 右邻装甲 0 / 主目标装甲 0）：%s" % str(池伤))
	t.ok(int(池伤.get("主1", 0)) == 主伤 and int(池伤.get("右1", 0)) == 右伤,
		"⑭ 主目标 / 右邻（装甲 0）照常 100%% / 50%%：%s / %s" % [J.s(池伤.get("主1")), J.s(池伤.get("右1"))])
	t.ok(int(池伤.get("左1", 0)) < int(池伤.get("右1", 0)),
		"⑭ 左邻**用的是它自己那份装甲池**（A = 1000 把 50%% 威力全部吃掉，只挨保底 %s；装甲 0 的右邻挨 %s）" % [
			J.s(池伤.get("左1")), J.s(池伤.get("右1"))])

## ⑭ 挨打（失血 > 0）的敌机台数。
func _挨打台数(伤: Dictionary) -> int:
	var n := 0
	for k in 伤.keys():
		if int(伤[k]) > 0:
			n += 1
	return n

## ⑭ 伤害对得上吗：允许逐段取整带来的 ±4 误差（3 段各 round 一次）。
func _接近(a: int, b: float) -> bool:
	return absf(float(a) - b) <= 4.0

## ⑭ 一组受控场景：近卫站 slot 0（前排左 1），近战武器打前排的「主1」（slot 1）。
## 敌方：左1 slot 0（同排左邻）/ 主1 slot 1 / 右1 slot 2（同排右邻）/ 后1 slot 5（后排同列，不该挨）。
## `段数` = 这一发武器的段数；`左甲` = 只给左邻的装甲（用来验「各自一份装甲共享池」）。
## 返回 `{伤: {键: 失血}, 左段/右段: 副目标那一条攻击记录的命中段数, 副目标条数}`
func _顺劈场(用牌: bool, 段数: int, 左甲: float = 0.0) -> Dictionary:
	var 近 := _单位("近1", "ally", 0.0, "近卫")
	近["weapons"] = [{"t": _武(300.0 if 段数 > 1 else 1000.0, 段数, 100.0, "melee"),
		"cd": 0.0, "uses": null, "readyTurn": 0.0}]
	var 左 := _靶("左1", 0.0)
	var 主 := _靶("主1", 1.0)
	var 右 := _靶("右1", 2.0)
	var 后 := _靶("后1", 5.0)
	左["armor"] = 左甲
	var c := _场([近], [左, 主, 右, 后])
	c["turn"] = 1.0
	if 用牌:
		_发牌(c, "顺劈")
		_打(c, "近1", "顺劈")
	Btl.打出主武器卡(c, "近1", "测试武器", "主1")
	var 伤 := {}
	for u in [左, 主, 右, 后]:
		var 失 := 千 - float((u as Dictionary).get("hp", 千))
		伤[str((u as Dictionary).get("key"))] = int(失)
	# 副目标的「命中段数」从它自己那一条攻击记录里读（证明每段都独立掷）
	var 左段 := 0
	var 右段 := 0
	var 副条 := 0
	for e in J.or_(c.get("log"), []):
		if not (e is Dictionary) or str((e as Dictionary).get("类型", "")) != "攻击":
			continue
		var 目标键 := str((e as Dictionary).get("目标", ""))
		if 目标键 == "左1":
			左段 = int(J.num0((e as Dictionary).get("命中段数")))
			副条 += 1
		elif 目标键 == "右1":
			右段 = int(J.num0((e as Dictionary).get("命中段数")))
			副条 += 1
	return {"伤": 伤, "左段": 左段, "右段": 右段, "副目标条数": 副条}

# ==========================================================================================
# 小工具
# ==========================================================================================
func _注册对口(c: Dictionary, 职业: String) -> bool:
	return str(c.get("归属", "")) == 职业 and str(c.get("层级", "")) == "职业" \
		and str(c.get("卡类", "")) == "公有牌" and str(c.get("种类", "")) == "职业" \
		and c.get("回库") == true and ClassCards.是分类牌(c)

## 一台裸单位：单机牌组需要的字段一次给齐（`Calc` / `Btl` / `ClassCards` 都直接吃这一份）。
func _单位(键: String, side: String, 位: float, 职业: String) -> Dictionary:
	var 标 := {}
	if 职业 != "":
		标 = {"战斗分类": 职业, "势力": "ATX"}
	return {
		"key": 键, "name": 键, "side": side, "slot": 位, "lv": 10.0,
		"maxHp": 1000.0, "hp": 1000.0,
		"melee": 0.0, "shoot": 0.0, "awaken": 0.0, "defense": 0.0,
		"armor": 0.0, "armorCut": 0.0, "eva": 0.0, "aim": 160.0,
		"critBase": -10.0, "critMod": 0.0, "mov": 5.0,
		"buffs": [], "debuffs": [], "abilities": [],
		"shield": 0.0, "shieldHp": 0.0, "barrierLeft": 0.0,
		"tags": 标, "weapons": [],
		"战意": 100.0, "战意上限": 100.0, "主武器已销毁": false, "连续攻击已用": false,
		"专属手牌": [], "专属牌库": [], "专属弃牌堆": [], "衍生手牌": [],
		"大招槽": [], "武器栏": [], "副武器栏": [], "待入库": [],
	}

## 靶机（敌方；没有 战斗分类，所以不吃职业排位那一套攻方加成）
func _靶(键: String, 位: float) -> Dictionary:
	var e := _单位(键, "enemy", 位, "")
	e["hp"] = 千
	e["maxHp"] = 千
	return e

## 带武器的敌机（⑨ 用）
func _敌(键: String, 位: float, w: Dictionary) -> Dictionary:
	var e := _靶(键, 位)
	e["weapons"] = [{"t": w, "cd": 0.0, "uses": null, "readyTurn": 0.0}]
	return e

func _场(我方: Array, 敌方: Array, 种子: int = 20261017) -> Dictionary:
	return {
		"turn": 1.0, "种子": float(种子), "rng": Mulberry32.new(种子),
		"allies": 我方, "enemies": 敌方, "log": [], "_rng_at": [],
		"当前战术": null, "气势": 0.0, "单机牌组": true,
		"公有手牌": [], "公有牌库": [], "公有弃牌堆": [], "公有待入库": [], "上张打出牌": null,
		"筹码牌库": [], "烟雾": [], "again": [],
		# `Flow.resolveAction` / `FacAtx.本回合重置` 读这几把键（正式对局由战术卡牌初始化建好，
		# 这里照 `Setup.开局` 的同一份形状给齐；少了任何一个键它们会直接报错）
		"战况计数": {"残月或月国命中": 0.0, "未命中段": 0.0, "秘银标定": 0.0,
			"刹那命中或TA": 0.0, "响介受击或打空": 0.0, "满手牌推迟数": 0.0},
	}

func _发牌(c: Dictionary, 名: String) -> Dictionary:
	var 卡 := ClassCards.按名(名).duplicate(true)
	if 卡.is_empty():
		push_error("测试里找不到分类牌：%s" % 名)
	(c["公有手牌"] as Array).append(卡)
	return 卡

func _打(c: Dictionary, 键: String, 名: String, 目标: Variant = null) -> Dictionary:
	var 卡 := _找手牌(c, 名)
	if 卡.is_empty():
		return {"成功": false, "原因": "手里没有这张牌（%s）" % 名}
	return Btl.打出精神或公有牌(c, 键, 卡.get("id"), 目标)

func _找手牌(c: Dictionary, 名: String) -> Dictionary:
	for x in J.or_(c.get("公有手牌"), []):
		if x is Dictionary and str((x as Dictionary).get("名", "")) == 名:
			return x
	return {}

func _战意(c: Dictionary, 键: String) -> float:
	for u in J.or_(c.get("allies"), []):
		if u is Dictionary and str((u as Dictionary).get("key", "")) == 键:
			return float((u as Dictionary).get("战意", 0.0))
	return -1.0

func _武(威力: float, 段数: int, 命中率: float = 100.0, fire: String = "direct") -> Dictionary:
	return {"name": "测试武器", "fire": fire, "dmgType": "物理", "power": 威力, "hit": 命中率,
		"stat": "射击", "hits": float(段数), "cd": 0.0, "upgrades": []}

func _散布武(威力: float, 段数: int, 命中率: float = 100.0) -> Dictionary:
	var w := _武(威力, 段数, 命中率, "direct")
	w["name"] = "方形钢弹"
	w["散布"] = true
	return w

func _伤(r: Dictionary) -> float:
	var f = r.get("字段")
	return float((f as Dictionary).get("伤害", 0.0)) if f is Dictionary else 0.0

func _伤段(r: Dictionary, 键: String) -> Variant:
	var f = r.get("字段")
	return (f as Dictionary).get(键) if f is Dictionary else null

func _行们(c: Dictionary) -> Array:
	var out: Array = []
	for e in J.or_(c.get("log"), []):
		if e is Dictionary:
			out.append(str((e as Dictionary).get("文本", "")))
	return out

func _行数(c: Dictionary, 子串: String) -> int:
	return _行们(c).filter(func(x): return str(x).contains(子串)).size()

## 带某个事件字段的日志行（例：`反冲` = 400 那一行；打出牌时的说明行没有这个键）
func _行们带键(c: Dictionary, 键: String) -> Array:
	var out: Array = []
	for e in J.or_(c.get("log"), []):
		if e is Dictionary and (e as Dictionary).get(键) != null:
			out.append(str((e as Dictionary).get("文本", "")))
	return out

func _有行(c: Dictionary, 子串: String) -> bool:
	return _行数(c, 子串) > 0

func _找行(c: Dictionary, 子串: String) -> String:
	for 行 in _行们(c):
		if str(行).contains(子串):
			return str(行)
	return "（没有这一行）"

## 最后一条「攻击」事件里的某个字段（`Flow.resolveAction` 写进记录的那个字典）
func _最后攻击字段(c: Dictionary, 键: String) -> Variant:
	var logs: Array = J.or_(c.get("log"), [])
	for i in range(logs.size() - 1, -1, -1):
		var e = logs[i]
		if not (e is Dictionary):
			continue
		if str((e as Dictionary).get("类型", "")) != "攻击":
			continue
		return (e as Dictionary).get(键)
	return null

## 最后一条「攻击」事件的记录文本（报告里贴的样例）
func _最后攻击行(c: Dictionary) -> String:
	var logs: Array = J.or_(c.get("log"), [])
	for i in range(logs.size() - 1, -1, -1):
		var e = logs[i]
		if e is Dictionary and str((e as Dictionary).get("类型", "")) == "攻击":
			return str((e as Dictionary).get("文本", ""))
	return "（没有攻击记录）"

## ⑨ 跑一轮敌方行动，返回它实际打的那个目标键
func _打一轮(敌: Dictionary, c: Dictionary) -> String:
	Flow.actOnce(敌, c)
	var v = _最后攻击字段(c, "目标")
	return str(v) if v != null else "（没有攻击记录）"

## ⑦ 一组受控场景：近卫用近战武器打前排 3 台（后排 1 台当对照）。
## `用牌` = true 时先打出【回旋斩】。返回 `{伤: [每台受到的伤害], 后1血}`
func _回旋场(用牌: bool) -> Dictionary:
	var 近 := _单位("近1", "ally", 0.0, "近卫")
	近["weapons"] = [{"t": _武(1000.0, 1, 100.0, "melee"), "cd": 0.0, "uses": null, "readyTurn": 0.0}]
	var 前1 := _靶("前1", 0.0)
	var 前2 := _靶("前2", 1.0)
	var 前3 := _靶("前3", 2.0)
	var 后1 := _靶("后1", 5.0)
	var c := _场([近], [前1, 前2, 前3, 后1])
	c["turn"] = 2.0
	if 用牌:
		_发牌(c, "回旋斩")
		_打(c, "近1", "回旋斩")
	Btl.打出主武器卡(c, "近1", "测试武器", "前1")
	var 伤: Array = []
	for u in [前1, 前2, 前3, 后1]:
		var 失 := 千 - float((u as Dictionary).get("hp", 千))
		if 失 > 0.0:
			伤.append(int(失))
	return {"伤": 伤, "后1血": float(后1.get("hp"))}

## ⑧ 一组受控场景：尖兵在 slot 7（后4）、目标在 slot 0（前1）—— 本仓库阵型 4×4 = 8 格，`真实距离 = 5`（最远）；武器距离 [1,1]。
## `用牌` = true 时先打出【绕后奇袭】。返回 `{可达, why, 伤}`
func _绕后场(用牌: bool) -> Dictionary:
	var 尖 := _单位("尖1", "ally", 7.0, "尖兵")
	var 敌 := _靶("靶1", 0.0)
	var c := _场([尖], [敌])
	c["turn"] = 3.0
	var w := _武(1000.0, 1, 100.0, "direct")
	w["距离"] = [1, 1]
	尖["weapons"] = [{"t": w, "cd": 0.0, "uses": null, "readyTurn": 0.0}]
	var 判: Dictionary = Reach.武器可达吗(c, 尖, w, 敌)
	if 用牌:
		_发牌(c, "绕后奇袭")
		_打(c, "尖1", "绕后奇袭")
		判 = Reach.武器可达吗(c, 尖, w, 敌)
	var r := Btl.打出主武器卡(c, "尖1", "测试武器", "靶1")
	var 伤 := int(_最后攻击字段(c, "伤害")) if J.truthy(r.get("成功")) else 0
	return {"可达": 判.get("ok"), "why": str(判.get("why")), "伤": 伤}
