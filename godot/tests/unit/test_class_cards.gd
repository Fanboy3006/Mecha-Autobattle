# ⑩ ★ 散布击杀计击破（A5b 遗留缺陷回归）：击破 +1 / 〔击破〕一行 / 战意 +10
# ==========================================================================================
func _段10_散布击破(t) -> void:
	var 散 := _单位("散1", "ally", 1.0, "近卫")
	散["战意"] = 50.0
	散["weapons"] = [{"t": _散布武(300.0, 8, 100.0), "cd": 0.0, "uses": null, "readyTurn": 0.0}]
	var 主 := _靶("主标", 1.0)
	var 副 := _靶("副标", 0.0)   # 主目标的十字相邻（左）
	副["hp"] = 10.0
	副["maxHp"] = 10.0
	var c := _场([散], [主, 副], 20261017)
	var 战意前 := _战意(c, "散1")
	var r := Btl.打出主武器卡(c, "散1", "方形钢弹", "主标")
	var 击破行: Array = _行们(c).filter(func(x): return str(x).contains("〔击破〕"))
	t.info("⑩ 散布攻击记录：%s" % _最后攻击行(c))
	t.info("⑩ 散布副目标被打死：主标剩 %s / 副标剩 %s；击破数 %s；战意 %s → %s；〔击破〕%d 行" % [
		J.s(主.get("hp")), J.s(副.get("hp")), J.s(r.get("击破")), J.s(战意前), J.s(_战意(c, "散1")), 击破行.size()])
	t.ok(float(副.get("hp")) == 0.0 and float(主.get("hp")) > 0.0,
		"⑩ 前置：**副目标被打死**（副标剩 %s）、主标还活着（%s）" % [J.s(副.get("hp")), J.s(主.get("hp"))])
	t.ok(J.num0(r.get("击破")) == 1.0,
		"⑩ 击破数 **+1**（`Flow.resolveAction` 返回的击破 = %s；A5b 时这条是 0）" % J.s(r.get("击破")))
	t.ok(击破行.size() == 1 and str(击破行[0]).contains("副标"),
		"⑩ 〔击破〕**有那一行**且写着被打死的副目标：%s" % (击破行[0] if not 击破行.is_empty() else "（没有）"))
	t.ok(_战意(c, "散1") - 战意前 == 12.0,
		"⑩ 战意 **+10（击破）+ 2（命中一次）= +12**：%s → %s" % [J.s(战意前), J.s(_战意(c, "散1"))])
	t.ok(DeckFlow._计数(散, "本场击破") == 1 and DeckFlow.条件满足(c, 散, ClassCards.按名("乘胜追击").get("入库条件")),
		"⑩ 「乘胜追击」的入库条件（打出者本场击破 ≥ 1）真的满足了：计数 = %d" % DeckFlow._计数(散, "本场击破"))
	# 对照：普通击杀同口径（战意 +12、〔击破〕一行、本场击破 1）
	var 普 := _单位("普1", "ally", 1.0, "近卫")
	普["战意"] = 50.0
	普["weapons"] = [{"t": _武(1000.0, 1, 100.0, "direct"), "cd": 0.0, "uses": null, "readyTurn": 0.0}]
	var 靶 := _靶("靶1", 0.0)
	靶["hp"] = 10.0
	靶["maxHp"] = 10.0
	var c2 := _场([普], [靶], 20261017)
	var 战意前2 := _战意(c2, "普1")
	var r2 := Btl.打出主武器卡(c2, "普1", "测试武器", "靶1")
	t.ok(J.num0(r2.get("击破")) == 1.0 and _战意(c2, "普1") - 战意前2 == 12.0
		and _有行(c2, "〔击破〕") and DeckFlow._计数(普, "本场击破") == 1,
		"⑩ 对照（普通击杀）：击破 1 / 战意 +12 / 〔击破〕一行 / 本场击破 1 —— **与散布同一口径**")

