func _脚本() -> Dictionary:
	var 近 := _单位("近1", "ally", 0.0, "近卫")
	近["weapons"] = [{"t": _武(200.0, 2, 100.0, "melee"), "cd": 0.0, "uses": null, "readyTurn": 0.0}]
