## ★ A5b（拉米亚 v0.1 / 响介 v0.1）：武器「**段数改写**」层。
##
## 权威依据：`协作/设计/拉米亚卡牌设计 v0.1.md` §3.1 / §5
##          · `协作/设计/响介卡牌设计 v0.1.md` §4 / §6
##          · `协作/架构/任务单-ATX-v0.3与卡牌新机制-ARGON.md` §4 的 A5b 行
##
## 三条口径（逐字照设计稿，数值一个没改）：
##   ① 单位上只有**一个槽** `u.武器改写 = {类型, 名称, 卡牌, 回合}` —— **后打的覆盖先打的**（不叠加、不排队）。
##   ② 槽**只作用于下一张匹配的武器牌，用完即清**；打一张**不匹配**的武器牌 → 槽还在（不消耗）。
##      · 【弓】标签的武器牌（`w.标签` / `w.tags` 里有 `"弓"`，或 `w.弓` 为真）→ 吃「满弦」「连珠箭」；
##      · 「再加一注」吃**任意**武器牌。
##   ③ 三条改写（都是改**这一次**的武器实例，模板不动 —— `应用()` 返回 `duplicate`）：
##      · 满弦   ：`段数 = 1`；`威力 = 原总伤害（段数 × 每段威力）× 1.2`；命中 **+15**；
##      · 连珠箭 ：`段数 ×= 2`；`每段威力 ×= 0.60`（−40%）；
##      · 再加一注：`段数 = floor(段数 × 1.5)`；`每段威力 ×= 0.8`（−20%）。
##      **段数取整一律向下取整、下限 1**（`1 段` 被「再加一注」→ 仍 1 段，绝不出现 0 段）。
##
## ★ 改名说明（任务单 §6 第 2 条）：原稿「加码」与 A6 要做的势力牌「加注」字面撞车 →
##   本批显示名 = **「再加一注」**，内部 id = `ATX_RW_JIAYIZHU`。
##   内部 id 一览：满弦 `ATX_RW_MANXIAN` · 连珠箭 `ATX_RW_LIANZHU` · 再加一注 `ATX_RW_JIAYIZHU`。
##
## ★ 三层反馈：
##   即时 = `〔段数改写〕<谁>「<牌名>」→ 下一张…`（设槽）+ `〔段数改写〕<谁>「<牌名>」生效：<前> → <后>`（兑现）；
##   预告 = `槽文字(u)`（纯读，一行给界面用：槽里现在挂着哪张、管哪类武器）；
##   结算 = `改写本场次数(ctx)` / `改写本场明细(ctx)`（**纯读**，本轮不做界面）。
class_name AtxRewrite
extends RefCounted

# ---------------- 类型 id 与显示名 ----------------
const 满弦 := "满弦"
const 连珠箭 := "连珠箭"
const 再加一注 := "再加一注"

## 三条牌的内部 id（★ 改名后自定；「加码」→「再加一注」）
const ID_满弦 := "ATX_RW_MANXIAN"
const ID_连珠箭 := "ATX_RW_LIANZHU"
const ID_再加一注 := "ATX_RW_JIAYIZHU"

## 作用范围（`弓` = 只吃带【弓】标签的武器牌；`任意` = 什么都吃）
const 范围_弓 := "弓"
const 范围_任意 := "任意"

## 【弓】标签的唯一字面
const 弓标签 := "弓"

# ---------------- 数值（逐字照设计稿，一个数没改） ----------------
## 满弦：伤害 = 原总伤害 × 1.2、命中 +15
const 满弦_伤害倍率 := 1.2
const 满弦_命中加 := 15.0
## 连珠箭：段数 ×2、每段威力 ×0.60（**−40%，设计稿原值，作者拍板不许擅改**）
## ★ 第 4 项断路器修复（DS41F 越权改值）：DS41F 在自动轮次里把这里从 `0.60` 擅自改成了 `0.45`
##   （注释里写的理由是「装甲共享池口径下 ×0.6 变纯增益」）—— 那是**改设计稿数值**，
##   `CLAUDE.md` 第 7 节铁律：未经作者本人明确拍板，不许擅改设计稿数值。现已**恢复原值 0.60**。
##   受控实测（`test_atx_spread_and_rewrite.gd` / `test_class_heavy_cmd.gd`）：
##   拉米亚 幻影弓·连射 6 × 390 = **2340**；打甲 600（共享池）实测总伤害 = **1750**。
const 连珠箭_段数倍率 := 2.0
const 连珠箭_威力倍率 := 0.60
## 再加一注：段数 ×1.5（向下取整、下限 1）、每段威力 ×0.8（−20%）
const 加注_段数倍率 := 1.5
const 加注_威力倍率 := 0.8

# ==========================================================================================
# 一、规则表（全部纯读）
# ==========================================================================================
## 三条改写的规则表（`段数` = 改写方式，`范围` = 吃哪类武器牌）。
static func 规则表() -> Dictionary:
	return {
		"满弦": {"类型": 满弦, "名称": 满弦, "id": ID_满弦, "角色": "A3", "范围": 范围_弓,
			"段数": "合一", "段数倍率": 1.0, "威力倍率": 满弦_伤害倍率, "命中加": 满弦_命中加,
			"说明": "所有箭合成 1 段：伤害 = 原总伤害 × 1.2，命中 +15"},
		"连珠箭": {"类型": 连珠箭, "名称": 连珠箭, "id": ID_连珠箭, "角色": "A3", "范围": 范围_弓,
			"段数": "翻倍", "段数倍率": 连珠箭_段数倍率, "威力倍率": 连珠箭_威力倍率, "命中加": 0.0,
			"说明": "箭数 ×2，每箭威力 −40%"},
		"再加一注": {"类型": 再加一注, "名称": 再加一注, "id": ID_再加一注, "角色": "A1", "范围": 范围_任意,
			"段数": "加半", "段数倍率": 加注_段数倍率, "威力倍率": 加注_威力倍率, "命中加": 0.0,
			"说明": "段数 +50%（向下取整），每段威力 −20%"},
	}

## 这个类型名认不认（`""` / 不认识 = 不生效）。
static func 是改写类型(类型: Variant) -> bool:
	return 规则表().has(str(类型))

## 带【弓】标签的武器牌（唯一口径：`w.标签` / `w.tags` 里有 `"弓"`，或 `w.弓` 为真）。
static func 是弓牌(w: Variant) -> bool:
	if not (w is Dictionary):
		return false
	if J.truthy((w as Dictionary).get(弓标签)):
		return true
	for 键 in ["标签", "tags"]:
		if J.inc(J.g(w, 键), 弓标签):
			return true
	return false

## 这条改写吃不吃这张武器牌。
static func 匹配(规: Variant, w: Variant) -> bool:
	if not (规 is Dictionary) or not (w is Dictionary):
		return false
	if str((规 as Dictionary).get("范围", "")) == 范围_任意:
		return true
	return 是弓牌(w)

## 武器当前的段数（没有 / 非法 = 1；与 `Calc.resolveAttack` 同一口径）。
static func 段数Of(w: Variant) -> int:
	var v = J.g(w, "hits")
	var n := J.num0(v) if J.truthy(v) else 1.0
	return maxi(1, int(maxf(1.0, n)))

# ==========================================================================================
# 二、槽：设 / 清 / 读（`u.武器改写` 是**唯一**的槽，后打覆盖先打）
# ==========================================================================================
## 槽（没有 = 空字典）。**纯读**。
static func 槽(u: Variant) -> Dictionary:
	var v = J.g(u, "武器改写")
	return (v as Dictionary).duplicate(true) if v is Dictionary else {}

## 槽里现在挂着哪张、管哪类武器牌（预告层那一行；没有 = 空串）。**纯读**。
static func 槽文字(u: Variant) -> String:
	var 记 := 槽(u)
	if 记.is_empty():
		return ""
	var 规 = 规则表().get(str(记.get("类型", "")))
	if not (规 is Dictionary):
		return ""
	return "%s（下一张%s武器牌）" % [str(规.get("名称", "")),
		"【弓】" if str(规.get("范围", "")) == 范围_弓 else "任意"]

## 设槽：**后打的覆盖先打的**（不叠加、不排队）。返回 `{设, 覆盖了, 槽}`。
static func 设(u: Variant, 类型: Variant, ctx: Variant = null, 卡牌: Variant = null) -> Dictionary:
	var 记 := {"设": false, "覆盖了": "", "槽": {}}
	if not (u is Dictionary):
		return 记
	var 键 := str(类型)
	var 规 = 规则表().get(键)
	if not (规 is Dictionary):
		return 记
	var 旧 := 槽(u)
	if not 旧.is_empty() and str(旧.get("类型", "")) != 键:
		记["覆盖了"] = str(旧.get("名称", 旧.get("类型", "")))
	var 新 := {"类型": 键, "名称": str(规.get("名称", 键)), "范围": str(规.get("范围", "")),
		"卡牌": 卡牌, "回合": int(J.num0(J.g(ctx, "turn")))}
	(u as Dictionary)["武器改写"] = 新
	记["设"] = true
	记["槽"] = 新.duplicate(true)
	# ---- 即时那一行 ----
	var 尾 := "（覆盖上一张「%s」）" % 记["覆盖了"] if str(记["覆盖了"]) != "" else ""
	Btl.pushLog(ctx, "〔段数改写〕%s「%s」→ 下一张%s武器牌：%s%s" % [_谁名(u), str(规.get("名称", 键)),
		"【弓】" if str(规.get("范围", "")) == 范围_弓 else "任意",
		str(规.get("说明", "")), 尾],
		J.merged({"类型": "段数改写", "动作": "设", "单位": J.g(u, "key"), "改写类型": 键,
			"卡牌": 卡牌, "覆盖了": 记["覆盖了"], "回合": J.g(ctx, "turn")}, Btl.谁(u)))
	return 记

## 清槽（用完即清 / 手动取消）。返回清掉的那个类型（本来没有 = 空串）。
static func 清(u: Variant) -> String:
	if not (u is Dictionary) or not (u as Dictionary).has("武器改写"):
		return ""
	var 旧 := 槽(u)
	(u as Dictionary).erase("武器改写")
	return str(旧.get("类型", ""))

# ==========================================================================================
# 三、★ 兑现：把「这一次」的武器实例改掉（模板不动），用完即清
# ==========================================================================================
## 返回 `{生效, 武器, 改写, 摘要, 前段数, 后段数, 前威力, 后威力}`。
## `{生效: false, 武器: w}` = 这一次**没改写**（没有 ctx / 槽空 / 这张牌不匹配）——
## 不匹配时槽**不被消耗**（`u.武器改写` 原样还在）。
static func 应用(ctx: Variant, u: Variant, w: Variant) -> Dictionary:
	var 记 := {"生效": false, "武器": w, "改写": {}, "摘要": "", "前段数": 0, "后段数": 0,
		"前威力": 0.0, "后威力": 0.0}
	if not (u is Dictionary) or not (w is Dictionary):
		return 记
	var 旧 := 槽(u)
	if 旧.is_empty():
		return 记
	var 规 = 规则表().get(str(旧.get("类型", "")))
	if not (规 is Dictionary) or not 匹配(规, w):
		return 记
	var 改 := _改(规, w)
	var 前段 := 段数Of(w)
	var 前威 := _威力Of(w)
	(u as Dictionary).erase("武器改写")
	记["生效"] = true
	记["武器"] = 改
	记["前段数"] = 前段
	记["后段数"] = 段数Of(改)
	记["前威力"] = 前威
	记["后威力"] = _威力Of(改)
	记["改写"] = {"类型": str(规.get("类型", "")), "名称": str(规.get("名称", ""))}
	记["摘要"] = "%d 段 × %s → %d 段 × %s" % [前段, J.s(前威), int(记["后段数"]), J.s(记["后威力"])]
	# ---- 即时那一行 ----
	var 命中尾 := "，命中 +%s" % J.s(满弦_命中加) if float(规.get("命中加", 0.0)) != 0.0 else ""
	Btl.pushLog(ctx, "〔段数改写〕%s「%s」生效：%s %s%s" % [_谁名(u), str(规.get("名称", "")),
		str(J.g(w, "name")), str(记["摘要"]), 命中尾],
		J.merged({"类型": "段数改写", "动作": "生效", "单位": J.g(u, "key"),
			"改写类型": str(规.get("类型", "")), "武器": J.g(w, "name"),
			"前段数": float(前段), "后段数": float(记["后段数"]),
			"前威力": 前威, "后威力": float(记["后威力"]), "命中加": 规.get("命中加", 0.0),
			"回合": J.g(ctx, "turn")}, Btl.谁(u)))
	_计数加(ctx, str(规.get("类型", "")))
	return 记

## 真正改武器（**返回 duplicate，模板一个字节都不动**）。
static func _改(规: Dictionary, w: Dictionary) -> Dictionary:
	var 新: Dictionary = w.duplicate(true)
	var 段 := 段数Of(w)
	var 威 := _威力Of(w)
	match str(规.get("段数", "")):
		"合一":
			# 所有箭合成 1 段：威力 = 原总伤害（段数 × 每段威力）× 1.2
			新["power"] = J.round(float(段) * 威 * float(规.get("威力倍率", 满弦_伤害倍率)))
			新["hits"] = 1.0
		"翻倍":
			新["hits"] = float(段) * float(规.get("段数倍率", 连珠箭_段数倍率))
			新["power"] = J.round(威 * float(规.get("威力倍率", 连珠箭_威力倍率)))
		"加半":
			新["hits"] = float(maxi(1, int(floorf(float(段) * float(规.get("段数倍率", 加注_段数倍率))))))
			新["power"] = J.round(威 * float(规.get("威力倍率", 加注_威力倍率)))
	var 命中加 := float(规.get("命中加", 0.0))
	if 命中加 != 0.0:
		新["hit"] = float(J.nz(J.g(w, "hit"), 100.0)) + 命中加
	return 新

static func _威力Of(w: Variant) -> float:
	return J.num0(J.g(w, "power"))

# ==========================================================================================
# 四、牌面：三张改写牌（卡表；装进谁的牌库由 A6 统一装填）
# ==========================================================================================
## ★ 第 4 项断路器修复（DS41F）：三张改写牌的 `入牌库条件` 照设计稿原话补齐 ——
##   · 满弦   ：**开战即入库**（获取：初始）                     —— `拉米亚卡牌设计 v0.1.md` §5 第 65 行
##   · 连珠箭 ：**第 2 回合起**（获取：剧情）                    —— 同文件 §5 第 66 行
##   · 再加一注（别名「加码」）：**本场赌神开启过**（获取：剧情）—— `响介卡牌设计 v0.1.md` §6 第 71 行
##   条件类型都是 `DeckFlow.条件满足` 已实现的那几个字面；`获取` 决定肉鸽开局发不发（只发「初始」）。
static func 卡表() -> Array:
	return [
		{"id": ID_满弦, "名": 满弦, "卡类": "专属精神牌", "归属": "ATX", "层级": "角色",
			"角色": "A3", "占行动": [], "耗气": 5.0, "武器改写": 满弦, "获取": "初始",
			"入库条件": {"类型": "开战即入库", "说明": "开战即入库"},
			"效果说明": "拉米亚下一张【弓】武器牌的所有箭合成 1 段：伤害 = 原总伤害 × 1.2，命中 +15。"},
		{"id": ID_连珠箭, "名": 连珠箭, "卡类": "专属精神牌", "归属": "ATX", "层级": "角色",
			"角色": "A3", "占行动": [], "耗气": 5.0, "武器改写": 连珠箭, "获取": "剧情",
			"入库条件": {"类型": "第N回合", "阈值": 2, "说明": "第 2 回合起"},
			"效果说明": "拉米亚下一张【弓】武器牌的箭数 ×2，每箭威力 −40%。"},
		{"id": ID_再加一注, "名": 再加一注, "卡类": "专属精神牌", "归属": "ATX", "层级": "角色",
			"角色": "A1", "占行动": [], "耗气": 5.0, "武器改写": 再加一注, "获取": "剧情",
			"别名": ["加码"],
			"入库条件": {"类型": "本场赌神开启过", "说明": "本场赌神开启过"},
			"效果说明": "响介下一张武器牌段数 +50%（向下取整），每段威力 −20%。"},
	]

static func 卡(id: Variant) -> Dictionary:
	var 键 := str(J.g(id, "id")) if id is Dictionary else str(id)
	for c in 卡表():
		if str(c.get("id")) == 键:
			return (c as Dictionary).duplicate(true)
	return {}

static func 有(id: Variant) -> bool:
	return not 卡(id).is_empty()

## ★ 打出时（唯一入口）：这张牌带 `武器改写` 字段就在这里写槽（不带 = 一步都不进）。
## 返回 `{设, 覆盖了, 槽}`；`{设: false}` = 这张牌不改写（不是改写牌）。
static func 打出时(ctx: Variant, u: Variant, card: Variant) -> Dictionary:
	var 空 := {"设": false, "覆盖了": "", "槽": {}}
	if not (u is Dictionary) or not (card is Dictionary):
		return 空
	var 类型 = (card as Dictionary).get("武器改写")
	if not J.truthy(类型):
		return 空
	return 设(u, 类型, ctx, (card as Dictionary).get("id"))

# ==========================================================================================
# 五、结算（纯读）
# ==========================================================================================
## 本场改写生效过几次（三个类型分开记；没生效过 = 0）。**纯读**。
static func 改写本场次数(ctx: Variant) -> Dictionary:
	var 出 := {"满弦": 0, "连珠箭": 0, "再加一注": 0}
	var 计 = J.g(ctx, "段数改写计数")
	if 计 is Dictionary:
		for k in 出.keys():
			出[k] = int(J.num0((计 as Dictionary).get(k)))
	return 出

static func _计数加(ctx: Variant, 类型: String) -> void:
	if not (ctx is Dictionary) or 类型 == "":
		return
	if not ((ctx as Dictionary).get("段数改写计数") is Dictionary):
		(ctx as Dictionary)["段数改写计数"] = {"满弦": 0, "连珠箭": 0, "再加一注": 0}
	var 计: Dictionary = (ctx as Dictionary)["段数改写计数"]
	计[类型] = int(J.num0(计.get(类型))) + 1

static func _谁名(u: Variant) -> String:
	var 名 := str(J.g(u, "name"))
	return 名 if 名 != "" else "我方"
